{
  "ConnectionStrings": {
    "StoryPlatformDb": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContentGuardrail": {
    "BannedWords": "từ cấm 1,từ cấm 2"
  },
  "AI": {
    "Provider": "Groq",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "ApiKey": "",
    "AnalysisProvider": "",
    "AnalysisBaseUrl": "",
    "AnalysisApiKey": "",
    "WritingProvider": "",
    "WritingBaseUrl": "",
    "WritingApiKey": "",
    "PlannerModel": "llama-3.1-8b-instant",
    "WriterModel": "llama-3.1-8b-instant",
    "ConsistencyCheckerModel": "llama-3.1-8b-instant",
    "PlotManagerModel": "llama-3.1-8b-instant",
    "Model": "llama-3.1-8b-instant",
    "CoCreateMaxRevisions": 2,
    "CoCreateParallelCandidates": 2,
    "CoCreateRagMaxChars": 8000,
    "CoCreateRagTopK": 14,
    "MaxOutputTokens": 4096,
    "WriterMaxOutputTokens": 8192,
    "Temperature": 0.3,
    "WriterTemperature": 0.7,
    "RateLimitMaxRequestsPerDay": 3,
    "EmbeddingProvider": "Ollama",
    "EmbeddingBaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text"
  },
  "StoryMemory": {
    "LastChapters": 4,
    "MaxCharsPerChapter": 2000
  },
  "VectorStore": {
    "Path": "Data/faiss"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AIStory.API",
    "Audience": "AIStory.Client",
    "ExpireMinutes": 120
  }
}

