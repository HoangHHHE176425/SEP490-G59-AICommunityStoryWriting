{
  "ConnectionStrings": {
    "StoryPlatformDb": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContentGuardrail": {
    "BannedWords": "từ cấm 1,từ cấm 2"
  },
  "AI": {
    "Provider": "OpenAI",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "PlannerModel": "openai/gpt-4o-mini",
    "WriterModel": "anthropic/claude-3.5-haiku",
    "ConsistencyCheckerModel": "openai/gpt-4o-mini",
    "PlotManagerModel": "openai/gpt-4o-mini",
    "Model": "openai/gpt-4o-mini",
    "CoCreateMaxRevisions": 2,
    "CoCreateRagMaxChars": 8000,
    "CoCreateRagTopK": 14,
    "MaxOutputTokens": 4096,
    "WriterMaxOutputTokens": 8192,
    "RateLimitMaxRequestsPerDay": 3,
    "EmbeddingProvider": "OpenAI",
    "EmbeddingBaseUrl": "https://openrouter.ai/api/v1",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "StoryMemory": {
    "LastChapters": 4,
    "MaxCharsPerChapter": 2000
  },
  "VectorStore": {
    "Path": "Data/faiss"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AIStory.API",
    "Audience": "AIStory.Client",
    "ExpireMinutes": 120
  }
}

