{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434/v1",
    "PlannerModel": "qwen2.5",
