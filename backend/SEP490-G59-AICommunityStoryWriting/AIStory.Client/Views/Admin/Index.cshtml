                var actEl = document.getElementById('aiGenAction');
                if (actEl && actEl.value.trim()) q.actionType = actEl.value.trim();
                return q;
            }

            function ymdUtcFromIso(iso) {
                if (!iso) return null;
                var d = new Date(iso);
                if (isNaN(d.getTime())) return null;
                return d.toISOString().slice(0, 10);
            }

            function enumerateYmdInclusive(fromYmd, toYmd) {
                var out = [];
                var cur = fromYmd;
                var guard = 0;
                while (cur <= toYmd && guard++ < 400) {
                    out.push(cur);
                    var p = cur.split('-').map(function (x) { return parseInt(x, 10); });
                    var t = Date.UTC(p[0], p[1] - 1, p[2] + 1);
                    cur = new Date(t).toISOString().slice(0, 10);
                }
                return out;
            }

            function drawGenVolumeChart(dayRows, fromIso, toIso) {
                var el = document.getElementById('aiGenVolCanvas');
                if (!el || !el.getContext) return;
                var fromY = ymdUtcFromIso(fromIso);
                var toY = ymdUtcFromIso(toIso);
                if (!fromY || !toY || fromY > toY) {
                    var tmp = fromY;
                    fromY = toY;
                    toY = tmp;
                }
                var map = {};
                (dayRows || []).forEach(function (d) {
                    var k = d.day != null ? d.day : d.Day;
                    if (k) map[k] = d.count != null ? d.count : d.Count;
                });
                var dates = enumerateYmdInclusive(fromY, toY);
                var counts = dates.map(function (dt) { return map[dt] || 0; });
                var maxC = Math.max(1, Math.max.apply(null, counts));
                var dpr = window.devicePixelRatio || 1;
                var wCss = el.parentElement ? el.parentElement.clientWidth : 600;
                if (wCss < 200) wCss = 600;
                var hCss = 120;
                el.width = Math.floor(wCss * dpr);
                el.height = Math.floor(hCss * dpr);
                el.style.width = wCss + 'px';
                el.style.height = hCss + 'px';
                var ctx = el.getContext('2d');
                if (!ctx) return;
                ctx.setTransform(1, 0, 0, 1, 0, 0);
                ctx.scale(dpr, dpr);
                ctx.clearRect(0, 0, wCss, hCss);
                var padL = 8, padR = 8, padB = 16, padT = 6;
                var cw = wCss - padL - padR;
                var ch = hCss - padT - padB;
                var n = dates.length;
                var gap = n > 60 ? 0 : (n > 30 ? 1 : 2);
                var barW = Math.max(1, (cw - gap * Math.max(0, n - 1)) / Math.max(1, n));
                ctx.fillStyle = '#6366f1';
                for (var i = 0; i < n; i++) {
                    var h = (counts[i] / maxC) * ch;
                    var x = padL + i * (barW + gap);
                    var y = padT + ch - h;
                    ctx.fillRect(x, y, barW, h);
                }
                ctx.fillStyle = '#64748b';
                ctx.font = '9px system-ui,sans-serif';
                ctx.textAlign = 'center';
                var step = n > 20 ? Math.ceil(n / 10) : (n > 12 ? 2 : 1);
                for (var j = 0; j < n; j += step) {
                    ctx.fillText(dates[j].slice(5), padL + j * (barW + gap) + barW / 2, hCss - 3);
                }
            }

