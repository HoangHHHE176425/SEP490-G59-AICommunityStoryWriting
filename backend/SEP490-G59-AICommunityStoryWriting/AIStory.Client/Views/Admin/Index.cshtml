            async function loadAuthorAiTokenAutoGrantPanel() {
                // init handlers once
                if (!aiAutoGrantInitDone) {
                    aiAutoGrantInitDone = true;

                    var btnRefresh = document.getElementById('btnAiAutoGrantRefresh');
                    if (btnRefresh) btnRefresh.addEventListener('click', function () { loadAuthorAiTokenAutoGrantPanel(); });

                    var btnReset = document.getElementById('btnAiAutoGrantResetForm');
                    if (btnReset) btnReset.addEventListener('click', function () { aiAutoGrantSetMsg(null, null); aiAutoGrantResetForm(); });

                    var filter = document.getElementById('aiAutoGrantAuthorFilter');
                    if (filter) filter.addEventListener('input', function () {
                        aiAutoGrantAuthorFilterText = String(filter.value || '').trim();
                        renderAiAutoGrantAuthorList();
                    });

                    var allChk = document.getElementById('aiAutoGrantAllAuthors');
                    if (allChk) allChk.addEventListener('change', function () {
                        renderAiAutoGrantAuthorList();
                    });

                    var pk = document.getElementById('aiAutoGrantPeriodKind');
                    if (pk) pk.addEventListener('change', function () { updateAutoGrantLimitFieldReadonly(); });

                    var btnSelAll = document.getElementById('btnAiAutoGrantSelectAllAuthors');
                    if (btnSelAll) btnSelAll.addEventListener('click', function () {
                        var all = document.getElementById('aiAutoGrantAllAuthors');
                        if (all && all.checked) return;
                        var inputs = document.querySelectorAll('#aiAutoGrantAuthorList input[type=\"checkbox\"][data-autogrant-author=\"1\"]');
                        for (var i = 0; i < inputs.length; i++) inputs[i].checked = true;
                    });

                    var btnUnselAll = document.getElementById('btnAiAutoGrantUnselectAllAuthors');
                    if (btnUnselAll) btnUnselAll.addEventListener('click', function () {
                        var inputs = document.querySelectorAll('#aiAutoGrantAuthorList input[type=\"checkbox\"][data-autogrant-author=\"1\"]');
                        for (var i = 0; i < inputs.length; i++) inputs[i].checked = false;
                    });

                    var btnCreate = document.getElementById('btnAiAutoGrantCreate');
                    if (btnCreate) btnCreate.addEventListener('click', async function () {
                        aiAutoGrantSetMsg(null, null);
                        try {
                            var payload = aiAutoGrantReadForm();
                            if (aiAutoGrantEditingRuleId) {
                                await ApiService.adminUpdateAuthorAiTokenAutoGrantRule(aiAutoGrantEditingRuleId, payload);
                                aiAutoGrantSetMsg('ok', 'Đã cập nhật rule.');
                            } else {
                                await ApiService.adminCreateAuthorAiTokenAutoGrantRule(payload);
                                aiAutoGrantSetMsg('ok', 'Đã tạo rule.');
                            }
                            aiAutoGrantResetForm();
                            await loadAuthorAiTokenAutoGrantPanel();
                        } catch (e) {
                            aiAutoGrantSetMsg('err', e && e.message ? e.message : String(e));
                        }
                    });

                    var body = document.getElementById('aiAutoGrantBody');
                    if (body) body.addEventListener('click', async function (evt) {
                        var btn = evt.target && evt.target.closest ? evt.target.closest('button[data-act]') : null;
                        if (!btn) return;
                        var act = btn.getAttribute('data-act');
                        var tr = btn.closest('tr[data-rule-id]');
                        if (!tr) return;
                        var id = tr.getAttribute('data-rule-id');
                        if (!id) return;
                        aiAutoGrantSetMsg(null, null);
                        try {
                            if (act === 'del') {
                                if (!confirm('Xóa rule này?')) return;
                                await ApiService.adminDeleteAuthorAiTokenAutoGrantRule(id);
                                aiAutoGrantSetMsg('ok', 'Đã xóa rule.');
                                await loadAuthorAiTokenAutoGrantPanel();
                                return;
                            }
                            if (act === 'run') {
                                var r = await ApiService.adminRunAuthorAiTokenAutoGrantRuleNow(id);
                                var usersUpdated = (r && (r.usersUpdated ?? r.UsersUpdated)) || 0;
                                aiAutoGrantSetMsg('ok', 'Đã chạy rule. Users updated: ' + usersUpdated + '.');
                                await loadAuthorAiTokenAutoGrantPanel();
                                return;
                            }
                            if (act === 'edit') {
                                var list = await ApiService.adminListAuthorAiTokenAutoGrantRules();
                                var arr = Array.isArray(list) ? list : [];
                                var found = arr.find(function (x) { return (x.id || x.Id) === id; });
                                if (!found) throw new Error('Không tìm thấy rule.');
                                // Normalize
                                var rule = {
                                    id: found.id ?? found.Id,
                                    isEnabled: !!(found.isEnabled ?? found.IsEnabled),
                                    displayName: found.displayName ?? found.DisplayName ?? null,
                                    periodKind: (found.periodKind ?? found.PeriodKind ?? 'monthly_utc'),
                                    grantLimitField: (found.grantLimitField ?? found.GrantLimitField ?? 'lifetime'),
                                    grantAmount: (found.grantAmount ?? found.GrantAmount ?? 0),
                                    applyToAllAuthors: !!(found.applyToAllAuthors ?? found.ApplyToAllAuthors),
                                    selectedUserIds: found.selectedUserIds ?? found.SelectedUserIds ?? []
                                };
                                aiAutoGrantEditingRuleId = rule.id;
                                var hint = document.getElementById('aiAutoGrantEditingHint');
                                if (hint) hint.style.display = '';
                                var hid = document.getElementById('aiAutoGrantEditingId');
                                if (hid) hid.textContent = rule.id;
                                var dn = document.getElementById('aiAutoGrantDisplayName'); if (dn) dn.value = rule.displayName || '';
                                var pk = document.getElementById('aiAutoGrantPeriodKind'); if (pk) pk.value = String(rule.periodKind).toLowerCase();
                                updateAutoGrantLimitFieldReadonly();
                                var am = document.getElementById('aiAutoGrantAmount'); if (am) am.value = String(rule.grantAmount || 0);
                                var en = document.getElementById('aiAutoGrantEnabled'); if (en) en.checked = !!rule.isEnabled;
                                var all = document.getElementById('aiAutoGrantAllAuthors'); if (all) all.checked = !!rule.applyToAllAuthors;
                                // Author list checkboxes
                                setAiAutoGrantSelectedAuthors(Array.isArray(rule.selectedUserIds) ? rule.selectedUserIds : []);
                                aiAutoGrantSetMsg('ok', 'Đang sửa rule. Bấm “Tạo rule” để lưu (sẽ cập nhật).');
                                return;
                            }
                        } catch (e) {
                            aiAutoGrantSetMsg('err', e && e.message ? e.message : String(e));
                        }
                    });

                    // Default
                    aiAutoGrantResetForm();
                }

                // Ensure authors loaded for checkbox list (reuse cache from budget panel if available)
                var loadEl = document.getElementById('aiAutoGrantAuthorsLoading');
                var errEl = document.getElementById('aiAutoGrantAuthorsErr');
                if (errEl) { errEl.classList.add('d-none'); errEl.textContent = ''; }
                try {
                    if ((!aiAutoGrantAuthorsCache || aiAutoGrantAuthorsCache.length === 0) && Array.isArray(aiAuthorsBudgetCache) && aiAuthorsBudgetCache.length > 0) {
                        aiAutoGrantAuthorsCache = aiAuthorsBudgetCache.slice();
                    }
                    if (!aiAutoGrantAuthorsCache || aiAutoGrantAuthorsCache.length === 0) {
                        if (loadEl) loadEl.classList.remove('d-none');
                        // best-effort: load all authors (same loop as budget panel, but one shot with paging)
                        var allAuthors = [];
                        var page = 1;
                        var pageSize = 200;
                        var total = 0;
                        while (true) {
                            var rUsers = await ApiService.adminGetUsers({ role: 'AUTHOR', page: page, pageSize: pageSize });
                            var items = (rUsers && rUsers.items) ? rUsers.items : ((rUsers && rUsers.Items) ? rUsers.Items : []);
                            total = (rUsers && rUsers.totalCount !== undefined) ? rUsers.totalCount : ((rUsers && rUsers.TotalCount !== undefined) ? rUsers.TotalCount : 0);
                            if (items && items.length) for (var i = 0; i < items.length; i++) allAuthors.push(items[i]);
                            if (!items || items.length === 0 || allAuthors.length >= total) break;
                            page += 1;
                            if (page > 500) break;
                        }
                        aiAutoGrantAuthorsCache = allAuthors.map(function (x) {
                            var id = String(x.id != null ? x.id : x.Id || '').trim();
                            return {
                                id: id,
                                email: String(x.email != null ? x.email : x.Email || '').trim(),
                                nickname: String(x.nickname != null ? x.nickname : x.Nickname || '').trim()
                            };
                        }).filter(function (u) { return u.id.length > 0; });
                    }
                } catch (e) {
                    if (errEl) { errEl.classList.remove('d-none'); errEl.textContent = e && e.message ? e.message : String(e); }
                } finally {
                    if (loadEl) loadEl.classList.add('d-none');
                }
                renderAiAutoGrantAuthorList();

                try {
                    var list = await ApiService.adminListAuthorAiTokenAutoGrantRules();
                    var arr = Array.isArray(list) ? list : [];
                    // normalize for renderer (keep casing flexible)
                    var normalized = arr.map(function (x) {
                        var sel = x.selectedUserIds ?? x.SelectedUserIds ?? [];
                        return {
                            id: x.id ?? x.Id,
                            isEnabled: !!(x.isEnabled ?? x.IsEnabled),
                            displayName: x.displayName ?? x.DisplayName ?? null,
                            periodKind: (x.periodKind ?? x.PeriodKind ?? '').toString(),
                            grantLimitField: (x.grantLimitField ?? x.GrantLimitField ?? '').toString(),
                            grantAmount: (x.grantAmount ?? x.GrantAmount ?? 0),
                            applyToAllAuthors: !!(x.applyToAllAuthors ?? x.ApplyToAllAuthors),
                            selectedUserIds: Array.isArray(sel) ? sel : [],
                            lastRunAtUtc: x.lastRunAtUtc ?? x.LastRunAtUtc ?? null
                        };
                    });
                    renderAiAutoGrantRules(normalized);
                } catch (e) {
                    aiAutoGrantSetMsg('err', e && e.message ? e.message : String(e));
                    var body = document.getElementById('aiAutoGrantBody');
                    if (body) body.innerHTML = '<tr><td colspan="8" class="text-center text-muted">Không tải được danh sách.</td></tr>';
                }
            }

