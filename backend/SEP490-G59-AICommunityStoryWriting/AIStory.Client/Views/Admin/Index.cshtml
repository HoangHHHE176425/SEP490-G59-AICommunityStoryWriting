            async function loadModeratorPerformance(optPage) {
                if (typeof optPage === 'number' && optPage >= 1) perfPage = optPage;
                var el = document.getElementById('performanceTableBody');
                var prev = document.getElementById('btnPerfPrev');
                var next = document.getElementById('btnPerfNext');
                var info = document.getElementById('perfPageInfo');
                if (!el) return;
                el.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Đang tải...</td></tr>';
                var params = getPerformanceParams(perfPage);
                try {
                    var r = await ApiService.adminGetModeratorPerformance(params);
                    var list = r && r.items ? r.items : [];
                    var total = (r && r.totalCount !== undefined) ? r.totalCount : 0;
                    var pageNum = (r && r.page !== undefined) ? r.page : perfPage;
                    var pageSize = (r && r.pageSize !== undefined) ? r.pageSize : (params.pageSize || 20);
                    var totalPages = (r && r.totalPages !== undefined) ? r.totalPages : Math.max(1, Math.ceil(total / (pageSize || 20)));
                    perfPage = pageNum;
                    if (info) info.textContent = 'Trang ' + pageNum + ' / ' + totalPages + ' · Tổng ' + total + ' moderator';
                    var hasPrev = (r && r.hasPreviousPage !== undefined) ? r.hasPreviousPage : pageNum > 1;
                    var hasNext = (r && r.hasNextPage !== undefined) ? r.hasNextPage : pageNum < totalPages;
                    if (prev) prev.disabled = !hasPrev;
                    if (next) next.disabled = !hasNext;
                    if (!list || list.length === 0) {
                        el.innerHTML = '<tr><td colspan="7" class="text-muted">Không có dữ liệu khớp bộ lọc.</td></tr>';
                        return;
                    }
                    function pctReject(p) {
                        if (p.rejectRatio != null && p.rejectRatio !== undefined) return (p.rejectRatio * 100).toFixed(1) + '%';
                        return '–';
                    }
                    el.innerHTML = list.map(function (p) {
                        var sa = p.storyApprovedCount != null ? p.storyApprovedCount : 0;
                        var sr = p.storyRejectedCount != null ? p.storyRejectedCount : 0;
                        var ca = p.chapterApprovedCount != null ? p.chapterApprovedCount : 0;
                        var cr = p.chapterRejectedCount != null ? p.chapterRejectedCount : 0;
                        return '<tr><td>' + escapeHtml(p.moderatorName || p.moderatorId) + '</td><td>' + p.approvedCount + '</td><td>' + p.rejectedCount + '</td><td>' + (p.total != null ? p.total : (p.approvedCount + p.rejectedCount)) + '</td><td>' + pctReject(p) + '</td><td class="small">' + sa + ' / ' + sr + '</td><td class="small">' + ca + ' / ' + cr + '</td></tr>';
                    }).join('');
                } catch (e) {
                    el.innerHTML = '<tr><td colspan="7" class="text-danger">Lỗi: ' + escapeHtml(e.message || String(e)) + '</td></tr>';
                    if (prev) prev.disabled = true;
                    if (next) next.disabled = true;
                    if (info) info.textContent = '—';
                }
