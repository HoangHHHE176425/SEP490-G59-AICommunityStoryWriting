            function ensureAiGenDefaultDates() {
                var from = document.getElementById('aiGenFrom');
                var to = document.getElementById('aiGenTo');
                if (!from || !to) return;
                function pad(n) { return String(n).padStart(2, '0'); }
                function toInput(d) {
                    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
                }
                if (!to.value) to.value = toInput(new Date());
                if (!from.value) {
                    var ago = new Date(Date.now() - 7 * 86400000);
                    from.value = toInput(ago);
                }
            }

            function buildAiGenFilterQuery() {
                var q = {};
