            var btnSysLedgerPrev = document.getElementById('btnSysLedgerPrev');
            if (btnSysLedgerPrev) {
                btnSysLedgerPrev.addEventListener('click', function () {
                    if (sysLedgerPage > 1) {
                        sysLedgerPage -= 1;
