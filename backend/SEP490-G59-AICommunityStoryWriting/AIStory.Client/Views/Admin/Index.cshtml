            function getAiAutoGrantSelectedAuthors() {
                var inputs = document.querySelectorAll('#aiAutoGrantAuthorList input[type="checkbox"][data-autogrant-author="1"]:checked');
                var ids = [];
                for (var i = 0; i < inputs.length; i++) {
                    if (inputs[i].value) ids.push(inputs[i].value);
                }
                // distinct
                var seen = {};
                return ids.filter(function (x) { var k = x.toLowerCase(); if (seen[k]) return false; seen[k] = true; return true; });
            }

            function aiAutoGrantSetMsg(kind, msg) {
