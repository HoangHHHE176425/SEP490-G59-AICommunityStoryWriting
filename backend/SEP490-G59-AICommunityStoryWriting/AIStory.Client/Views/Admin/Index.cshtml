                    if (ts0) ts0.textContent = '$' + fmtUsd(0);
                    if (tr0) tr0.textContent = '0';
                    if (tt0) tt0.textContent = '0';
                    ['aiActivityCanvasSpend', 'aiActivityCanvasReq', 'aiActivityCanvasTok'].forEach(function (id) {
