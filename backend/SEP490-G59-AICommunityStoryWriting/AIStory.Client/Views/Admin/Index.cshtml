                        alert(e.message || 'Lỗi xử lý');
                    }
                });
            }
            var btnRejEsc = document.getElementById('btnRejectEscalation');
            if (btnRejEsc) {
                btnRejEsc.addEventListener('click', async function () {
                    if (!resolveEscalationRow) return;
                    var note = document.getElementById('resolveEscAdminNote').value.trim();
                    try {
                        await ApiService.adminResolveReviewEscalation(resolveEscalationRow.id, { approve: false, adminNote: note || null });
                        var m = bootstrap.Modal.getInstance(document.getElementById('resolveEscalationModal'));
                        if (m) m.hide();
                        loadReviewEscalations();
                    } catch (e) {
                        alert(e.message || 'Lỗi xử lý');
                    }
                });
            }
            document.getElementById('tab-logs').addEventListener('shown.bs.tab', function() { loadModerationLogs(1); });
            var btnLogApply = document.getElementById('btnLogApply');
            if (btnLogApply) btnLogApply.addEventListener('click', function () { logsCurrentPage = 1; loadModerationLogs(1); });
            var btnLogReload = document.getElementById('btnLogReload');
            if (btnLogReload) btnLogReload.addEventListener('click', function () { loadModerationLogs(logsCurrentPage); });
            var btnLogPrev = document.getElementById('btnLogPrev');
            if (btnLogPrev) btnLogPrev.addEventListener('click', function () { if (btnLogPrev.disabled) return; loadModerationLogs(logsCurrentPage - 1); });
            var btnLogNext = document.getElementById('btnLogNext');
            if (btnLogNext) btnLogNext.addEventListener('click', function () { if (btnLogNext.disabled) return; loadModerationLogs(logsCurrentPage + 1); });
            document.getElementById('tab-performance').addEventListener('shown.bs.tab', function () { loadModeratorPerformance(1); });
            var btnPerfApply = document.getElementById('btnPerfApply');
            if (btnPerfApply) btnPerfApply.addEventListener('click', function () { loadModeratorPerformance(1); });
            var btnPerfReload = document.getElementById('btnPerfReload');
            if (btnPerfReload) btnPerfReload.addEventListener('click', function () { loadModeratorPerformance(); });
            var btnPerfPrev = document.getElementById('btnPerfPrev');
            if (btnPerfPrev) btnPerfPrev.addEventListener('click', function () { if (btnPerfPrev.disabled) return; loadModeratorPerformance(perfPage - 1); });
            var btnPerfNext = document.getElementById('btnPerfNext');
            if (btnPerfNext) btnPerfNext.addEventListener('click', function () { if (btnPerfNext.disabled) return; loadModeratorPerformance(perfPage + 1); });
            document.getElementById('tab-platform-wallet').addEventListener('shown.bs.tab', loadPlatformWallet);

            var platformApplyBtn = document.getElementById('btnPlatformWalletApply');
            if (platformApplyBtn) platformApplyBtn.addEventListener('click', applyPlatformWalletAdjust);

            window.loadUnifiedContentReview = loadUnifiedContentReview;
            window.loadModerationLogs = loadModerationLogs;
            window.loadModeratorPerformance = loadModeratorPerformance;
            window.loadPlatformWallet = loadPlatformWallet;
            window.reloadActiveTab = reloadActiveTab;

            var btnApply = document.getElementById('btnApplyFilter');
            if (btnApply) btnApply.addEventListener('click', function() { reloadActiveTab(); });

            syncCrPanelVisibility();
            loadUnifiedContentReview(1);
            loadModeratorFilterDropdown();
            loadModeratorPerformance(1);
            loadReviewEscalations();
            applyAdminEscalationDeepLink();
        })();
    </script>
}
