@{
    ViewData["Title"] = "Admin - Theo dõi kiểm duyệt";
}

<style>
    .admin-dashboard .stat-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .admin-dashboard .nav-pills .nav-link {
        border-radius: 10px;
        font-weight: 500;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

        .admin-dashboard .nav-pills .nav-link:not(.active) {
            color: #495057;
            background: #f8f9fa;
        }

        .admin-dashboard .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            color: #fff;
        }

    .admin-dashboard .filter-panel {
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .admin-dashboard .badge-time-on {
        background: #198754;
        color: #fff;
    }

    .admin-dashboard .badge-time-warning {
        background: #ffc107;
        color: #000;
    }

    .admin-dashboard .badge-time-overdue {
        background: #dc3545;
        color: #fff;
    }

    .admin-dashboard .table-performance th {
        white-space: nowrap;
    }

    .admin-dashboard .badge-esc-critical {
        background: #b02a37;
        color: #fff;
    }

    .admin-dashboard .badge-esc-high {
        background: #fd7e14;
        color: #fff;
    }

    .admin-dashboard .badge-esc-standard {
        background: #6c757d;
        color: #fff;
    }

    .admin-dashboard .card-escalations-urgent {
        border: 2px solid #dc3545 !important;
        box-shadow: 0 0 0 0.15rem rgba(220, 53, 69, 0.15);
    }
</style>

<div class="container-fluid mt-4 admin-dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-1"><i class="bi bi-gear-wide-connected text-secondary"></i> Admin – Theo dõi hoạt động duyệt</h2>
            <p class="text-muted small mb-0">Tab <strong>Nội dung kiểm duyệt</strong> gom truyện/chương ở mọi giai đoạn (chờ / đã duyệt / từ chối) với tìm kiếm và phân trang; kèm moderation logs và hiệu suất moderator. Tab <strong>Đơn gửi admin</strong> hiển thị <strong>một danh sách</strong> đơn escalation: moderator (gia hạn / hủy nhận duyệt) và compliance (gỡ lock báo cáo truyện, yêu cầu ban / tạm khóa viết), cùng mức độ STANDARD / HIGH / CRITICAL. Hạn duyệt moderator: chọn khi nhận; chưa nhận thì gợi ý +7 ngày từ lúc gửi.</p>
        </div>
    </div>

    <div id="adminRequireRole" class="alert alert-warning" style="display: none;">
        Bạn cần đăng nhập với quyền <strong>Admin</strong> để xem trang này. <a href="/Auth/Login">Đăng nhập</a>
    </div>

    <div id="adminContent" style="display: none;">
        <!-- Moderator + ngày: dùng cho tab Nội dung kiểm duyệt (Đã duyệt/Từ chối), Performance, Moderation Logs -->
        <div class="filter-panel p-3 mb-3">
            <h6 class="mb-2"><i class="bi bi-funnel"></i> Bộ lọc Moderator &amp; ngày (đã duyệt / từ chối, logs, hiệu suất)</h6>
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-0">Moderator</label>
                    <select class="form-select form-select-sm" id="filterModerator">
                        <option value="">Tất cả</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" id="filterDateFrom">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" id="filterDateTo">
                </div>
                <div class="col-md-2" id="filterActionWrap">
                    <label class="form-label small mb-0">Hành động (Logs)</label>
                    <select class="form-select form-select-sm" id="filterAction">
                        <option value="">Tất cả</option>
                        <option value="APPROVED">Duyệt</option>
                        <option value="REJECTED">Từ chối</option>
                    </select>
                </div>
                <div class="col-md-2" id="filterTargetTypeWrap">
                    <label class="form-label small mb-0">Loại (Logs)</label>
                    <select class="form-select form-select-sm" id="filterTargetType">
                        <option value="">Tất cả</option>
                        <option value="STORY">Truyện</option>
                        <option value="CHAPTER">Chapter</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm" id="btnApplyFilter"><i class="bi bi-funnel"></i> Áp dụng bộ lọc</button>
                </div>
            </div>
        </div>

        <ul class="nav nav-pills mb-3 flex-wrap" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-content-review" data-bs-toggle="tab" data-bs-target="#panel-content-review" type="button"><i class="bi bi-collection-play me-1"></i> Nội dung kiểm duyệt</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-review-escalations" data-bs-toggle="tab" data-bs-target="#panel-review-escalations" type="button">
                    <i class="bi bi-send-exclamation-fill me-1"></i> Đơn gửi admin
                    <span class="badge bg-danger ms-1" id="navEscCriticalBadge" style="display: none;">!</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-review-escalation-log" data-bs-toggle="tab" data-bs-target="#panel-review-escalation-log" type="button">
                    <i class="bi bi-clipboard-data me-1"></i> Log đơn gửi admin
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-logs" data-bs-toggle="tab" data-bs-target="#panel-logs" type="button"><i class="bi bi-list-ul me-1"></i> Moderation Logs</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-performance" data-bs-toggle="tab" data-bs-target="#panel-performance" type="button"><i class="bi bi-bar-chart me-1"></i> Moderator Performance</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-platform-wallet" data-bs-toggle="tab" data-bs-target="#panel-platform-wallet" type="button">
                    <i class="bi bi-wallet2 me-1"></i> Ví hệ thống
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-system-coin-ledger" data-bs-toggle="tab" data-bs-target="#panel-system-coin-ledger" type="button">
                    <i class="bi bi-list-ul me-1"></i> Nhật ký tiền hệ thống
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adminTabContent">
            <div class="tab-pane fade show active" id="panel-content-review">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-collection-play me-1"></i> Truyện &amp; chương — kiểm duyệt</h5>
                        <p class="text-muted small mb-2">Một màn cho <strong>chờ duyệt</strong>, <strong>đã duyệt</strong>, <strong>từ chối</strong>. Dùng <strong>Moderator</strong> và <strong>Từ/Đến ngày</strong> ở bộ lọc phía trên khi xem đã duyệt hoặc từ chối. Chờ duyệt: cờ <span class="badge badge-time-on">Đúng hạn</span> <span class="badge badge-time-warning">Sắp hết hạn</span> <span class="badge badge-time-overdue">Quá hạn</span>.</p>
                        <div class="filter-panel p-3 mb-3">
                            <div class="row g-2 align-items-end mb-2">
                                <div class="col-6 col-md-3 col-lg-2">
                                    <label class="form-label small mb-0">Loại nội dung</label>
                                    <select class="form-select form-select-sm" id="crKind">
                                        <option value="story">Truyện</option>
                                        <option value="chapter">Chương</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-3 col-lg-2">
                                    <label class="form-label small mb-0">Giai đoạn</label>
                                    <select class="form-select form-select-sm" id="crState">
                                        <option value="pending">Chờ duyệt</option>
                                        <option value="approved">Đã duyệt</option>
                                        <option value="rejected">Từ chối</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-lg-3">
                                    <label class="form-label small mb-0">Tìm kiếm (tiêu đề)</label>
                                    <input type="text" class="form-control form-control-sm" id="crSearch" placeholder="Tùy chọn" autocomplete="off" />
                                </div>
                                <div class="col-md-4 col-lg-3" id="crStoryIdWrap" style="display: none;">
                                    <label class="form-label small mb-0">Story ID (lọc chương theo truyện)</label>
                                    <input type="text" class="form-control form-control-sm" id="crStoryId" placeholder="GUID truyện" autocomplete="off" />
                                </div>
                                <div class="col-md-3 col-lg-2" id="crClaimWrap">
                                    <label class="form-label small mb-0">Nhận duyệt (chờ duyệt)</label>
                                    <select class="form-select form-select-sm" id="crClaimFilter">
                                        <option value="">Tất cả</option>
                                        <option value="unclaimed">Chưa có moderator nhận</option>
                                        <option value="claimed">Đã có moderator nhận</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2 col-lg-1">
                                    <label class="form-label small mb-0">/trang</label>
                                    <select class="form-select form-select-sm" id="crPageSize">
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-end mb-2">
                                <div class="col-md-3 col-lg-2">
                                    <label class="form-label small mb-0">Sắp xếp (tùy chọn)</label>
                                    <select class="form-select form-select-sm" id="crSortBy">
                                        <option value="">Mặc định hệ thống</option>
                                        <option value="updatedAt">updatedAt</option>
                                        <option value="createdAt">createdAt</option>
                                        <option value="title">title</option>
                                    </select>
                                </div>
                                <div class="col-md-3 col-lg-2">
                                    <label class="form-label small mb-0">Thứ tự</label>
                                    <select class="form-select form-select-sm" id="crSortOrder">
                                        <option value="desc">Giảm dần</option>
                                        <option value="asc">Tăng dần</option>
                                    </select>
                                </div>
                                <div class="col-auto d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" id="btnCrApply"><i class="bi bi-funnel"></i> Áp dụng</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnCrReload"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                                </div>
                            </div>
                            <p id="crHintDateModerator" class="small text-info mb-0 d-none">Ô <strong>Moderator</strong> và <strong>Từ/Đến ngày</strong> (phía trên) chỉ áp dụng cho <strong>Đã duyệt</strong> / <strong>Từ chối</strong>.</p>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCrPrev" disabled>« Trước</button>
                            <span class="small text-muted" id="crPageInfo">—</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCrNext" disabled>Sau »</button>
                        </div>
                        <div id="unifiedContentReviewContainer">Chọn tab để tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-review-escalations">
                <p class="text-muted small mb-2">Một danh sách cho mọi <strong>đơn gửi admin</strong>: moderator (gia hạn / hủy nhận duyệt) và compliance (gỡ lock báo cáo truyện, cấm / tạm khóa viết). Cùng thang mức độ; mức gốc gán <strong>tự động theo loại đơn</strong>, rồi lấy max với quy tắc thời gian chờ.</p>
                <div class="card card-escalations-urgent mb-3">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-send-exclamation-fill text-danger"></i> Đơn chờ xử lý (tổng hợp)</h5>
                        <div class="btn-group btn-group-sm mb-3" role="group">
                            <button type="button" class="btn btn-outline-primary esc-view-mode active" data-esc-view="pending" id="btnEscViewPending">Chờ xử lý</button>
                            <button type="button" class="btn btn-outline-primary esc-view-mode" data-esc-view="history" id="btnEscViewHistory">Lịch sử moderator</button>
                        </div>
                        <div id="escPendingOnlyWrap">
                            <p class="text-muted small mb-2">Cờ mức độ: <span class="badge badge-esc-critical">Nghiêm trọng</span> (quá hạn / chờ lâu / hủy nhận moderator / ban user / …); <span class="badge badge-esc-high">Cao</span> (đơn gỡ lock compliance, tạm khóa viết, …); <span class="badge badge-esc-standard">Chuẩn</span>. Mức gốc gán <strong>tự động theo loại đơn</strong>, rồi lấy max với quy tắc thời gian chờ.</p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge badge-esc-critical">Nghiêm trọng: <strong id="escCountCritical">0</strong></span>
                                <span class="badge badge-esc-high">Cao: <strong id="escCountHigh">0</strong></span>
                                <span class="badge badge-esc-standard">Chuẩn: <strong id="escCountStandard">0</strong></span>
                            </div>
                            <div class="btn-group btn-group-sm flex-wrap mb-3" role="group">
                                <button type="button" class="btn btn-outline-secondary esc-filter-btn active" data-esc-tier="">Tất cả</button>
                                <button type="button" class="btn btn-outline-danger esc-filter-btn" data-esc-tier="CRITICAL">Chỉ nghiêm trọng</button>
                                <button type="button" class="btn btn-outline-warning esc-filter-btn" data-esc-tier="HIGH">Chỉ cao</button>
                                <button type="button" class="btn btn-outline-secondary esc-filter-btn" data-esc-tier="STANDARD">Chỉ chuẩn</button>
                            </div>
                        </div>
                        <p id="escHistoryHint" class="text-muted small mb-2" style="display: none;">Chỉ đơn moderator đã chấp nhận / từ chối — tra cứu nhanh. Log đầy đủ (moderator + compliance) dùng tab <strong>Log đơn gửi admin</strong>.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" id="btnReloadEscalations"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="reviewEscalationsContainer">Chọn tab để tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-review-escalation-log">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-clipboard-data me-1"></i> Log đơn gửi admin</h5>
                        <p class="text-muted small mb-2">Một bảng cho <strong>moderator escalation</strong>, <strong>đơn gỡ lock báo cáo truyện</strong> và <strong>đơn hành động tài khoản</strong> (compliance). Tìm theo nội dung / tiêu đề / GUID. Lọc <strong>thời điểm xử lý</strong> chỉ khớp bản ghi đã có <code>resolved_at</code>. Lọc <strong>Đích STORY/CHAPTER</strong> chỉ áp dụng đơn moderator.</p>
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label small mb-0">Tìm kiếm</label>
                                <input type="text" class="form-control form-control-sm" id="escLogSearch" placeholder="Nội dung, tiêu đề, hoặc GUID" autocomplete="off" />
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Nguồn</label>
                                <select class="form-select form-select-sm" id="escLogSource">
                                    <option value="">Tất cả</option>
                                    <option value="REVIEW_ESCALATION">Moderator</option>
                                    <option value="COMPLIANCE_LOCK">Compliance · gỡ lock</option>
                                    <option value="COMPLIANCE_ADMIN_ACTION">Compliance · hành động</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2 col-lg-2">
                                <label class="form-label small mb-0">Trạng thái</label>
                                <select class="form-select form-select-sm" id="escLogStatus">
                                    <option value="">Tất cả</option>
                                    <option value="PENDING">PENDING</option>
                                    <option value="APPROVED">APPROVED</option>
                                    <option value="REJECTED">REJECTED</option>
                                    <option value="RESOLVED">RESOLVED</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2 col-lg-2">
                                <label class="form-label small mb-0">Loại yêu cầu</label>
                                <select class="form-select form-select-sm" id="escLogRequestKind">
                                    <option value="">Tất cả</option>
                                    <option value="EXTEND_DEADLINE">Gia hạn (moderator)</option>
                                    <option value="RELEASE_ASSIGNMENT">Hủy nhận (moderator)</option>
                                    <option value="LOCK_RELEASE">Gỡ lock báo cáo</option>
                                    <option value="BAN_USER">Cấm tài khoản</option>
                                    <option value="SUSPEND_AUTHOR_WRITING">Tạm khóa viết</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2 col-lg-2">
                                <label class="form-label small mb-0">Đích (moderator)</label>
                                <select class="form-select form-select-sm" id="escLogTargetType">
                                    <option value="">Tất cả</option>
                                    <option value="STORY">STORY</option>
                                    <option value="CHAPTER">CHAPTER</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2 col-lg-1">
                                <label class="form-label small mb-0">/trang</label>
                                <select class="form-select form-select-sm" id="escLogPageSize">
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Người gửi (GUID)</label>
                                <input type="text" class="form-control form-control-sm" id="escLogSenderId" placeholder="senderId" autocomplete="off" />
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Người xử lý (GUID)</label>
                                <input type="text" class="form-control form-control-sm" id="escLogResolverId" placeholder="resolverId" autocomplete="off" />
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Tạo từ</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="escLogCreatedFrom" />
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Tạo đến</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="escLogCreatedTo" />
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Xử lý từ</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="escLogResolvedFrom" />
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Xử lý đến</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="escLogResolvedTo" />
                            </div>
                        </div>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Sắp xếp</label>
                                <select class="form-select form-select-sm" id="escLogSortBy">
                                    <option value="created_at">Thời gian tạo</option>
                                    <option value="resolved_at">Thời gian xử lý</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-lg-2">
                                <label class="form-label small mb-0">Thứ tự</label>
                                <select class="form-select form-select-sm" id="escLogSortOrder">
                                    <option value="desc">Mới nhất trước</option>
                                    <option value="asc">Cũ nhất trước</option>
                                </select>
                            </div>
                            <div class="col-auto d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-primary" id="btnEscLogApply"><i class="bi bi-funnel"></i> Áp dụng</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnEscLogReload"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="escLogPagerWrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnEscLogPrev" disabled>« Trước</button>
                            <span class="small text-muted" id="escLogPageInfo">—</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnEscLogNext" disabled>Sau »</button>
                        </div>
                        <div id="reviewEscalationLogContainer">Chọn tab để tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-logs">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-list-ul me-1"></i> Moderation logs</h5>
