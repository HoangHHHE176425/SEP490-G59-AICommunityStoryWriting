                    }
                });
            }

            var btnSysLedgerNext = document.getElementById('btnSysLedgerNext');
            if (btnSysLedgerNext) {
                btnSysLedgerNext.addEventListener('click', function () {
                    sysLedgerPage += 1;
                    loadSysLedger(false);
