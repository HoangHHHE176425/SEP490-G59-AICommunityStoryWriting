            var aiActivityCache = { items: null, apiKeyHash: null };

            function activityNum(v) {
                if (v === null || v === undefined || v === '') return 0;
                var x = typeof v === 'number' ? v : parseFloat(v);
                return isNaN(x) ? 0 : x;
            }

            function utcTodayYmd() {
                return new Date().toISOString().slice(0, 10);
            }

            function ymdDaysAgoFromToday(n) {
                var t = Date.UTC(
                    new Date().getUTCFullYear(),
                    new Date().getUTCMonth(),
                    new Date().getUTCDate() - n
                );
                return new Date(t).toISOString().slice(0, 10);
            }

            function aggregateActivityRows(rawItems) {
                var map = {};
                (rawItems || []).forEach(function (r) {
                    var d = r.date || r.Date;
                    if (!d) return;
                    var m = r.model || r.Model || '—';
                    var k = d + '\0' + m;
                    if (!map[k]) {
                        map[k] = {
                            date: d,
                            model: m,
                            usage: 0,
                            byok: 0,
                            requests: 0,
                            tokens: 0
                        };
                    }
                    map[k].usage += activityNum(r.usage);
                    map[k].byok += activityNum(r.byok_usage_inference != null ? r.byok_usage_inference : r.byokUsageInference);
                    map[k].requests += Math.round(activityNum(r.requests));
                    var pt = activityNum(r.prompt_tokens != null ? r.prompt_tokens : r.promptTokens);
                    var ct = activityNum(r.completion_tokens != null ? r.completion_tokens : r.completionTokens);
                    var rt = activityNum(r.reasoning_tokens != null ? r.reasoning_tokens : r.reasoningTokens);
                    map[k].tokens += pt + ct + rt;
                });
                return Object.keys(map).map(function (x) { return map[x]; });
            }

            function filterActivityByRange(rows, rangeDays) {
                var to = utcTodayYmd();
                var from = ymdDaysAgoFromToday(Math.max(0, (parseInt(rangeDays, 10) || 30) - 1));
                return rows.filter(function (r) {
                    return r.date >= from && r.date <= to;
                });
            }

            var aiActivityPalette = ['#6366f1', '#22c55e', '#f59e0b', '#ec4899', '#06b6d4', '#a855f7', '#ef4444', '#84cc16', '#14b8a6', '#eab308', '#64748b'];

            function modelColor(idx) {
                return aiActivityPalette[idx % aiActivityPalette.length];
            }

            function fmtCompactCount(n) {
                if (n >= 1000000) return (n / 1000000).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + 'M';
                if (n >= 1000) return (n / 1000).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + 'K';
                return String(Math.round(n));
            }

            function buildActivitySeries(rows, metric) {
                var datesSet = {};
                rows.forEach(function (r) { datesSet[r.date] = true; });
                var dates = Object.keys(datesSet).sort();
                if (!dates.length) return { dates: [], models: [], byDate: {}, totalsByModel: {}, grand: 0 };

                var byDate = {};
                var totalsByModel = {};
                rows.forEach(function (r) {
                    var val = metric === 'usage' ? (r.usage + r.byok) : (metric === 'requests' ? r.requests : r.tokens);
                    if (!byDate[r.date]) byDate[r.date] = {};
                    if (!byDate[r.date][r.model]) byDate[r.date][r.model] = 0;
                    byDate[r.date][r.model] += val;
                    totalsByModel[r.model] = (totalsByModel[r.model] || 0) + val;
                });
                var grand = rows.reduce(function (s, r) {
                    return s + (metric === 'usage' ? (r.usage + r.byok) : (metric === 'requests' ? r.requests : r.tokens));
                }, 0);
                var models = Object.keys(totalsByModel).sort(function (a, b) {
                    return (totalsByModel[b] || 0) - (totalsByModel[a] || 0);
                });
                return { dates: dates, models: models, byDate: byDate, totalsByModel: totalsByModel, grand: grand };
            }

            function drawActivityStackedChart(canvasId, series) {
                var el = document.getElementById(canvasId);
                if (!el || !series.dates.length) return;
                var dpr = window.devicePixelRatio || 1;
                var wCss = el.parentElement ? el.parentElement.clientWidth : 400;
                if (wCss < 120) wCss = 400;
                var hCss = 140;
                el.width = Math.floor(wCss * dpr);
                el.height = Math.floor(hCss * dpr);
                el.style.width = wCss + 'px';
                el.style.height = hCss + 'px';
                var ctx = el.getContext('2d');
                if (!ctx) return;
                ctx.setTransform(1, 0, 0, 1, 0, 0);
                ctx.scale(dpr, dpr);
                ctx.clearRect(0, 0, wCss, hCss);
                var padL = 4, padR = 4, padB = 18, padT = 4;
                var chartW = wCss - padL - padR;
                var chartH = hCss - padT - padB;
                var n = series.dates.length;
                var gap = Math.min(6, chartW / (n * 3));
                var barW = Math.max(2, (chartW - gap * (n + 1)) / n);
                var maxDay = 0;
                series.dates.forEach(function (d) {
                    var sum = 0;
                    series.models.forEach(function (m) {
                        sum += (series.byDate[d] && series.byDate[d][m]) ? series.byDate[d][m] : 0;
                    });
                    if (sum > maxDay) maxDay = sum;
                });
                if (maxDay <= 0) maxDay = 1;
                series.dates.forEach(function (d, i) {
                    var x = padL + gap + i * (barW + gap);
                    var y0 = padT + chartH;
                    series.models.forEach(function (model, mi) {
                        var v = (series.byDate[d] && series.byDate[d][model]) ? series.byDate[d][model] : 0;
                        if (v <= 0) return;
                        var h = (v / maxDay) * chartH;
                        var y1 = y0 - h;
                        ctx.fillStyle = modelColor(mi);
                        ctx.fillRect(x, y1, barW, h);
                        y0 = y1;
                    });
                });
                ctx.fillStyle = '#94a3b8';
                ctx.font = '10px system-ui,sans-serif';
                ctx.textAlign = 'center';
                var step = n > 14 ? Math.ceil(n / 7) : (n > 10 ? 2 : 1);
                for (var i = 0; i < n; i += step) {
                    var lab = series.dates[i].slice(5);
                    ctx.fillText(lab, padL + gap + i * (barW + gap) + barW / 2, hCss - 4);
                }
            }

            function renderActivityLegend(containerId, series, metric, topN) {
                var el = document.getElementById(containerId);
                if (!el) return;
                topN = topN || 6;
                var models = series.models.slice();
                var other = 0;
                var show = models.slice(0, topN);
                if (models.length > topN) {
                    models.slice(topN).forEach(function (m) {
                        other += series.totalsByModel[m] || 0;
                    });
                }
                var rows = show.map(function (m, i) {
                    var v = series.totalsByModel[m] || 0;
                    var txt = metric === 'usage' ? ('$' + fmtUsd(v)) : (metric === 'requests' ? v.toLocaleString('vi-VN') : fmtCompactCount(v));
                    return '<div class="d-flex align-items-center gap-2 mb-1"><span class="d-inline-block rounded" style="width:10px;height:10px;background:' + modelColor(series.models.indexOf(m)) + '"></span><span class="text-truncate flex-grow-1" title="' + escapeHtml(m) + '">' + escapeHtml(m) + '</span><span class="text-nowrap text-muted">' + escapeHtml(txt) + '</span></div>';
                });
                if (other > 0) {
                    var ot = metric === 'usage' ? ('$' + fmtUsd(other)) : (metric === 'requests' ? other.toLocaleString('vi-VN') : fmtCompactCount(other));
                    rows.push('<div class="d-flex align-items-center gap-2 mb-0"><span class="d-inline-block rounded bg-secondary" style="width:10px;height:10px;"></span><span class="text-truncate flex-grow-1">Khác</span><span class="text-nowrap text-muted">' + escapeHtml(ot) + '</span></div>');
                }
                el.innerHTML = rows.join('');
            }

