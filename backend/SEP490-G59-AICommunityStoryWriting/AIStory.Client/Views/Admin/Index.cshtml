            function aiReqBuildGroupedRows(groups) {
                var parts = [];
                groups.forEach(function (g) {
                    var arr = g.items;
                    var first = arr[0];
                    var tms = arr.map(aiReqItemTimeMs).filter(function (t) {
                        return t > 0;
                    });
                    var tMin = tms.length ? Math.min.apply(null, tms) : 0;
                    var tMax = tms.length ? Math.max.apply(null, tms) : 0;
                    var timeLabel = tMin && tMax
                        ? escapeHtml(formatDate(new Date(tMin).toISOString())) + ' → ' + escapeHtml(formatDate(new Date(tMax).toISOString()))
                        : '—';
                    var sumTok = 0;
                    arr.forEach(function (x) {
                        sumTok += aiReqLineTokens(x);
                    });
                    var models = [];
                    var seen = {};
                    arr.forEach(function (x) {
                        var m = x.modelName || x.ModelName || '';
                        if (m && !seen[m]) {
                            seen[m] = true;
                            models.push(m);
                        }
                    });
                    var modelLabel = models.length ? escapeHtml(models.slice(0, 2).join(', ') + (models.length > 2 ? '…' : '')) : '—';
                    parts.push(
                        '<tr class="ai-req-sum table-light" style="cursor:pointer" title="Bấm để xem / ẩn chi tiết">' +
                        '<td class="text-center text-muted small"><i class="bi bi-chevron-right ai-req-chev"></i></td>' +
                        '<td class="small">' + aiReqUserLabelHtml(first) + '</td>' +
                        '<td class="text-end small fw-medium">' + arr.length + '</td>' +
                        '<td class="small text-nowrap">' + timeLabel + '</td>' +
                        '<td class="text-end small">' + escapeHtml(sumTok.toLocaleString('vi-VN')) + '</td>' +
                        '<td class="small text-break">' + modelLabel + '</td>' +
                        '<td class="small text-muted">Bấm để mở</td>' +
                        '</tr>'
                    );
                    var innerBody = arr.map(aiReqInnerRowHtml).join('');
                    parts.push(
                        '<tr class="ai-req-detail d-none">' +
                        '<td colspan="7" class="p-0 border-top-0">' +
                        '<div class="p-2 bg-light bg-opacity-50">' +
                        '<table class="table table-sm table-bordered mb-0 bg-white">' +
                        '<thead class="table-light"><tr>' +
                        '<th>Thời gian</th><th>action</th><th>model</th><th class="text-end">tokens (p/c/t)</th><th>generation</th><th>status</th>' +
                        '</tr></thead><tbody>' + innerBody + '</tbody></table></div></td></tr>'
                    );
                });
                return parts.join('');
            }

