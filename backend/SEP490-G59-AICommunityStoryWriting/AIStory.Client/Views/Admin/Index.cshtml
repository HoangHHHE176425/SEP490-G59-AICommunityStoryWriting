            let platformWalletHistoryPage = 1;
            const platformWalletHistoryPageSize = 10;

            function escapeHtml(text) {
                if (text == null) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function getPlatformWalletHistoryFilters() {
                var dateFromEl = document.getElementById('platformWalletFilterDateFrom');
                var dateToEl = document.getElementById('platformWalletFilterDateTo');
                var typeEl = document.getElementById('platformWalletFilterType');
                var qEl = document.getElementById('platformWalletFilterQ');

                var f = {};
                var df = dateFromEl && dateFromEl.value ? dateFromEl.value.trim() : '';
                var dt = dateToEl && dateToEl.value ? dateToEl.value.trim() : '';
                var tp = typeEl && typeEl.value ? typeEl.value.trim() : 'ALL';
                var q = qEl && qEl.value ? qEl.value.trim() : '';

                if (df) f.dateFrom = df;
                if (dt) f.dateTo = dt;
                if (tp && tp !== 'ALL') f.type = tp;
                if (q) f.q = q;
                return f;
            }

            function renderPlatformWalletFilterSummary() {
                var meta = document.getElementById('platformWalletFilterSummary');
                if (!meta) return;

                var f = getPlatformWalletHistoryFilters();
                var parts = [];
                if (f.dateFrom) parts.push('Từ ' + f.dateFrom);
                if (f.dateTo) parts.push('Đến ' + f.dateTo);
                if (f.type) parts.push('Loại ' + f.type);
                if (f.q) parts.push('Note: ' + f.q);
                meta.textContent = parts.length ? parts.join(' · ') : 'Không có bộ lọc';
            }

            async function loadPlatformWalletSummary() {
                var balanceEl = document.getElementById('platformWalletBalanceCoin');
                var updatedAtEl = document.getElementById('platformWalletUpdatedAt');
                var totalCoinsEl = document.getElementById('platformWalletTotalCoinsInSystem');
                var platformFeeCoinsEl = document.getElementById('platformWalletPlatformFeeCoins');

                var bal = await ApiService.adminGetPlatformWalletBalance();
                var summary = await ApiService.adminGetPlatformWalletSummary();

                if (balanceEl) balanceEl.textContent = String(bal?.balanceCoin ?? bal?.balance_coin ?? bal?.balanceCoin ?? 0);
                if (updatedAtEl) {
                    var ts = bal?.updatedAt ?? bal?.updated_at;
                    updatedAtEl.textContent = ts ? ('Cập nhật: ' + formatDate(ts)) : '';
                }
                if (totalCoinsEl) totalCoinsEl.textContent = String(summary?.totalCoinsInSystem ?? summary?.totalCoinsInSystem ?? 0);
                if (platformFeeCoinsEl) platformFeeCoinsEl.textContent = String(summary?.platformFeeCoins ?? summary?.platformFeeCoins ?? 0);
            }

            async function loadPlatformWalletAdjustments(page) {
                var err = document.getElementById('platformWalletError');
                if (err) {
                    err.classList.add('d-none');
                    err.textContent = '';
                }

                var bodyEl = document.getElementById('platformWalletAdjustmentsBody');
                var metaEl = document.getElementById('platformWalletAdjustMeta');
                var pageMetaEl = document.getElementById('platformWalletHistoryPageMeta');

                if (bodyEl) bodyEl.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Đang tải...</td></tr>';

                var f = getPlatformWalletHistoryFilters();

                try {
                    var adj = await ApiService.adminGetUserWalletAdjustments(page, platformWalletHistoryPageSize, f);
                    var items = adj?.items || adj?.Items || [];
                    var totalCount = adj?.totalCount ?? adj?.TotalCount ?? 0;

                    if (metaEl) metaEl.textContent = 'Tổng: ' + totalCount;

                    var totalPages = Math.max(1, Math.ceil(totalCount / platformWalletHistoryPageSize));
                    if (pageMetaEl) pageMetaEl.textContent = 'Trang ' + page + ' / ' + totalPages;

                    var btnPrev = document.getElementById('btnPlatformWalletHistoryPrev');
                    var btnNext = document.getElementById('btnPlatformWalletHistoryNext');
                    if (btnPrev) btnPrev.disabled = page <= 1;
                    if (btnNext) btnNext.disabled = page >= totalPages;

                    if (!bodyEl) return;
                    if (!items || items.length === 0) {
                        bodyEl.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Chưa có lịch sử điều chỉnh</td></tr>';
                        return;
                    }

                    bodyEl.innerHTML = items.map(function (x) {
                        var adjustedAt = x.adjustedAt ?? x.AdjustedAt ?? x.createdAt ?? x.CreatedAt;
                        var deltaCoins = Number(x.deltaCoins ?? x.DeltaCoins ?? 0);
                        var userId = x.userId ?? x.UserId ?? '–';
                        var note = x.note ?? x.Note ?? '';
                        var absCoins = Math.abs(deltaCoins);
                        var type = deltaCoins >= 0 ? 'ADD' : 'SUB';
                        return '<tr>' +
                            '<td>' + (adjustedAt ? formatDate(adjustedAt) : '–') + '</td>' +
                            '<td>' + type + '</td>' +
                            '<td>' + absCoins + '</td>' +
                            '<td>' + escapeHtml(note) + '</td>' +
                            '<td>' + escapeHtml(userId || '–') + '</td>' +
                            '</tr>';
                    }).join('');
                } catch (e) {
                    if (err) {
                        err.classList.remove('d-none');
                        err.textContent = (e && e.message) ? e.message : 'Không tải được ví hệ thống.';
                    }
                    if (bodyEl) bodyEl.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Lỗi tải dữ liệu</td></tr>';
                }
            }

            async function loadPlatformWallet() {
                renderPlatformWalletFilterSummary();
                await loadPlatformWalletSummary();
                await loadPlatformWalletAdjustments(platformWalletHistoryPage);
            }

            async function applyPlatformWalletAdjust() {
                var err = document.getElementById('platformWalletError');
                if (err) {
                    err.classList.add('d-none');
                    err.textContent = '';
                }

                var amountEl = document.getElementById('platformWalletAdjustAmount');
                var dirEl = document.getElementById('platformWalletAdjustDirection');
                var targetEl = document.getElementById('platformWalletAdjustTarget');
                var noteEl = document.getElementById('platformWalletAdjustNote');
                var applyBtn = document.getElementById('btnPlatformWalletApply');

                var amount = amountEl ? Number(amountEl.value) : 0;
                var dir = dirEl ? dirEl.value : 'SUB';
                var target = targetEl ? targetEl.value.trim() : '';
                var note = noteEl ? noteEl.value.trim() : '';

                if (!amount || amount <= 0) {
                    if (err) {
                        err.classList.remove('d-none');
                        err.textContent = 'Số coin điều chỉnh phải lớn hơn 0.';
                    }
                    return;
                }

                if (!target) {
                    if (err) {
                        err.classList.remove('d-none');
                        err.textContent = 'Chọn user (userId/email/nickname) để điều chỉnh.';
                    }
                    return;
                }

                var delta = dir === 'ADD' ? amount : -amount;

                try {
                    if (applyBtn) applyBtn.disabled = true;
                    await ApiService.adminAdjustUserWallet(target, delta, note);
                    if (amountEl) amountEl.value = '';
                    if (targetEl) targetEl.value = '';
                    if (noteEl) noteEl.value = '';
                    await loadPlatformWallet();
                } catch (e) {
                    if (err) {
                        err.classList.remove('d-none');
                        err.textContent = (e && e.message) ? e.message : 'Không thể điều chỉnh ví hệ thống.';
                    }
                } finally {
                    if (applyBtn) applyBtn.disabled = false;
                }
            }

            // -----------------------
            // System coin ledger (unlock / platform adj / withdraw)
            // -----------------------
            let sysLedgerPage = 1;
            const sysLedgerPageSize = 20;
            let sysLedgerIsLoading = false;

            function getSysLedgerFilters() {
                const dateFrom = document.getElementById('sysLedgerDateFrom')?.value;
                const dateTo = document.getElementById('sysLedgerDateTo')?.value;
                const type = document.getElementById('sysLedgerType')?.value;
                const filters = {};
                if (dateFrom) filters.dateFrom = dateFrom;
                if (dateTo) filters.dateTo = dateTo;
                if (type && type !== 'ALL') filters.type = type;
                return filters;
            }

            async function loadSysLedger(reset) {
                const loading = document.getElementById('sysLedgerLoading');
                const content = document.getElementById('sysLedgerContent');
                const list = document.getElementById('sysLedgerList');
                const errorEl = document.getElementById('sysLedgerError');
                const metaEl = document.getElementById('sysLedgerMeta');
                const prevBtn = document.getElementById('btnSysLedgerPrev');
                const nextBtn = document.getElementById('btnSysLedgerNext');

                if (sysLedgerIsLoading) return;
                sysLedgerIsLoading = true;

                if (errorEl) {
                    errorEl.classList.add('d-none');
                    errorEl.textContent = '';
                }

                if (reset) {
                    sysLedgerPage = 1;
                    if (list) list.innerHTML = '';
                }

                if (loading) loading.style.display = 'block';
                if (content) content.style.display = 'none';

                try {
                    const resp = await ApiService.adminGetSystemCoinLedger(sysLedgerPage, sysLedgerPageSize, getSysLedgerFilters());
                    const items = resp?.items ?? resp?.Items ?? [];
                    const totalCount = resp?.totalCount ?? resp?.TotalCount ?? 0;

                    if (metaEl) {
                        const totalPages = Math.max(1, Math.ceil(totalCount / sysLedgerPageSize));
                        metaEl.textContent = `Trang ${sysLedgerPage} / ${totalPages}`;
                    }

                    if (prevBtn) prevBtn.disabled = sysLedgerPage <= 1;
                    if (nextBtn) nextBtn.disabled = sysLedgerPage >= Math.ceil(totalCount / sysLedgerPageSize);

                    if (!list) return;
                    if (!items || items.length === 0) {
                        list.innerHTML = '<tr><td colspan="11" class="text-center text-muted">Chưa có dữ liệu</td></tr>';
                    } else {
                        list.innerHTML = items.map(function (x) {
                            const eventType = x.eventType ?? x.EventType ?? '';
                            const eventTime = x.eventTime ?? x.EventTime ?? x.adjustedAt ?? x.AdjustedAt;
                            const platform = Number(x.platformDeltaCoins ?? x.PlatformDeltaCoins ?? 0);
                            const buyer = Number(x.buyerDeltaCoins ?? x.BuyerDeltaCoins ?? 0);
                            const buyerId = x.buyerUserId ?? x.BuyerUserId ?? '–';
                            const authorIncome = Number(x.authorIncomeDeltaCoins ?? x.AuthorIncomeDeltaCoins ?? 0);
                            const authorFrozen = Number(x.authorFrozenDeltaCoins ?? x.AuthorFrozenDeltaCoins ?? 0);
                            const authorId = x.authorUserId ?? x.AuthorUserId ?? '–';
                            const storyTitle = x.storyTitle ?? x.StoryTitle ?? '';
                            const chapterTitle = x.chapterTitle ?? x.ChapterTitle ?? '';
                            const note = x.note ?? x.Note ?? '';
                            const adminId = x.adminId ?? x.AdminId ?? '–';

                            const storyText = storyTitle
                                ? storyTitle + (chapterTitle ? (' / ' + chapterTitle) : '')
                                : (chapterTitle ? chapterTitle : '-');

                            return `
                                <tr>
                                    <td>${eventTime ? escapeHtml(formatDate(eventTime)) : '–'}</td>
                                    <td>${escapeHtml(eventType)}</td>
                                    <td>${platform}</td>
                                    <td>${buyer}</td>
                                            <td>${escapeHtml(buyerId || '–')}</td>
                                    <td>${authorIncome}</td>
                                    <td>${authorFrozen}</td>
                                            <td>${escapeHtml(authorId || '–')}</td>
                                    <td>${escapeHtml(storyText)}</td>
                                    <td>${escapeHtml(note)}</td>
                                            <td>${escapeHtml(adminId || '–')}</td>
                                </tr>
                            `;
                        }).join('');
                    }

                    if (loading) loading.style.display = 'none';
                    if (content) content.style.display = 'block';
                } catch (e) {
                    if (errorEl) {
                        errorEl.classList.remove('d-none');
                        errorEl.textContent = (e && e.message) ? e.message : 'Không tải được nhật ký hệ thống.';
                    }
                } finally {
                    sysLedgerIsLoading = false;
                }
            }

            var btnPlatformWalletFilterApply = document.getElementById('btnPlatformWalletFilterApply');
            if (btnPlatformWalletFilterApply) {
                btnPlatformWalletFilterApply.addEventListener('click', function () {
                    platformWalletHistoryPage = 1;
                    loadPlatformWallet();
