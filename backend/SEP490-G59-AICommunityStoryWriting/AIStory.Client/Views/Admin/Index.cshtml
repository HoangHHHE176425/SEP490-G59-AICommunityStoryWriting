@section Scripts {
    <script>
        (function() {
            if (typeof AuthHelper === 'undefined' || !AuthHelper.isAdmin()) {
                document.getElementById('adminRequireRole').style.display = 'block';
                return;
            }
            document.getElementById('adminContent').style.display = 'block';

            function getFilterParams() {
                var mod = document.getElementById('filterModerator');
                var fromEl = document.getElementById('filterDateFrom');
                var toEl = document.getElementById('filterDateTo');
                var from = fromEl && fromEl.value ? fromEl.value.trim() : '';
                var to = toEl && toEl.value ? toEl.value.trim() : '';
                var o = { page: 1, pageSize: 20 };
                if (mod && mod.value) o.moderatorId = mod.value;
                if (from) o.dateFrom = from;
                if (to) o.dateTo = to;
                return o;
            }

            function getLogsFilterParams(page) {
                var p = getFilterParams();
                p.page = page || 1;
                var psEl = document.getElementById('logPageSize');
                p.pageSize = psEl ? (parseInt(psEl.value, 10) || 20) : 20;
                var actionEl = document.getElementById('filterAction');
