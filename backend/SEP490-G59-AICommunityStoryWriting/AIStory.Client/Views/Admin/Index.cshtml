@{
    ViewData["Title"] = "Admin - Theo dõi kiểm duyệt";
}

<style>
    .admin-dashboard .stat-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .admin-dashboard .nav-pills .nav-link {
        border-radius: 10px;
        font-weight: 500;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

        .admin-dashboard .nav-pills .nav-link:not(.active) {
            color: #495057;
            background: #f8f9fa;
        }

        .admin-dashboard .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            color: #fff;
        }

    .admin-dashboard .filter-panel {
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .admin-dashboard .badge-time-on {
        background: #198754;
        color: #fff;
    }

    .admin-dashboard .badge-time-warning {
        background: #ffc107;
        color: #000;
    }

    .admin-dashboard .badge-time-overdue {
        background: #dc3545;
        color: #fff;
    }

    .admin-dashboard .table-performance th {
        white-space: nowrap;
    }
</style>

<div class="container-fluid mt-4 admin-dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-1"><i class="bi bi-gear-wide-connected text-secondary"></i> Admin – Theo dõi hoạt động duyệt</h2>
            <p class="text-muted small mb-0">Xem danh sách nội dung chờ duyệt / đã duyệt / từ chối, moderation logs và hiệu suất moderator. Thời hạn duyệt mặc định: 7 ngày (có thể gia hạn với truyện/chapter dài).</p>
        </div>
    </div>

    <div id="adminRequireRole" class="alert alert-warning" style="display: none;">
        Bạn cần đăng nhập với quyền <strong>Admin</strong> để xem trang này. <a href="/Auth/Login">Đăng nhập</a>
    </div>

    <div id="adminContent" style="display: none;">
        <!-- Bộ lọc chung (áp dụng cho Approved/Rejected/Logs) -->
        <div class="filter-panel p-3 mb-3">
            <h6 class="mb-2"><i class="bi bi-funnel"></i> Bộ lọc (Moderator, ngày, hành động)</h6>
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-0">Moderator</label>
                    <select class="form-select form-select-sm" id="filterModerator">
                        <option value="">Tất cả</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" id="filterDateFrom">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" id="filterDateTo">
                </div>
                <div class="col-md-2" id="filterActionWrap">
                    <label class="form-label small mb-0">Hành động (Logs)</label>
                    <select class="form-select form-select-sm" id="filterAction">
                        <option value="">Tất cả</option>
                        <option value="APPROVED">Duyệt</option>
                        <option value="REJECTED">Từ chối</option>
                    </select>
                </div>
                <div class="col-md-2" id="filterTargetTypeWrap">
                    <label class="form-label small mb-0">Loại (Logs)</label>
                    <select class="form-select form-select-sm" id="filterTargetType">
                        <option value="">Tất cả</option>
                        <option value="STORY">Truyện</option>
                        <option value="CHAPTER">Chapter</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm" id="btnApplyFilter"><i class="bi bi-funnel"></i> Áp dụng bộ lọc</button>
                </div>
            </div>
        </div>

        <ul class="nav nav-pills mb-3 flex-wrap" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-pending-stories" data-bs-toggle="tab" data-bs-target="#panel-pending-stories" type="button"><i class="bi bi-book me-1"></i> Pending Stories</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-pending-chapters" data-bs-toggle="tab" data-bs-target="#panel-pending-chapters" type="button"><i class="bi bi-journal-text me-1"></i> Pending Chapters</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-approved-stories" data-bs-toggle="tab" data-bs-target="#panel-approved-stories" type="button"><i class="bi bi-check-circle me-1"></i> Approved Stories</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-rejected-stories" data-bs-toggle="tab" data-bs-target="#panel-rejected-stories" type="button"><i class="bi bi-x-circle me-1"></i> Rejected Stories</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-approved-chapters" data-bs-toggle="tab" data-bs-target="#panel-approved-chapters" type="button"><i class="bi bi-check-circle me-1"></i> Approved Chapters</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-rejected-chapters" data-bs-toggle="tab" data-bs-target="#panel-rejected-chapters" type="button"><i class="bi bi-x-circle me-1"></i> Rejected Chapters</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-logs" data-bs-toggle="tab" data-bs-target="#panel-logs" type="button"><i class="bi bi-list-ul me-1"></i> Moderation Logs</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-performance" data-bs-toggle="tab" data-bs-target="#panel-performance" type="button"><i class="bi bi-bar-chart me-1"></i> Moderator Performance</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-platform-wallet" data-bs-toggle="tab" data-bs-target="#panel-platform-wallet" type="button">
                    <i class="bi bi-wallet2 me-1"></i> Ví hệ thống
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-system-coin-ledger" data-bs-toggle="tab" data-bs-target="#panel-system-coin-ledger" type="button">
                    <i class="bi bi-list-ul me-1"></i> Nhật ký tiền hệ thống
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adminTabContent">
            <div class="tab-pane fade show active" id="panel-pending-stories">
                <div class="card">
                    <div class="card-body">
                        <p class="text-muted small">Truyện chờ duyệt. Cờ: <span class="badge badge-time-on">Đúng hạn</span> <span class="badge badge-time-warning">Sắp hết hạn (≤2 ngày)</span> <span class="badge badge-time-overdue">Quá hạn</span> (thời hạn 7 ngày)</p>
                        <div id="pendingStoriesContainer">Đang tải...</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-pending-chapters">
                <div class="card">
                    <div class="card-body">
                        <p class="text-muted small">Chapter chờ duyệt. Cờ thời hạn tương tự.</p>
                        <div id="pendingChaptersContainer">Đang tải...</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-approved-stories">
                <div class="card">
                    <div class="card-body">
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadApprovedStories()"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="approvedStoriesContainer">Chọn bộ lọc (Moderator, ngày) rồi tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-rejected-stories">
                <div class="card">
                    <div class="card-body">
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadRejectedStories()"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="rejectedStoriesContainer">Chọn bộ lọc rồi tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-approved-chapters">
                <div class="card">
                    <div class="card-body">
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadApprovedChapters()"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="approvedChaptersContainer">Chọn bộ lọc rồi tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-rejected-chapters">
                <div class="card">
                    <div class="card-body">
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadRejectedChapters()"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="rejectedChaptersContainer">Chọn bộ lọc rồi tải.</div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-logs">
                <div class="card">
                    <div class="card-body">
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadModerationLogs(1)"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div id="moderationLogsContainer">Chọn bộ lọc (Moderator, ngày, Action, Loại) rồi tải.</div>
                        <nav id="logsPagination" class="mt-2"></nav>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-performance">
                <div class="card">
                    <div class="card-body">
                        <p class="text-muted small">Thống kê theo moderator (Approved / Rejected / Total) — giúp phát hiện moderator làm sai nhiều.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" onclick="loadModeratorPerformance()"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-performance">
                                <thead><tr><th>Moderator</th><th>Approved</th><th>Rejected</th><th>Total</th></tr></thead>
                                <tbody id="performanceTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="panel-platform-wallet">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h5 class="mb-0"><i class="bi bi-wallet2"></i> Ví hệ thống (platform_wallet)</h5>
                            <div class="text-muted small">Coin dùng để chia nền tảng (30%) khi unlock chapter.</div>
                        </div>

                        <div id="platformWalletError" class="alert alert-warning d-none" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="card border-primary h-100">
                                    <div class="card-body">
                                        <div class="text-muted small mb-1">Số dư ví hệ thống (coin)</div>
                                        <div class="fs-4 fw-bold" id="platformWalletBalanceCoin">0</div>
                                        <div class="text-muted small mt-1" id="platformWalletUpdatedAt"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success h-100">
                                    <div class="card-body">
                                        <div class="text-muted small mb-1">Tổng coin trong hệ thống</div>
                                        <div class="fs-4 fw-bold" id="platformWalletTotalCoinsInSystem">0</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-warning h-100">
                                    <div class="card-body">
                                        <div class="text-muted small mb-1">Platform fee revenue (ước tính)</div>
                                        <div class="fs-4 fw-bold" id="platformWalletPlatformFeeCoins">0</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="filter-panel p-3 mb-4">
                            <h6 class="mb-3"><i class="bi bi-gear"></i> Điều chỉnh số dư (ADMIN)</h6>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Số coin</label>
                                    <input type="number" class="form-control form-control-sm" id="platformWalletAdjustAmount" min="1" step="1" placeholder="Ví dụ: 1000">
                                    <div class="mt-2">
                                        <label class="form-label small mb-0">Ví người dùng (userId/email/nickname)</label>
                                        <input type="text" class="form-control form-control-sm" id="platformWalletAdjustTarget" placeholder="vd: userId hoặc email">
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label small mb-0">Lý do điều chỉnh (note)</label>
                                        <input type="text" class="form-control form-control-sm" id="platformWalletAdjustNote" placeholder="vd: Bù trừ admin">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Hành động</label>
                                    <select class="form-select form-select-sm" id="platformWalletAdjustDirection">
                                        <option value="ADD">ADD (cộng)</option>
                                        <option value="SUB" selected>SUB (trừ)</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-grid">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnPlatformWalletApply">
                                        <i class="bi bi-check2-circle"></i> Áp dụng
                                    </button>
                                </div>
                            </div>
                            <div class="text-muted small mt-2">
                                Lưu ý: Không cho phép trừ khiến số dư âm.
                            </div>
                        </div>

                        <div class="filter-panel p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <h6 class="mb-0"><i class="bi bi-funnel"></i> Lọc lịch sử</h6>
                                <div class="text-muted small" id="platformWalletFilterSummary">–</div>
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Từ ngày</label>
                                    <input type="date" class="form-control form-control-sm" id="platformWalletFilterDateFrom">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Đến ngày</label>
                                    <input type="date" class="form-control form-control-sm" id="platformWalletFilterDateTo">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Loại</label>
                                    <select class="form-select form-select-sm" id="platformWalletFilterType">
                                        <option value="ALL" selected>Tất cả</option>
                                        <option value="ADD">ADD</option>
                                        <option value="SUB">SUB</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Tìm note</label>
                                    <input type="text" class="form-control form-control-sm" id="platformWalletFilterQ" placeholder="Nhập từ khóa...">
                                </div>
                                <div class="col-md-3 d-grid">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnPlatformWalletFilterApply">
                                        <i class="bi bi-check2-circle"></i> Áp dụng
                                    </button>
                                </div>
                                <div class="col-md-3 d-grid">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPlatformWalletFilterClear">
                                        <i class="bi bi-x-circle"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <h6 class="mb-0"><i class="bi bi-clock-history"></i> Gần đây</h6>
                                    <div class="text-muted small" id="platformWalletAdjustMeta"></div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Thời gian</th>
                                                <th>Loại</th>
                                                <th>Coins</th>
                                                <th>Lý do</th>
                                                <th>UserId</th>
                                            </tr>
                                        </thead>
                                        <tbody id="platformWalletAdjustmentsBody">
                                            <tr><td colspan="5" class="text-center text-muted">Đang tải...</td></tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPlatformWalletHistoryPrev">
                                        <i class="bi bi-arrow-left"></i> Trước
                                    </button>
                                    <div class="text-muted small" id="platformWalletHistoryPageMeta">Trang 1 / 1</div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPlatformWalletHistoryNext">
                                        Sau <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="panel-system-coin-ledger">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h5 class="mb-0"><i class="bi bi-list-ul"></i> Nhật ký tiền hệ thống</h5>
                            <div class="text-muted small">Unlock / platform adj / withdraw</div>
                        </div>

                        <div class="filter-panel p-3 mb-3">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Từ ngày</label>
                                    <input type="date" class="form-control form-control-sm" id="sysLedgerDateFrom">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Đến ngày</label>
                                    <input type="date" class="form-control form-control-sm" id="sysLedgerDateTo">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Loại</label>
                                    <select class="form-select form-select-sm" id="sysLedgerType">
                                        <option value="ALL" selected>Tất cả</option>
                                        <option value="UNLOCK">UNLOCK</option>
                                        <option value="PLATFORM_ADJ">PLATFORM_ADJ</option>
                                        <option value="WITHDRAW_REQUESTED">WITHDRAW_REQUESTED</option>
                                        <option value="WITHDRAW_APPROVED">WITHDRAW_APPROVED</option>
                                        <option value="WITHDRAW_REJECTED">WITHDRAW_REJECTED</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-grid">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnSysLedgerApply">
                                        <i class="bi bi-check2-circle"></i> Áp dụng
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="sysLedgerLoading" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="mt-2 text-muted small">Đang tải...</div>
                        </div>

                        <div id="sysLedgerError" class="alert alert-warning d-none" role="alert"></div>

                        <div id="sysLedgerContent" style="display:none;">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead>
                                        <tr>
                                            <th>Thời gian</th>
                                            <th>Loại</th>
                                            <th>Platform</th>
                                            <th>Buyer</th>
                                            <th>BuyerId</th>
                                            <th>Author income</th>
                                            <th>Author frozen</th>
                                            <th>AuthorId</th>
                                            <th>Story/Chapter</th>
                                            <th>Note</th>
                                            <th>AdminId</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sysLedgerList"></tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSysLedgerPrev">
                                    <i class="bi bi-arrow-left"></i> Trước
                                </button>
                                <div class="text-muted small" id="sysLedgerMeta">Trang 1 / 1</div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSysLedgerNext">
                                    Sau <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            if (typeof AuthHelper === 'undefined' || !AuthHelper.isAdmin()) {
                document.getElementById('adminRequireRole').style.display = 'block';
                return;
            }
            document.getElementById('adminContent').style.display = 'block';

            function getFilterParams() {
                var mod = document.getElementById('filterModerator');
                var fromEl = document.getElementById('filterDateFrom');
                var toEl = document.getElementById('filterDateTo');
                var from = fromEl && fromEl.value ? fromEl.value.trim() : '';
                var to = toEl && toEl.value ? toEl.value.trim() : '';
                var o = { page: 1, pageSize: 20 };
                if (mod && mod.value) o.moderatorId = mod.value;
                if (from) o.dateFrom = from;
                if (to) o.dateTo = to;
                return o;
            }

            function getLogsFilterParams(page) {
                var p = getFilterParams();
                p.page = page || 1;
                p.pageSize = 20;
                var actionEl = document.getElementById('filterAction');
                var typeEl = document.getElementById('filterTargetType');
                if (actionEl && actionEl.value) p.action = actionEl.value;
                if (typeEl && typeEl.value) p.targetType = typeEl.value;
                return p;
            }

            function reloadActiveTab() {
                var activePane = document.querySelector('#adminTabContent .tab-pane.active');
                if (!activePane) return;
                var id = activePane.id;
                if (id === 'panel-pending-stories') loadPendingStories();
                else if (id === 'panel-pending-chapters') loadPendingChapters();
                else if (id === 'panel-approved-stories') loadApprovedStories();
                else if (id === 'panel-rejected-stories') loadRejectedStories();
                else if (id === 'panel-approved-chapters') loadApprovedChapters();
                else if (id === 'panel-rejected-chapters') loadRejectedChapters();
                else if (id === 'panel-logs') loadModerationLogs(1);
                else if (id === 'panel-performance') loadModeratorPerformance();
                else if (id === 'panel-platform-wallet') loadPlatformWallet();
            }

            function timeStatusBadge(ts) {
                if (!ts) return '';
                var c = 'badge-time-on';
                if (ts === 'Warning') c = 'badge-time-warning';
                else if (ts === 'Overdue') c = 'badge-time-overdue';
                var t = ts === 'OnTime' ? 'Đúng hạn' : (ts === 'Warning' ? 'Sắp hết hạn' : 'Quá hạn');
                return '<span class="badge ' + c + '">' + t + '</span>';
            }

            function formatDate(d) {
                if (!d) return '–';
                var x = new Date(d);
                return isNaN(x.getTime()) ? d : x.toLocaleString('vi-VN');
            }

