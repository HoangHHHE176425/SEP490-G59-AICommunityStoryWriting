                var e = document.getElementById('aiCreditsErr');
                if (w) w.classList.add('d-none');
                if (e) { e.classList.add('d-none'); e.textContent = ''; }
            }

            function renderAiOpenRouterCredits(cr) {
                var wrap = document.getElementById('aiCreditsWrap');
                var errEl = document.getElementById('aiCreditsErr');
                if (errEl) {
                    errEl.classList.add('d-none');
                    errEl.textContent = '';
                }
                if (!wrap) return;
                if (!cr || cr.available === false) {
                    wrap.classList.add('d-none');
                    return;
                }
                if (cr.message && !cr.data) {
                    wrap.classList.remove('d-none');
                    if (errEl) {
                        errEl.classList.remove('d-none');
                        errEl.textContent = cr.message;
                    }
                    return;
                }
                var c = cr.data || {};
                function pick(a, b) {
                    return c[a] != null ? c[a] : c[b];
                }
                function moneyUsd(id, v) {
                    var el = document.getElementById(id);
                    if (!el) return;
                    if (v === null || v === undefined || v === '') {
                        el.textContent = '—';
                        return;
                    }
                    var n = typeof v === 'number' ? v : parseFloat(v);
                    el.textContent = isNaN(n) ? '—' : ('$' + fmtUsd(n));
                }
                var dep = pick('totalCreditsPurchased', 'TotalCreditsPurchased');
                var used = pick('totalCreditsUsed', 'TotalCreditsUsed');
                var rem = pick('remainingCredits', 'RemainingCredits');
                moneyUsd('aiCreditDeposited', dep);
                moneyUsd('aiCreditUsed', used);
                moneyUsd('aiCreditRemaining', rem);
                wrap.classList.remove('d-none');
            }

