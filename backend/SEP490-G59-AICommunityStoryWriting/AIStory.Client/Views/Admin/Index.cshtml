            function pickNum(r, camel, pascal) {
                var v = r[camel];
                if (v === undefined || v === null || v === '') v = r[pascal];
                if (v === undefined || v === null || v === '') return null;
                var n = Number(v);
                return Number.isFinite(n) ? n : null;
            }

            function parseAuthorBudgetDto(r) {
                if (!r) return null;
                var ul = !!(r.unlimited || r.Unlimited);
                var tu = pickNum(r, 'tokensUsed', 'TokensUsed') ?? 0;
                var tl = r.tokenLimit !== undefined && r.tokenLimit !== null && r.tokenLimit !== ''
                    ? r.tokenLimit
                    : (r.TokenLimit !== undefined && r.TokenLimit !== null && r.TokenLimit !== '' ? r.TokenLimit : null);
                var tr = r.tokensRemaining !== undefined && r.tokensRemaining !== null && r.tokensRemaining !== ''
                    ? r.tokensRemaining
                    : (r.TokensRemaining !== undefined && r.TokensRemaining !== null && r.TokensRemaining !== '' ? r.TokensRemaining : null);
                var uld = !!(r.unlimitedPerDay || r.UnlimitedPerDay);
                var ulw = !!(r.unlimitedPerWeek || r.UnlimitedPerWeek);
                var ulm = !!(r.unlimitedPerMonth || r.UnlimitedPerMonth);
                function limPair(cLim, pLim, cRem, pRem, u) {
                    var l = r[cLim] !== undefined && r[cLim] !== null && r[cLim] !== '' ? r[cLim] : (r[pLim] !== undefined && r[pLim] !== null && r[pLim] !== '' ? r[pLim] : null);
                    var rem = r[cRem] !== undefined && r[cRem] !== null && r[cRem] !== '' ? r[cRem] : (r[pRem] !== undefined && r[pRem] !== null && r[pRem] !== '' ? r[pRem] : null);
                    return {
                        limit: u || l === null || l === '' ? null : Number(l),
                        remaining: u || rem === null || rem === '' ? null : Number(rem)
                    };
                }
                var day = limPair('tokenLimitPerDay', 'TokenLimitPerDay', 'tokensRemainingPerDay', 'TokensRemainingPerDay', uld);
                var week = limPair('tokenLimitPerWeek', 'TokenLimitPerWeek', 'tokensRemainingPerWeek', 'TokensRemainingPerWeek', ulw);
                var month = limPair('tokenLimitPerMonth', 'TokenLimitPerMonth', 'tokensRemainingPerMonth', 'TokensRemainingPerMonth', ulm);
                return {
                    tokensUsed: tu,
                    tokenLimit: ul || tl === null || tl === '' ? null : Number(tl),
                    tokensRemaining: ul || tr === null || tr === '' ? null : Number(tr),
                    unlimited: ul,
                    tokensUsedTodayUtc: pickNum(r, 'tokensUsedTodayUtc', 'TokensUsedTodayUtc') ?? 0,
                    tokenLimitPerDay: day.limit,
                    tokensRemainingPerDay: day.remaining,
                    unlimitedPerDay: uld,
                    tokensUsedThisWeekUtc: pickNum(r, 'tokensUsedThisWeekUtc', 'TokensUsedThisWeekUtc') ?? 0,
                    tokenLimitPerWeek: week.limit,
                    tokensRemainingPerWeek: week.remaining,
                    unlimitedPerWeek: ulw,
                    tokensUsedThisMonthUtc: pickNum(r, 'tokensUsedThisMonthUtc', 'TokensUsedThisMonthUtc') ?? 0,
                    tokenLimitPerMonth: month.limit,
                    tokensRemainingPerMonth: month.remaining,
                    unlimitedPerMonth: ulm
                };
            }

            function fmtTokCell(n) {
                if (n == null || !Number.isFinite(n)) return '—';
                return Number(n).toLocaleString('vi-VN');
            }

            function fmtLimitCell(unlimited, limit) {
                if (unlimited || limit == null) return 'Không giới hạn';
                return fmtTokCell(limit);
            }

            function fmtRemCell(unlimited, rem) {
                if (unlimited) return '—';
                if (rem == null || !Number.isFinite(rem)) return '—';
                return fmtTokCell(rem);
            }

            function parseBudgetLimitInput(raw) {
                var s = String(raw || '').trim().replace(/\s/g, '');
                if (s === '') return { value: null };
                if (!/^\d+$/.test(s)) return { err: 'Chỉ nhập chữ số (số nguyên không âm) hoặc để trống.' };
                var n = parseInt(s, 10);
                if (!Number.isFinite(n) || n < 0 || n > 9007199254740991) return { err: 'Giá trị hạn mức không hợp lệ.' };
                return { value: n };
            }

            async function loadAuthorAiTokenBudgetPanel() {
                var errEl = document.getElementById('aiAuthorBudgetErr');
