                var limWeek = document.getElementById('aiAuthorBudgetLimitInputWeek');
                var limMonth = document.getElementById('aiAuthorBudgetLimitInputMonth');
                if (okEl) {
                    okEl.classList.add('d-none');
                    okEl.textContent = '';
                }
                var uid = getSelectedAuthorBudgetUserId();
                if (!uid) {
                    if (errEl) {
                        errEl.classList.remove('d-none');
                        errEl.textContent = 'Chọn một tác giả trong danh sách bên trái (hoặc tải lại danh sách).';
                    }
                    if (wrap) wrap.classList.add('d-none');
                    return;
                }
                if (errEl) {
                    errEl.classList.add('d-none');
                    errEl.textContent = '';
                }
                try {
                    var r = await ApiService.adminGetAuthorAiTokenBudget(uid);
                    var d = parseAuthorBudgetDto(r);
                    if (!d) throw new Error('Phản hồi rỗng.');
                    var uLife = document.getElementById('aiAuthorBudgetUsedLife');
                    var lLife = document.getElementById('aiAuthorBudgetLimitLife');
                    var rLife = document.getElementById('aiAuthorBudgetRemLife');
                    if (uLife) uLife.textContent = fmtTokCell(d.tokensUsed);
                    if (lLife) lLife.textContent = fmtLimitCell(d.unlimited, d.tokenLimit);
                    if (rLife) rLife.textContent = fmtRemCell(d.unlimited, d.tokensRemaining);
                    var uDay = document.getElementById('aiAuthorBudgetUsedDay');
                    var lDay = document.getElementById('aiAuthorBudgetLimitDay');
                    var rDay = document.getElementById('aiAuthorBudgetRemDay');
                    if (uDay) uDay.textContent = fmtTokCell(d.tokensUsedTodayUtc);
                    if (lDay) lDay.textContent = fmtLimitCell(d.unlimitedPerDay, d.tokenLimitPerDay);
                    if (rDay) rDay.textContent = fmtRemCell(d.unlimitedPerDay, d.tokensRemainingPerDay);
                    var uWeek = document.getElementById('aiAuthorBudgetUsedWeek');
                    var lWeek = document.getElementById('aiAuthorBudgetLimitWeek');
                    var rWeek = document.getElementById('aiAuthorBudgetRemWeek');
                    if (uWeek) uWeek.textContent = fmtTokCell(d.tokensUsedThisWeekUtc);
                    if (lWeek) lWeek.textContent = fmtLimitCell(d.unlimitedPerWeek, d.tokenLimitPerWeek);
                    if (rWeek) rWeek.textContent = fmtRemCell(d.unlimitedPerWeek, d.tokensRemainingPerWeek);
                    var uMonth = document.getElementById('aiAuthorBudgetUsedMonth');
                    var lMonth = document.getElementById('aiAuthorBudgetLimitMonth');
                    var rMonth = document.getElementById('aiAuthorBudgetRemMonth');
                    if (uMonth) uMonth.textContent = fmtTokCell(d.tokensUsedThisMonthUtc);
                    if (lMonth) lMonth.textContent = fmtLimitCell(d.unlimitedPerMonth, d.tokenLimitPerMonth);
                    if (rMonth) rMonth.textContent = fmtRemCell(d.unlimitedPerMonth, d.tokensRemainingPerMonth);
                    if (limInput) limInput.value = d.unlimited || d.tokenLimit == null ? '' : String(d.tokenLimit);
                    if (limDay) limDay.value = d.unlimitedPerDay || d.tokenLimitPerDay == null ? '' : String(d.tokenLimitPerDay);
                    if (limWeek) limWeek.value = d.unlimitedPerWeek || d.tokenLimitPerWeek == null ? '' : String(d.tokenLimitPerWeek);
                    if (limMonth) limMonth.value = d.unlimitedPerMonth || d.tokenLimitPerMonth == null ? '' : String(d.tokenLimitPerMonth);
                    if (wrap) wrap.classList.remove('d-none');
                } catch (e) {
                    if (wrap) wrap.classList.add('d-none');
                    if (errEl) {
                        errEl.classList.remove('d-none');
                        errEl.textContent = (e && e.status === 404) ? 'Không tìm thấy user.' : (e.message || String(e));
                    }
                }
            }

