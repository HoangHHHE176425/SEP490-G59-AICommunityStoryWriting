                if (ok) { ok.classList.add('d-none'); ok.textContent = ''; }
                if (!msg) return;
                if (kind === 'ok' && ok) { ok.classList.remove('d-none'); ok.textContent = msg; }
                if (kind === 'err' && err) { err.classList.remove('d-none'); err.textContent = msg; }
