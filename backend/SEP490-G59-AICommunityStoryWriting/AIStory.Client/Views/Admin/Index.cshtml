                var tr = document.getElementById('aiActivityTotalReq');
                var tt = document.getElementById('aiActivityTotalTok');
                if (!filtered.length) {
                    if (wrap) wrap.classList.remove('d-none');
                    if (ts) ts.textContent = '—';
                    if (tr) tr.textContent = '—';
                    if (tt) tt.textContent = '—';
                    ['aiActivityCanvasSpend', 'aiActivityCanvasReq', 'aiActivityCanvasTok'].forEach(function (id) {
                        var c = document.getElementById(id);
                        if (c && c.getContext) {
                            var ctx = c.getContext('2d');
                            if (ctx) ctx.clearRect(0, 0, c.width, c.height);
                        }
                    });
                    ['aiActivityLegendSpend', 'aiActivityLegendReq', 'aiActivityLegendTok'].forEach(function (id) {
                        var e = document.getElementById(id);
                        if (e) e.innerHTML = '<span class="text-muted">Không có dòng trong khoảng đã chọn.</span>';
                    });
                    return;
                }
                var sUsage = buildActivitySeries(filtered, 'usage');
                var sReq = buildActivitySeries(filtered, 'requests');
                var sTok = buildActivitySeries(filtered, 'tokens');
                if (ts) ts.textContent = '$' + fmtUsd(sUsage.grand);
                if (tr) tr.textContent = fmtCompactCount(sReq.grand);
                if (tt) tt.textContent = fmtCompactCount(sTok.grand);
                drawActivityStackedChart('aiActivityCanvasSpend', sUsage);
                drawActivityStackedChart('aiActivityCanvasReq', sReq);
                drawActivityStackedChart('aiActivityCanvasTok', sTok);
                renderActivityLegend('aiActivityLegendSpend', sUsage, 'usage', 6);
                renderActivityLegend('aiActivityLegendReq', sReq, 'requests', 6);
                renderActivityLegend('aiActivityLegendTok', sTok, 'tokens', 6);
                if (wrap) wrap.classList.remove('d-none');
            }

