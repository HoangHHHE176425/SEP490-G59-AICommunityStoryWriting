            function aiReqUserGroupKey(x) {
                var uid = x.userId != null ? x.userId : x.UserId;
                if (uid !== null && uid !== undefined && String(uid).trim() !== '')
                    return 'id:' + String(uid).trim().toLowerCase();
                var email = x.userEmail != null ? x.userEmail : x.UserEmail;
                return 'em:' + String(email || '').trim().toLowerCase();
            }

            function groupAiReqItemsByUser(items) {
                var order = [];
                var map = {};
                (items || []).forEach(function (x) {
                    var k = aiReqUserGroupKey(x);
                    if (!map[k]) {
                        map[k] = [];
                        order.push(k);
                    }
                    map[k].push(x);
                });
                return order.map(function (k) {
                    return { key: k, items: map[k] };
                });
            }

            function aiReqItemTimeMs(x) {
                var c = x.createdAtUtc || x.CreatedAtUtc;
                if (!c) return 0;
                var s = String(c).trim();
                if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}/.test(s) && !/[zZ]$/.test(s) && !/[+-][0-9]{2}:/.test(s))
                    s = s.replace(' ', 'T');
                if (/^\d{4}-\d{2}-\d{2}T/.test(s) && !/[zZ]$/.test(s) && !/[+-][0-9]{2}:/.test(s))
                    s += 'Z';
                var t = new Date(s).getTime();
                return isNaN(t) ? 0 : t;
            }

            function aiReqLineTokens(x) {
                var tt = x.totalTokens != null ? x.totalTokens : x.TotalTokens;
                if (tt != null && !isNaN(Number(tt))) return Number(tt);
                var pt = x.promptTokens != null ? x.promptTokens : x.PromptTokens;
                var ct = x.completionTokens != null ? x.completionTokens : x.CompletionTokens;
                return (Number(pt) || 0) + (Number(ct) || 0);
            }

            function aiReqUserLabelHtml(x) {
                var email = x.userEmail || x.UserEmail || '';
                var uid = x.userId || x.UserId || '';
                return '<div class="text-break">' + escapeHtml(email || '—') + '</div>' +
                    (uid ? '<div class="text-muted" style="font-size:0.75rem">' + escapeHtml(String(uid)) + '</div>' : '');
            }

            function aiReqInnerRowHtml(x) {
                var pt = x.promptTokens != null ? x.promptTokens : x.PromptTokens;
                var ct = x.completionTokens != null ? x.completionTokens : x.CompletionTokens;
                var tt = x.totalTokens != null ? x.totalTokens : x.TotalTokens;
                var tok = (pt != null ? pt : '—') + ' / ' + (ct != null ? ct : '—') + ' / ' + (tt != null ? tt : '—');
                var gid = x.generationId || x.GenerationId || '';
                var genCell = gid
                    ? '<button type="button" class="btn btn-link btn-sm p-0 ai-gen-btn text-break" data-gen-id="' + escapeHtml(gid) + '">' + escapeHtml(gid.length > 28 ? gid.substring(0, 28) + '…' : gid) + '</button>'
