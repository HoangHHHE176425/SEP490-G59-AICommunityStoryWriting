            function aiAutoGrantReadForm() {
                var dn = document.getElementById('aiAutoGrantDisplayName');
                var pk = document.getElementById('aiAutoGrantPeriodKind');
                var am = document.getElementById('aiAutoGrantAmount');
                var en = document.getElementById('aiAutoGrantEnabled');
                var all = document.getElementById('aiAutoGrantAllAuthors');

                var amount = am ? parseInt(am.value, 10) : 0;
                if (isNaN(amount) || amount <= 0) throw new Error('Số token cộng phải là số nguyên > 0.');

                var applyAll = all ? !!all.checked : false;
                var ids = applyAll ? [] : getAiAutoGrantSelectedAuthors();
                if (!applyAll && ids.length === 0) throw new Error('Cần chọn ít nhất một tác giả hoặc chọn “Tất cả tác giả”.');

                return {
                    isEnabled: en ? !!en.checked : true,
                    displayName: dn && dn.value.trim() ? dn.value.trim() : null,
                    periodKind: pk ? pk.value : 'monthly_utc',
                    grantLimitField: autoGrantLimitFieldFromPeriodKind(pk ? pk.value : 'monthly_utc'),
                    grantAmount: amount,
                    applyToAllAuthors: applyAll,
                    selectedUserIds: ids
                };
