                                    '<div class="small text-muted mb-2">Lọc theo số lượng báo cáo: chỉ hiện lý do có tổng số báo <strong>lớn hơn</strong> ngưỡng đã chọn.</div>' +
                                    '<div class="mb-2 d-flex flex-wrap gap-1 align-items-center">' +
                                    '<button type="button" class="btn btn-outline-secondary btn-sm" data-sr-reason-gt="-1">Tất cả</button>' +
                                    '<button type="button" class="btn btn-outline-secondary btn-sm" data-sr-reason-gt="10">Lớn hơn 10</button>' +
                                    '<button type="button" class="btn btn-outline-secondary btn-sm" data-sr-reason-gt="50">Lớn hơn 50</button>' +
                                    '<button type="button" class="btn btn-outline-secondary btn-sm" data-sr-reason-gt="100">Lớn hơn 100</button>' +
                                    '<button type="button" class="btn btn-outline-secondary btn-sm" data-sr-reason-gt="1000">Lớn hơn 1000</button>' +
                                    '</div>' +
                                    '<div id="srStoryReasonFilterList">' + renderSrReasons(reasonGt) + '</div>'
                                  )
                                : '<div class="text-muted small mb-3">—</div>';

                            const srList = det.reporterDetails || [];
                            let srSyncStoryReporterTable = function () {};
                            let reportersBlockHtml;
                            if (srList.length) {
                                const verifiedTotal = srList.filter(srRowVerified).length;
                                const headChk = det.canVerifyContributor ? '<th style="width:2.5rem" title="Chọn để lưu xác minh">✓</th>' : '';
                                const colCount = det.canVerifyContributor ? 7 : 6;
                                function srBuildRows(rows) {
                                    if (!rows.length)
                                        return '<tr><td colspan="' + colCount + '" class="text-muted small text-center py-3">Không có request phù hợp bộ lọc.</td></tr>';
                                    return rows.map(function (row) {
                                        const uid = row.userId || row.UserId;
                                        const rname = row.reporterDisplayName || row.ReporterDisplayName || '—';
                                        const reason = row.reasonLabelVi || row.ReasonLabelVi || '—';
                                        const desc = row.description || row.Description || '';
                                        const ra = row.reportedAtUtc || row.ReportedAtUtc;
                                        const verified = srRowVerified(row);
                                        const note = row.detailNote || row.DetailNote;
                                        const canMark = srCanMarkRow(row);
                                        const chk = (det.canVerifyContributor && canMark)
                                            ? '<input type="checkbox" class="form-check-input sr-contributor-verify-chk" data-contributor-user-id="' + crEscapeHtml(String(uid)) + '" data-was-verified="' + (verified ? '1' : '0') + '" id="sr-u-' + crEscapeHtml(String(uid)) + '"' + (verified ? ' checked' : '') + ' />'
                                            : '';
                                        const chkCell = det.canVerifyContributor
                                            ? '<td class="align-middle text-center">' + (chk || '<span class="text-muted small">—</span>') + '</td>'
                                            : '';
                                        const mainRow = '<tr>' + chkCell +
                                            '<td class="small">' + crEscapeHtml(String(rname)) + '</td>' +
                                            '<td class="small">' + crEscapeHtml(String(reason)) + '</td>' +
                                            '<td class="small text-nowrap">' + (ra ? crEscapeHtml(Utils.formatDateUtc(ra)) : '<span class="text-muted">—</span>') + '</td>' +
                                            '<td class="small text-break">' + (desc ? crEscapeHtml(String(desc)) : '<span class="text-muted">—</span>') + '</td>' +
                                            '<td class="small font-monospace text-muted">' + crEscapeHtml(String(uid).slice(0, 8)) + '…</td>' +
                                            '<td class="small">' + (verified ? '<span class="badge bg-success">Đã xác minh</span>' : '<span class="text-muted">Chưa xác minh</span>') + '</td>' +
                                            '</tr>';
                                        const noteRow = note
                                            ? '<tr><td colspan="' + colCount + '" class="small text-warning border-top-0 pt-0 pb-2">' + crEscapeHtml(String(note)) + '</td></tr>'
                                            : '';
                                        return mainRow + noteRow;
                                    }).join('');
                                }
                                srSyncStoryReporterTable = function () {
                                    const tbody = document.getElementById('srStoryReporterTbody');
                                    const hintEl = document.getElementById('srDetailFilteredHint');
                                    if (!tbody) return;
                                    const filtered = srFilterReporterRows(srList);
                                    if (hintEl) {
                                        const hasExtra = selectedReasonLabel || verifyFilter !== 'all';
                                        hintEl.textContent = hasExtra ? ('Đang hiển thị ' + filtered.length + ' / ' + srList.length + ' request') : '';
                                    }
                                    tbody.innerHTML = srBuildRows(filtered);
                                };
                                reportersBlockHtml =
                                    '<div id="srDetailReporterMeta" class="mb-2 d-flex flex-wrap gap-2 align-items-center">' +
                                    '<span class="small"><strong>Tổng request:</strong> ' + srList.length + '</span>' +
                                    '<span class="small text-muted">|</span>' +
                                    '<span class="small text-success"><strong>Đã xác minh:</strong> ' + verifiedTotal + '</span>' +
                                    '<span class="small text-muted">|</span>' +
                                    '<span class="small"><strong>Chưa xác minh:</strong> ' + (srList.length - verifiedTotal) + '</span>' +
                                    '<span class="small text-primary ms-1" id="srDetailFilteredHint"></span>' +
                                    '</div>' +
                                    '<div class="d-flex flex-wrap gap-1 align-items-center mb-2">' +
                                    '<span class="small text-muted me-1">Lọc trạng thái xác minh:</span>' +
                                    '<button type="button" class="btn btn-sm btn-outline-secondary sr-detail-vf active" data-sr-vf="all">Tất cả</button>' +
                                    '<button type="button" class="btn btn-sm btn-outline-secondary sr-detail-vf" data-sr-vf="unverified">Chưa xác minh</button>' +
                                    '<button type="button" class="btn btn-sm btn-outline-secondary sr-detail-vf" data-sr-vf="verified">Đã xác minh</button>' +
                                    '</div>' +
                                    '<div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0">' +
                                    '<thead class="table-light"><tr>' + headChk +
                                    '<th>Người báo cáo</th><th>Lý do</th><th>Thời gian gửi (UTC)</th><th>Mô tả</th><th>User ID</th><th>Trạng thái xác minh</th>' +
                                    '</tr></thead><tbody id="srStoryReporterTbody"></tbody></table></div>' +
                                    (det.canVerifyContributor
                                        ? '<div class="d-flex flex-wrap gap-2 align-items-center mt-2">' +
                                          '<button type="button" class="btn btn-primary btn-sm" id="srBtnSaveContributorVerify">Lưu đánh dấu xác minh</button>' +
                                          '<span class="small text-muted">Chọn các request đã xác minh, bấm Lưu. Bỏ chọn để gỡ đánh dấu đã lưu trước đó.</span>' +
                                          '</div>'
                                        : '<div class="small text-muted mt-2">Chỉ compliance đang lock (hoặc admin) mới chỉnh được đánh dấu xác minh.</div>');
                            } else {
                                reportersBlockHtml = '<div class="text-muted small">—</div>';
                            }

                            body.innerHTML =
                                '<div class="mb-2 small"><strong>Truyện:</strong> <a href="/Home/Story/' + encodeURIComponent(det.storyId) + '" target="_blank" rel="noopener">' + crEscapeHtml(det.storyTitle || '') + '</a></div>' +
                                '<div class="mb-2"><div class="small text-muted">Tất cả lý do report + số lượng</div></div>' +
                                reasonsBlockHtml +
                                '<div class="mb-2 mt-3"><div class="small text-muted">Chi tiết từng request báo cáo (theo người report)</div></div>' +
                                reportersBlockHtml;

                            srSyncStoryReporterTable();

                            const modalSr = document.getElementById('srModalStoryReportDetail');
                            body.onclick = function (ev) {
                                const t = ev.target;
                                const badge = t.closest && t.closest('.sr-reason-badge-filter');
                                if (badge && body.contains(badge)) {
                                    const enc = badge.getAttribute('data-sr-reason-lbl');
                                    let lbl = '';
                                    try { lbl = decodeURIComponent(enc || ''); } catch (eR) { lbl = ''; }
                                    lbl = String(lbl).trim();
                                    selectedReasonLabel = (selectedReasonLabel === lbl) ? null : lbl;
                                    const le = document.getElementById('srStoryReasonFilterList');
                                    if (le) le.innerHTML = renderSrReasons(reasonGt);
                                    srSyncStoryReporterTable();
                                    return;
                                }
                                const vf = t.closest && t.closest('.sr-detail-vf');
                                if (vf && body.contains(vf)) {
                                    verifyFilter = vf.getAttribute('data-sr-vf') || 'all';
                                    body.querySelectorAll('.sr-detail-vf').forEach(function (x) {
                                        x.classList.toggle('active', (x.getAttribute('data-sr-vf') || 'all') === verifyFilter);
                                    });
                                    srSyncStoryReporterTable();
                                }
                            };

                            const listSr = document.getElementById('srStoryReasonFilterList');
                            if (body && listSr) {
                                body.querySelectorAll('[data-sr-reason-gt]').forEach(function (b) {
                                    b.addEventListener('click', function () {
                                        const mc = parseInt(b.getAttribute('data-sr-reason-gt') || '-1', 10);
                                        reasonGt = Number.isFinite(mc) ? mc : -1;
                                        const visible = (reasonItems || []).filter(function (x) {
                                            const c = x.count || 0;
                                            if (reasonGt < 0) return true;
                                            return c > reasonGt;
                                        });
                                        if (selectedReasonLabel && !visible.some(function (x) { return x.label === selectedReasonLabel; }))
                                            selectedReasonLabel = null;
                                        listSr.innerHTML = renderSrReasons(reasonGt);
                                        srSyncStoryReporterTable();
                                    });
                                });
                            }

                            const saveSrBtn = document.getElementById('srBtnSaveContributorVerify');
                            if (saveSrBtn && det.canVerifyContributor && det.storyId) {
                                saveSrBtn.addEventListener('click', async function () {
                                    const verify = [];
                                    const unverify = [];
                                    body.querySelectorAll('.sr-contributor-verify-chk').forEach(function (chk) {
                                        const id = chk.getAttribute('data-contributor-user-id');
                                        if (!id) return;
                                        const was = chk.getAttribute('data-was-verified') === '1';
                                        const now = chk.checked;
                                        if (now && !was) verify.push(id);
                                        if (!now && was) unverify.push(id);
                                    });
                                    if (!verify.length && !unverify.length) {
                                        Utils.showAlert('Không có thay đổi.', 'info');
                                        return;
                                    }
                                    try {
                                        await ApiService.complianceSetStoryContributorVerification(det.storyId, {
                                            verifyUserIds: verify,
                                            unverifyUserIds: unverify
                                        });
                                        Utils.showAlert('Đã lưu đánh dấu xác minh.', 'success');
                                        if (modalSr) {
                                            const inst = bootstrap.Modal.getInstance(modalSr);
                                            if (inst) inst.hide();
                                        }
                                        crLoad();
                                    } catch (e) {
                                        Utils.showAlert(e.message || e, 'danger');
                                    }
                                });
                            }

                            new bootstrap.Modal(document.getElementById('srModalStoryReportDetail')).show();
                        });
                    });
                } else {
                    let html = '<table class="table table-sm table-hover align-middle"><thead class="table-light"><tr>' +
                        '<th>Id báo cáo</th><th>Truyện</th><th>Mod</th><th>Lý do</th><th>Điểm</th><th>Người báo</th><th>Trạng thái</th><th>Tạo lúc</th><th>Lock</th><th></th></tr></thead><tbody>';
                    if (!rows.length) {
                        html += '<tr><td colspan="10" class="text-muted text-center py-4">Không có dữ liệu.</td></tr>';
                    } else {
                        rows.forEach(function (x) {
                            const rid = x.reportId || x.ReportId;
                            const stitle = x.storyTitle || x.StoryTitle || '';
                            const sid = x.storyId || x.StoryId;
                            const reason = x.reasonCode || x.ReasonCode || '';
                            const sev = x.severityScore != null ? x.severityScore : x.SeverityScore;
                            const em = x.reporterEmail || x.ReporterEmail || '—';
                            const contribsFlat = x.contributors || x.Contributors || [];
                            const contribsHtml = contribsFlat.length ? crFormatContributors(contribsFlat) : ('<span class="text-muted">' + crEscapeHtml(em) + '</span>');
                            const st = x.status || x.Status || '';
                            const ca = x.createdAtUtc || x.CreatedAtUtc;
                            const lockCell = crFormatComplianceLockSla(x);
                            const mine = x.isComplianceClaimedByMe === true || x.IsComplianceClaimedByMe === true;
                            const stUp = (st || '').toUpperCase();
                            const isOpenTicket = stUp === 'NEW' || stUp === 'IN_REVIEW';
                            let actionCell = '';
                            if (isAdm) {
                                actionCell = '<select class="form-select form-select-sm cr-status-sel" data-rid="' + crEscapeHtml(String(rid)) + '">' +
                                    '<option value="">Đổi trạng thái…</option>' +
                                    '<option value="IN_REVIEW">IN_REVIEW</option>' +
                                    '<option value="RESOLVED">RESOLVED</option>' +
                                    '<option value="DISMISSED">DISMISSED</option>' +
                                    '<option value="NEW">NEW</option></select>';
                            } else if (mine && isOpenTicket) {
                                actionCell = '<select class="form-select form-select-sm cr-resolve-sel" data-rid="' + crEscapeHtml(String(rid)) + '">' +
                                    '<option value="">Đánh dấu xử lý…</option>' +
                                    '<option value="RESOLVED">RESOLVED (đã xử lý)</option>' +
                                    '<option value="DISMISSED">DISMISSED (bác bỏ)</option></select>';
                            } else {
                                actionCell = '<span class="text-muted small" title="Chỉ khi bạn đang nhận lock truyện và ticket còn mở.">—</span>';
                            }
                            html += '<tr>' +
                                '<td class="small text-break">' + crEscapeHtml(String(rid)) + '</td>' +
                                '<td><a href="/Home/Story/' + encodeURIComponent(sid) + '" target="_blank" rel="noopener">' + crEscapeHtml(stitle) + '</a></td>' +
                                '<td class="small">' + crStoryBadgesHtml(x) + '</td>' +
                                '<td class="small">' + crEscapeHtml(reason) + '</td>' +
                                '<td>' + crEscapeHtml(String(sev)) + '</td>' +
                                '<td class="small">' + contribsHtml + '</td>' +
                                '<td class="small">' + crEscapeHtml(st) + '</td>' +
                                '<td class="small">' + crEscapeHtml(ca ? Utils.formatDate(ca) : '—') + '</td>' +
                                '<td class="small">' + lockCell + '</td>' +
                                '<td>' + actionCell + '</td></tr>';
                        });
                    }
                    html += '</tbody></table>';
                    html += '<div class="small text-muted mt-2">Tổng: ' + total + '</div>';
                    host.innerHTML = html;
                    host.querySelectorAll('.cr-status-sel').forEach(function (sel) {
                        sel.addEventListener('change', async function () {
                            const v = sel.value;
                            if (!v) return;
                            const rid = sel.getAttribute('data-rid');
                            try {
                                await ApiService.complianceUpdateStoryReport(rid, v);
                                Utils.showAlert('Đã cập nhật.', 'success');
                                sel.value = '';
                                crLoad();
                            } catch (e) {
                                Utils.showAlert(e.message || e, 'danger');
                                sel.value = '';
                            }
                        });
                    });
                    host.querySelectorAll('.cr-resolve-sel').forEach(function (sel) {
                        sel.addEventListener('change', async function () {
                            const v = sel.value;
                            if (!v) return;
                            const rid = sel.getAttribute('data-rid');
                            try {
                                await ApiService.complianceResolveReport(rid, { status: v });
                                Utils.showAlert('Đã đánh dấu xử lý.', 'success');
                                sel.value = '';
                                crLoad();
                            } catch (e) {
                                Utils.showAlert(e.message || e, 'danger');
                                sel.value = '';
                            }
                        });
                    });
                }
            } catch (e) {
                err.textContent = e.message || String(e);
                err.style.display = 'block';
                host.innerHTML = '';
            }
            // Always load comment reports along with story reports.
            crLoadCommentReports();
        }

        document.addEventListener('DOMContentLoaded', async function () {
            await AuthHelper.loadUserInfo().catch(function () { });
            if (!AuthHelper.isAuthenticated()) {
                Utils.showAlert('Vui lòng đăng nhập.', 'warning');
                setTimeout(function () { window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname); }, 1200);
                return;
            }
            if (!AuthHelper.isComplianceOfficer()) {
                Utils.showAlert('Chỉ COMPLIANCE hoặc ADMIN.', 'danger');
                setTimeout(function () { window.location.href = '/'; }, 1800);
                return;
            }
            await crLoadReasons();
            crApplyStatusFilterForRole();
            document.querySelectorAll('#crViewTabs [data-cr-view]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const m = btn.getAttribute('data-cr-view') || 'active';
                    crSwitchView(m);
                    if (m === 'history') {
                        var hp = document.getElementById('crHistPage');
                        if (hp) hp.value = '1';
                        crLoadHistory();
                    }
                });
            });
            var crHistApply = document.getElementById('crHistApply');
            if (crHistApply) crHistApply.addEventListener('click', function () { crLoadHistory(); });

            document.getElementById('crApply').addEventListener('click', function () {
                document.getElementById('crPage').value = '1';
                crLoad();
            });

            const rbtn = document.getElementById('crCommentRefreshBtn');
            if (rbtn) {
                rbtn.addEventListener('click', function () {
                    crLoadCommentReports();
                });
            }

            document.getElementById('crTableHost').addEventListener('click', function (ev) {
                const rel = ev.target.closest('[data-cr-open-lock-rel]');
                if (rel) {
                    crCtx.storyId = rel.getAttribute('data-sid') || '';
                    document.getElementById('crLockReleaseMsg').value = '';
                    var u1 = document.getElementById('crLockReleaseUrgency');
                    if (u1) u1.value = 'STANDARD';
                    new bootstrap.Modal(document.getElementById('crModalLockRelease')).show();
                    return;
                }
                const fl = ev.target.closest('[data-cr-open-flag]');
                if (fl) {
                    crCtx.storyId = fl.getAttribute('data-sid') || '';
                    crCtx.authorId = fl.getAttribute('data-aid') || null;
                    const f = fl.getAttribute('data-flagged') === '1';
                    document.getElementById('crFlagChecked').checked = f;
                    document.getElementById('crFlagNote').value = '';
                    new bootstrap.Modal(document.getElementById('crModalFlag')).show();
                    return;
                }
                const adm = ev.target.closest('[data-cr-open-admin-act]');
                if (adm) {
                    crCtx.storyId = adm.getAttribute('data-sid') || '';
                    crCtx.authorId = adm.getAttribute('data-aid') || null;
                    crCtx.commentId = null;
                    crCtx.isCommentReport = false;
                    document.getElementById('crBanMsg').value = '';
                    document.getElementById('crSuspendMsg').value = '';
                    document.getElementById('crSuspendUntilLocal').value = '';
                    new bootstrap.Modal(document.getElementById('crModalAdminAction')).show();
                    return;
                }
                const vl = ev.target.closest('[data-cr-open-viol]');
                if (vl) {
                    const aid = vl.getAttribute('data-aid');
                    const body = document.getElementById('crViolationsBody');
                    body.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';
                    new bootstrap.Modal(document.getElementById('crModalViolations')).show();
                    ApiService.complianceListUserViolations(aid, 80).then(function (list) {
                        if (!list || !list.length) {
                            body.innerHTML = '<p class="text-muted small mb-0">Chưa có bản ghi violation_logs.</p>';
                            return;
                        }
                        var h = '<ul class="list-group list-group-flush">';
                        list.forEach(function (v) {
                            var pid = v.penaltyType != null ? v.penaltyType : v.PenaltyType;
                            var rs = v.reason != null ? v.reason : v.Reason;
                            var ca = v.createdAtUtc != null ? v.createdAtUtc : v.CreatedAtUtc;
                            var off = v.complianceOfficerDisplayName != null ? v.complianceOfficerDisplayName : v.ComplianceOfficerDisplayName;
                            h += '<li class="list-group-item small"><div class="fw-semibold">' + crEscapeHtml(String(pid || '—')) + '</div>';
                            h += '<div class="text-muted">' + crEscapeHtml(ca ? Utils.formatDate(ca) : '') + '</div>';
                            if (off) h += '<div class="small">Bởi: ' + crEscapeHtml(String(off)) + '</div>';
                            if (rs) h += '<div class="mt-1">' + crEscapeHtml(String(rs)) + '</div>';
                            h += '</li>';
                        });
                        h += '</ul>';
                        body.innerHTML = h;
                    }).catch(function (e) {
                        body.innerHTML = '<p class="text-danger small">' + crEscapeHtml(e.message || String(e)) + '</p>';
                    });
                    return;
                }
                const tc = ev.target.closest('[data-cr-toggle-cmt]');
                if (tc) {
                    const sid = tc.getAttribute('data-sid');
                    const on = tc.getAttribute('data-on') === '1';
                    if (!confirm(on ? 'Bật lại bình luận cho truyện này?' : 'Tắt bình luận (độc giả không gửi comment mới)?')) return;
                    ApiService.complianceSetStoryCommentsDisabled(sid, !on).then(function () {
                        Utils.showAlert('Đã cập nhật bình luận.', 'success');
                        crLoad();
                    }).catch(function (e) { Utils.showAlert(e.message || e, 'danger'); });
                    return;
                }
                const th = ev.target.closest('[data-cr-toggle-hide]');
                if (th) {
                    const sid = th.getAttribute('data-sid');
                    const on = th.getAttribute('data-on') === '1';
                    if (!confirm(on ? 'Hiện lại truyện trên danh sách công khai?' : 'Ẩn truyện khỏi người xem thường (tác giả / admin / compliance vẫn xem được)?')) return;
                    ApiService.complianceSetStoryHidden(sid, !on).then(function () {
                        Utils.showAlert('Đã cập nhật hiển thị truyện.', 'success');
                        crLoad();
                    }).catch(function (e) { Utils.showAlert(e.message || e, 'danger'); });
                }
            });

            document.getElementById('crLockReleaseSubmit').addEventListener('click', async function () {
                const msg = document.getElementById('crLockReleaseMsg').value.trim();
                try {
                    await ApiService.complianceRequestLockRelease(crCtx.storyId, { message: msg || null });
                    bootstrap.Modal.getInstance(document.getElementById('crModalLockRelease')).hide();
                    Utils.showAlert('Đã gửi yêu cầu admin.', 'success');
                    crLoad();
                } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
            });

            document.getElementById('crFlagSubmit').addEventListener('click', async function () {
                const flagged = document.getElementById('crFlagChecked').checked;
                const note = document.getElementById('crFlagNote').value.trim();
                try {
                    await ApiService.complianceSetStoryFlag(crCtx.storyId, { flagged: flagged, note: note || null });
                    bootstrap.Modal.getInstance(document.getElementById('crModalFlag')).hide();
                    Utils.showAlert('Đã cập nhật cờ theo dõi.', 'success');
                    crLoad();
                } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
            });

            document.getElementById('crAdminActionSubmit').addEventListener('click', async function () {
                const pane = document.querySelector('#crModalAdminAction .tab-pane.active');
                const pid = pane ? pane.id : '';
                try {
                    if (pid === 'crActBan') {
                        if (crCtx.isCommentReport && crCtx.commentId) {
                            await ApiService.complianceRequestAdminActionOnComment(crCtx.commentId, {
                                requestKind: 'BAN_USER',
                                message: document.getElementById('crBanMsg').value.trim() || null
                            });
                        } else {
                            await ApiService.complianceRequestAdminAction(crCtx.storyId, {
                                requestKind: 'BAN_USER',
                                message: document.getElementById('crBanMsg').value.trim() || null
                            });
                        }
                    } else {
                        const iso = crToIsoUtcFromLocal(document.getElementById('crSuspendUntilLocal').value);
                        if (!iso) {
                            Utils.showAlert('Chọn thời điểm kết thúc tạm khóa viết.', 'warning');
                            return;
                        }
                        if (crCtx.isCommentReport && crCtx.commentId) {
                            await ApiService.complianceRequestAdminActionOnComment(crCtx.commentId, {
                                requestKind: 'SUSPEND_AUTHOR_WRITING',
                                message: document.getElementById('crSuspendMsg').value.trim() || null,
                                proposedSuspendUntilUtc: iso
                            });
                        } else {
                            await ApiService.complianceRequestAdminAction(crCtx.storyId, {
                                requestKind: 'SUSPEND_AUTHOR_WRITING',
                                message: document.getElementById('crSuspendMsg').value.trim() || null,
                                proposedSuspendUntilUtc: iso
                            });
                        }
                    }
                    bootstrap.Modal.getInstance(document.getElementById('crModalAdminAction')).hide();
                    Utils.showAlert('Đã gửi yêu cầu lên admin.', 'success');
                    crLoad();
                } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
            });

            crLoad();
        });
    </script>
}
