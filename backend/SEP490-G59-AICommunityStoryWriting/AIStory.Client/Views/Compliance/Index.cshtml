@{
    ViewData["Title"] = "Báo cáo truyện (Compliance)";
}

<style>
    .cr-hero {
        background: linear-gradient(135deg, #1e3a5f 0%, #0d2137 100%);
        color: #fff;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 8px 24px rgba(13,33,55,.25);
    }

        .cr-hero .cr-hero-sub {
            color: rgba(255,255,255,.88);
            font-size: .9rem;
            max-width: 52rem;
        }

    .cr-filters.card {
        border: none;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        border-radius: 12px;
    }

    .cr-table-wrap {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
    }

        .cr-table-wrap table {
            margin-bottom: 0;
        }

    .cr-story-badges .badge {
        font-weight: 500;
    }
</style>

<div class="container-fluid mt-3 mb-5 px-2 px-md-3">
    <div class="cr-hero">
        <h2 class="h4 mb-2"><i class="bi bi-shield-exclamation me-2"></i>Xử lý báo cáo truyện</h2>
        <p class="cr-hero-sub mb-0">
            Sau khi <strong>nhận (lock)</strong>, xử lý vi phạm rồi <strong>đánh dấu báo cáo đã xử lý</strong> (RESOLVED / DISMISSED) — ticket đó biến khỏi danh sách đang mở; xem lại tại tab <strong>Lịch sử của tôi</strong>.
            Gắn cờ, ẩn truyện, tắt bình luận, gửi đơn lên admin như trước. Đơn admin: <a href="/Admin?esc=compliance" class="link-light text-decoration-underline">Admin → Compliance</a>.
        </p>
    </div>
    <p class="text-muted small d-none d-md-block mb-2" id="crHelpActive">
        <strong>PriorityScore</strong> = Severity (gộp) + (ReportCount × 5) + TimeWeight. Mặc định chỉ <code>NEW</code> + <code>IN_REVIEW</code> (báo cáo đã xử lý không hiện ở đây).
        <strong>Nhận xử lý</strong> = lock truyện; độc giả vẫn gửi thêm báo cáo. Khi <strong>hết</strong> báo cáo mở, lock tự hết.
        Tự <strong>gỡ lock</strong> khi cần: <strong>Gửi yêu cầu admin</strong> — chỉ admin gỡ trực tiếp (hoặc duyệt đơn).
        Cột <strong>Lock</strong>: thời điểm nhận (UTC) và cảnh báo theo thời gian đã trôi.
    </p>
    <p class="text-muted small d-none d-md-block mb-3" id="crHelpHistory" style="display:none;">
        Các báo cáo <strong>bạn</strong> đã đánh dấu <code>RESOLVED</code> hoặc <code>DISMISSED</code>. Admin đóng ticket không hiện ở đây.
    </p>

    <ul class="nav nav-tabs mb-3" id="crViewTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button" id="crTabActive" data-cr-view="active" aria-selected="true">Đang xử lý</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" id="crTabHistory" data-cr-view="history" aria-selected="false">Lịch sử của tôi</button>
        </li>
    </ul>

    <div id="crPanelActive">
        <div class="card cr-filters mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Chế độ</label>
                        <select class="form-select form-select-sm" id="crGroupBy">
                            <option value="true" selected>Gom theo truyện</option>
                            <option value="false">Từng báo cáo</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Trạng thái</label>
                        <select class="form-select form-select-sm" id="crStatuses">
                            <option value="" selected>NEW + IN_REVIEW</option>
                            <option value="ALL">Tất cả</option>
                            <option value="NEW">NEW</option>
                            <option value="IN_REVIEW">IN_REVIEW</option>
                            <option value="RESOLVED">RESOLVED</option>
                            <option value="DISMISSED">DISMISSED</option>
                            <option value="NEW,IN_REVIEW,RESOLVED,DISMISSED">Kết hợp (tất cả mã)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Lý do</label>
                        <select class="form-select form-select-sm" id="crReason">
                            <option value="">(Mọi lý do)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Story ID</label>
                        <input class="form-control form-control-sm" id="crStoryId" placeholder="Guid (tùy chọn)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Tìm tiêu đề / slug</label>
                        <input class="form-control form-control-sm" id="crSearch" placeholder="Search..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Lock / nhận</label>
                        <select class="form-select form-select-sm" id="crClaimFilter" title="Giống moderator: ẩn mục đang bị người khác lock (mặc định all)">
                            <option value="all" selected>Tất cả (trừ lock người khác)</option>
                            <option value="unclaimed">Chưa ai nhận</option>
                            <option value="mine">Tôi đang nhận</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Sắp xếp</label>
                        <select class="form-select form-select-sm" id="crSort">
                            <option value="priority_desc" selected>Ưu tiên ↓</option>
                            <option value="priority_asc">Ưu tiên ↑</option>
                            <option value="oldest">Cũ nhất trước</option>
                            <option value="newest">Mới nhất trước</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Priority min</label>
                        <input type="number" class="form-control form-control-sm" id="crMinP" placeholder="—" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Priority max</label>
                        <input type="number" class="form-control form-control-sm" id="crMaxP" placeholder="—" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Tạo từ (UTC)</label>
                        <input type="datetime-local" class="form-control form-control-sm" id="crFrom" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Tạo đến (UTC)</label>
                        <input type="datetime-local" class="form-control form-control-sm" id="crTo" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Trang</label>
                        <input type="number" min="1" class="form-control form-control-sm" id="crPage" value="1" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary btn-sm w-100" id="crApply"><i class="bi bi-search"></i> Lọc</button>
                    </div>
                    <div class="col-12 mt-2 pt-2 border-top">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="crFlaggedOnly" />
                            <label class="form-check-label small" for="crFlaggedOnly">Chỉ hiển thị truyện đang <strong>gắn cờ</strong> theo dõi (cần thêm thời gian xử lý)</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="crError" class="alert alert-danger py-2" style="display:none;"></div>
        <div id="crTableHost" class="table-responsive cr-table-wrap">
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong><i class="bi bi-flag"></i> Báo cáo bình luận (comment reports)</strong>
                    <div class="small text-muted">COMPLIANCE có thể RESOLVED (ẩn comment) / DISMISSED, và gửi BAN_USER lên admin.</div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="crCommentRefreshBtn" title="Tải lại danh sách">
                    <i class="bi bi-arrow-clockwise"></i> Làm mới
                </button>
            </div>
            <div id="crCommentError" class="alert alert-danger py-2" style="display:none;"></div>
            <div id="crCommentTableHost" class="table-responsive cr-table-wrap">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            </div>
        </div>
    </div>

    <div id="crPanelHistory" style="display:none;">
        <div class="card cr-filters mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small mb-0">Tìm (tiêu đề / slug / lý do / id)</label>
                        <input type="text" class="form-control form-control-sm" id="crHistSearch" placeholder="Tùy chọn" autocomplete="off" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Trang</label>
                        <input type="number" min="1" class="form-control form-control-sm" id="crHistPage" value="1" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary btn-sm w-100" id="crHistApply"><i class="bi bi-search"></i> Tải lịch sử</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="crHistError" class="alert alert-danger py-2" style="display:none;"></div>
        <div id="crHistHost" class="table-responsive cr-table-wrap">
            <div class="text-center py-4 text-muted small">Chọn tab và bấm Tải lịch sử.</div>
        </div>
    </div>

    <div class="modal fade" id="crModalLockRelease" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-send me-1"></i>Gửi yêu cầu admin — gỡ lock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Mức ưu tiên trên admin được hệ thống gán <strong>tự động</strong> (đơn gỡ lock = cao).</p>
                    <label class="form-label small">Nội dung (tùy chọn)</label>
                    <textarea class="form-control" id="crLockReleaseMsg" rows="3" placeholder="Lý do cần admin gỡ lock / hỗ trợ…"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="crLockReleaseSubmit"><i class="bi bi-send"></i> Gửi</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="crModalFlag" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-bookmark-flag me-1"></i>Gắn / bỏ cờ theo dõi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="crFlagChecked" />
                        <label class="form-check-label" for="crFlagChecked">Đang gắn cờ theo dõi</label>
                    </div>
                    <label class="form-label small">Ghi chú (khi gắn cờ)</label>
                    <textarea class="form-control" id="crFlagNote" rows="2" placeholder="Ví dụ: chờ pháp lý, cần thêm bằng chứng…"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="crFlagSubmit">Lưu</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="crModalAdminAction" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-slash me-1"></i>Yêu cầu admin — tài khoản tác giả</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Mức ưu tiên gửi admin: <strong>tự động</strong> — ban tài khoản = nghiêm trọng; tạm khóa viết = cao.</p>
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#crActBan" type="button">Ban user</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#crActSuspend" type="button">Tạm khóa viết</button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="crActBan">
                            <p class="small text-muted">Admin sẽ duyệt và thực hiện ban tài khoản.</p>
                            <label class="form-label small">Lý do / chi tiết</label>
                            <textarea class="form-control" id="crBanMsg" rows="3"></textarea>
                        </div>
                        <div class="tab-pane fade" id="crActSuspend">
                            <p class="small text-muted">Đến thời điểm này tác giả không tạo truyện/chương mới (UTC trên server — chọn theo giờ máy bạn, hệ thống gửi ISO UTC).</p>
                            <label class="form-label small">Khóa đến (local)</label>
                            <input type="datetime-local" class="form-control mb-2" id="crSuspendUntilLocal" />
                            <label class="form-label small">Ghi chú</label>
                            <textarea class="form-control" id="crSuspendMsg" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-danger" id="crAdminActionSubmit">Gửi yêu cầu</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="crModalViolations" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clock-history me-1"></i>Lịch sử vi phạm (violation_logs)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="crViolationsBody"><div class="text-muted small">Đang tải…</div></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="crModalCommentReportDetail" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-people me-1"></i>Chi tiết report comment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="crCommentReportDetailBody">
                    <div class="text-muted small">Đang tải…</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="srModalStoryReportDetail" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-journal-text me-1"></i>Chi tiết report story</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="srStoryReportDetailBody">
                    <div class="text-muted small">Đang tải…</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let crPageSize = 20;
        let crCtx = { storyId: '', authorId: null, complianceFlagged: false, commentId: null, isCommentReport: false };
        let crViewMode = 'active';
        let crCommentPageSize = 50;

        function crApplyStatusFilterForRole() {
            const sel = document.getElementById('crStatuses');
            if (!sel) return;
            const adm = AuthHelper.isAdmin();
            ['ALL', 'RESOLVED', 'DISMISSED', 'NEW,IN_REVIEW,RESOLVED,DISMISSED'].forEach(function (val) {
                const opt = Array.from(sel.options).find(function (o) { return o.value === val; });
                if (opt) opt.hidden = !adm;
            });
            if (!adm && ['ALL', 'RESOLVED', 'DISMISSED', 'NEW,IN_REVIEW,RESOLVED,DISMISSED'].indexOf(sel.value) >= 0) {
                sel.value = '';
            }
        }

        function crEffectiveStatusFilterValue() {
            const sel = document.getElementById('crStatuses');
            const st = sel ? sel.value : '';
            if (AuthHelper.isAdmin()) return st;
            if (st === 'NEW' || st === 'IN_REVIEW') return st;
            return '';
        }

        function crSwitchView(mode) {
            crViewMode = mode;
            const pa = document.getElementById('crPanelActive');
            const ph = document.getElementById('crPanelHistory');
            const ha = document.getElementById('crHelpActive');
            const hh = document.getElementById('crHelpHistory');
            const t1 = document.getElementById('crTabActive');
            const t2 = document.getElementById('crTabHistory');
            if (mode === 'history') {
                if (pa) pa.style.display = 'none';
                if (ph) ph.style.display = '';
                if (ha) ha.style.display = 'none';
                if (hh) hh.style.display = '';
                if (t1) { t1.classList.remove('active'); t1.setAttribute('aria-selected', 'false'); }
                if (t2) { t2.classList.add('active'); t2.setAttribute('aria-selected', 'true'); }
            } else {
                if (pa) pa.style.display = '';
                if (ph) ph.style.display = 'none';
                if (ha) ha.style.display = '';
                if (hh) hh.style.display = 'none';
                if (t1) { t1.classList.add('active'); t1.setAttribute('aria-selected', 'true'); }
                if (t2) { t2.classList.remove('active'); t2.setAttribute('aria-selected', 'false'); }
            }
        }

        async function crLoadHistory() {
            const host = document.getElementById('crHistHost');
            const err = document.getElementById('crHistError');
            if (!host) return;
            if (err) err.style.display = 'none';
            host.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            const page = parseInt(document.getElementById('crHistPage').value, 10) || 1;
            const search = document.getElementById('crHistSearch').value.trim() || null;
            try {
                const data = await ApiService.complianceGetMyResolvedHistory({ page: page, pageSize: crPageSize, search: search });
                const total = data.totalCount != null ? data.totalCount : data.TotalCount;
                const rows = data.rows || data.Rows || [];
                let html = '<table class="table table-sm table-hover align-middle"><thead class="table-light"><tr>' +
                    '<th>Id</th><th>Truyện</th><th>Lý do</th><th>Trạng thái</th><th>Tạo</th><th>Đóng lúc</th></tr></thead><tbody>';
                if (!rows.length) {
                    html += '<tr><td colspan="6" class="text-muted text-center py-4">Chưa có bản ghi.</td></tr>';
                } else {
                    rows.forEach(function (x) {
                        const rid = x.reportId || x.ReportId;
                        const stitle = x.storyTitle || x.StoryTitle || '';
                        const sid = x.storyId || x.StoryId;
                        const reason = x.reasonCode || x.ReasonCode || '';
                        const reasonLabel = x.reasonLabelVi || x.ReasonLabelVi || reason;
                        const reportersArr = x.reporterDisplayNames || x.ReporterDisplayNames || [];
                        const reportersText = reportersArr && reportersArr.length
                            ? reportersArr.map(n => crEscapeHtml(String(n))).join(', ')
                            : '';
                        const reasonSummaryArr = x.reasonSummaryVi || x.ReasonSummaryVi || [];
                        const reasonSummaryText = reasonSummaryArr && reasonSummaryArr.length
                            ? reasonSummaryArr.map(s => crEscapeHtml(String(s))).join('<br/>')
                            : '';
                        const st = x.status || x.Status || '';
                        const ca = x.createdAtUtc || x.CreatedAtUtc;
                        const ra = x.resolvedAtUtc || x.ResolvedAtUtc;
                        html += '<tr><td class="small text-break">' + crEscapeHtml(String(rid)) + '</td>' +
                            '<td><a href="/Home/Story/' + encodeURIComponent(sid) + '" target="_blank" rel="noopener">' + crEscapeHtml(stitle) + '</a></td>' +
                            '<td class="small">' + crEscapeHtml(String(reason)) + '</td>' +
                            '<td class="small">' + crEscapeHtml(String(st)) + '</td>' +
                            '<td class="small">' + crEscapeHtml(ca ? Utils.formatDateUtc(ca) : '—') + '</td>' +
                            '<td class="small">' + crEscapeHtml(ra ? Utils.formatDateUtc(ra) : '—') + '</td></tr>';
                    });
                }
                html += '</tbody></table>';
                html += '<div class="small text-muted mt-2">Tổng: ' + total + '</div>';
                host.innerHTML = html;
            } catch (e) {
                if (err) {
                    err.textContent = e.message || String(e);
                    err.style.display = 'block';
                }
                host.innerHTML = '';
            }
        }

        function crEscapeHtml(t) {
            if (t == null) return '';
            const d = document.createElement('div');
            d.textContent = t;
            return d.innerHTML;
        }

        function crFormatContributors(arr) {
            arr = arr || [];
            if (!arr.length) return '<span class="text-muted">—</span>';
            const parts = [];
            for (let i = 0; i < arr.length; i++) {
                const c = arr[i];
                const em = c.userEmail != null ? c.userEmail : (c.UserEmail != null ? c.UserEmail : '—');
                const code = c.reasonCode || c.ReasonCode || '';
                const lab = c.reasonLabelVi || c.ReasonLabelVi || code;
                const at = c.reportedAtUtc != null ? c.reportedAtUtc : c.ReportedAtUtc;
                const note = c.detailNote || c.DetailNote || '';
                const desc = c.description || c.Description || '';
                let inner = crEscapeHtml(String(em)) + ' — <strong>' + crEscapeHtml(String(lab)) + '</strong> <span class="text-muted">(' + crEscapeHtml(String(code)) + ')</span>';
                if (at) inner += '<div class="text-muted">' + crEscapeHtml(Utils.formatDate(at)) + '</div>';
                if (desc) {
                    const d = String(desc);
                    inner += '<div class="text-muted">' + crEscapeHtml(d.length > 160 ? d.slice(0, 160) + '…' : d) + '</div>';
                }
                if (note) inner += '<div class="text-warning small mt-1">' + crEscapeHtml(String(note)) + '</div>';
                parts.push('<div class="mb-2 border-bottom border-light pb-1">' + inner + '</div>');
            }
            return '<div class="cr-contrib-list" style="max-width:28rem">' + parts.join('') + '</div>';
        }

        function crFormatComplianceLockSla(x) {
            const locked = x.isComplianceLocked === true || x.IsComplianceLocked === true;
            const lockName = x.complianceClaimedByDisplayName || x.ComplianceClaimedByDisplayName || '';
            const cat = x.complianceClaimedAtUtc || x.ComplianceClaimedAtUtc;
            const st = (x.complianceHandlingSlaStatus || x.ComplianceHandlingSlaStatus || '').toUpperCase();
            const msg = x.complianceHandlingSlaMessageVi || x.ComplianceHandlingSlaMessageVi || '';
            const hrs = x.hoursSinceComplianceClaim != null ? x.hoursSinceComplianceClaim : x.HoursSinceComplianceClaim;
            if (!locked) {
                return '<span class="text-muted">—</span>';
            }
            let tierBadge = '<span class="badge bg-secondary">Đang lock</span>';
            if (st === 'OK') tierBadge = '<span class="badge bg-success">Đang lock</span>';
            else if (st === 'NOTICE') tierBadge = '<span class="badge bg-info">Đang lock</span>';
            else if (st === 'WARNING') tierBadge = '<span class="badge bg-warning text-dark">Đang lock</span>';
            else if (st === 'SEVERE') tierBadge = '<span class="badge text-white" style="background-color:#e8590c;">Đang lock</span>';
            else if (st === 'CRITICAL') tierBadge = '<span class="badge bg-dark">Đang lock</span>';

            let html = tierBadge + '<div class="small">' + crEscapeHtml(lockName) + '</div>';
            if (cat) {
                html += '<div class="small mt-1"><strong>Nhận lock (UTC):</strong> ' + crEscapeHtml(Utils.formatDateUtc(cat)) + '</div>';
            }
            if (hrs != null && !Number.isNaN(Number(hrs))) {
                html += '<div class="small text-muted">' + crEscapeHtml(Number(hrs).toFixed(1)) + ' h từ lúc nhận</div>';
            }
            if (msg && st !== 'OK') {
                let mCls = 'bg-info';
                if (st === 'NOTICE') mCls = 'bg-info';
                else if (st === 'WARNING') mCls = 'bg-warning text-dark';
                else if (st === 'SEVERE') mCls = 'text-white';
                else if (st === 'CRITICAL') mCls = 'bg-danger';
                const sevStyle = st === 'SEVERE' ? ' style="background-color:#e8590c;"' : '';
                html += '<div class="mt-1"><span class="badge ' + mCls + '"' + sevStyle + '>' + crEscapeHtml(msg) + '</span></div>';
            }
            return html;
        }

        function crToIsoUtcFromLocal(dtLocalVal) {
            if (!dtLocalVal) return '';
            return Utils.datetimeLocalToIsoUtc(dtLocalVal) || '';
        }

        async function crLoadReasons() {
            const sel = document.getElementById('crReason');
            try {
                const list = await ApiService.getStoryReportReasons();
                (list || []).forEach(function (r) {
                    const o = document.createElement('option');
                    o.value = r.code || r.Code;
                    const vi = r.labelVi || r.LabelVi || '';
                    const sc = r.severityScore != null ? r.severityScore : r.SeverityScore;
                    o.textContent = (vi || r.label || r.Label || o.value) + ' (' + sc + ')';
                    sel.appendChild(o);
                });
            } catch (e) { console.warn(e); }
        }

        function crQueryPayload() {
            const groupByStory = document.getElementById('crGroupBy').value === 'true';
            const st = crEffectiveStatusFilterValue();
            const q = {
                groupByStory: groupByStory,
                page: parseInt(document.getElementById('crPage').value, 10) || 1,
                pageSize: crPageSize,
                sortBy: document.getElementById('crSort').value,
                search: document.getElementById('crSearch').value.trim() || null,
                reasonCode: document.getElementById('crReason').value || null
            };
            if (st === 'ALL') q.statuses = 'ALL';
            else if (st) q.statuses = st;

            const sid = document.getElementById('crStoryId').value.trim();
            if (sid) q.storyId = sid;

            const minP = document.getElementById('crMinP').value.trim();
            const maxP = document.getElementById('crMaxP').value.trim();
            if (minP !== '') q.minPriority = parseInt(minP, 10);
            if (maxP !== '') q.maxPriority = parseInt(maxP, 10);

            const from = crToIsoUtcFromLocal(document.getElementById('crFrom').value);
            const to = crToIsoUtcFromLocal(document.getElementById('crTo').value);
            if (from) q.createdFromUtc = from;
            if (to) q.createdToUtc = to;

            const cf = (document.getElementById('crClaimFilter') || {}).value;
            if (cf && cf !== 'all') q.claimFilter = cf;

            if (document.getElementById('crFlaggedOnly') && document.getElementById('crFlaggedOnly').checked)
                q.flaggedOnly = true;

            return q;
        }

        function crStoryBadgesHtml(x) {
            const flagged = x.complianceFlagged === true || x.ComplianceFlagged === true;
            const hid = x.complianceHidden === true || x.ComplianceHidden === true;
            const cmt = x.commentsDisabled === true || x.CommentsDisabled === true;
            const parts = [];
            if (flagged) parts.push('<span class="badge bg-warning text-dark">Cờ</span>');
            if (hid) parts.push('<span class="badge bg-secondary">Ẩn</span>');
            if (cmt) parts.push('<span class="badge bg-dark">Tắt BL</span>');
            if (!parts.length) return '<span class="text-muted small">—</span>';
            return '<div class="cr-story-badges d-flex flex-wrap gap-1">' + parts.join('') + '</div>';
        }

        async function crLoadCommentReports() {
            const host = document.getElementById('crCommentTableHost');
            const err = document.getElementById('crCommentError');
            if (!host) return;
            if (err) {
                err.style.display = 'none';
            }
            const isAdm = AuthHelper.isAdmin();
            host.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            try {
                const data = await ApiService.complianceGetCommentReports({ page: 1, pageSize: crCommentPageSize, status: 'NEW,IN_REVIEW' });
                const total = data.totalCount != null ? data.totalCount : data.TotalCount;
                const rows = data.rows || data.Rows || [];

                let html = '<table class="table table-sm table-hover align-middle"><thead class="table-light"><tr>' +
                    '<th>Ưu tiên</th><th>Sev</th><th>#BC</th><th>TW</th><th>Truyện</th><th>Bình luận</th><th>Lý do</th><th>Trạng thái</th><th>Tạo</th><th>Lock</th><th class="text-end">Thao tác</th>' +
                    '</tr></thead><tbody>';

                // Used by click handler to display full reasons + full reporters.
                // Must be declared at function scope (not inside else-branch), otherwise click may throw ReferenceError.
                const commentDetailByCid = {};

                if (!rows.length) {
                    html += '<tr><td colspan="11" class="text-muted text-center py-4">Không có comment report mở.</td></tr>';
                } else {
                    const shownClaimByComment = new Set();
                    const shownReleaseByComment = new Set();
                    const shownResolveAllByComment = new Set();
                    rows.forEach(function (x) {
                        const rid = x.reportId || x.ReportId;
                        const cid = x.commentId || x.CommentId;
                        const sid = x.storyId || x.StoryId;
                        const stitle = x.storyTitle || x.StoryTitle || '';
                        const reason = x.reasonCode || x.ReasonCode || '';
                        const sev = x.severityScore != null ? x.severityScore : x.SeverityScore;
                        const sevFmt = (typeof sev === 'number' && !Number.isNaN(sev)) ? sev.toFixed(1) : String(sev);
                        const status = x.status || x.Status || '';
                        const ca = x.createdAtUtc || x.CreatedAtUtc;

                        const uName = x.commentUserDisplayName || x.CommentUserDisplayName || '';
                        const uEmail = x.commentUserEmail || x.CommentUserEmail || '';
                        const reporterEmail = x.reporterEmail || x.ReporterEmail || '';
                        const cmtCell = (uName ? crEscapeHtml(String(uName)) : '') +
                            (uEmail ? ' <span class="text-muted">(' + crEscapeHtml(String(uEmail)) + ')</span>' : '');
                        const banTitle = 'Ban user bị report (gửi admin).';
                        const warnText = x.adminOrModeratorReplyWarningVi || x.AdminOrModeratorReplyWarningVi || null;

                        const locked = x.isComplianceLocked === true || x.IsComplianceLocked === true;
                        const mine = x.isComplianceClaimedByMe === true || x.IsComplianceClaimedByMe === true;
                        const hasPendingAdmin = x.hasPendingAdminActionRequest === true || x.HasPendingAdminActionRequest === true;
                        const stUp = (status || '').toUpperCase();
                        const isOpenTicket = stUp === 'NEW' || stUp === 'IN_REVIEW';

                        const lockCell = crFormatComplianceLockSla(x);

                        // Compact summary but full details shown on click.
                        const reasonSummaryArr = x.reasonSummaryVi || x.ReasonSummaryVi || [];
                        const topReasons = reasonSummaryArr.slice(0, 2);
                        const moreReasonsCount = reasonSummaryArr.length - topReasons.length;
                        const reasonsBadgesHtml = topReasons.length
                            ? '<div class="d-flex flex-wrap gap-1 mb-1">' + topReasons.map(s =>
                                '<span class="badge bg-light text-dark border">' + crEscapeHtml(String(s)) + '</span>').join('') + '</div>'
                            : '';
                        const moreReasonsHtml = moreReasonsCount > 0
                            ? '<div class="small text-muted">+' + crEscapeHtml(String(moreReasonsCount)) + ' lý do khác</div>'
                            : '';

                        const reportersArr = x.reporterDisplayNames || x.ReporterDisplayNames || [];
                        const topReporters = reportersArr.slice(0, 2);
                        const moreReportersCount = reportersArr.length - topReporters.length;
                        const reportersCompactHtml = topReporters.length
                            ? '<div class="small mt-1"><span class="text-muted">Người báo:</span> ' + topReporters.map(n => crEscapeHtml(String(n))).join(', ') +
                              (moreReportersCount > 0 ? ' +' + crEscapeHtml(String(moreReportersCount)) : '') + '</div>'
                            : '';

                        const detailBtnHtml = (reasonSummaryArr.length > 0 || reportersArr.length > 0)
                            ? '<button type="button" class="btn btn-link btn-sm p-0" data-cr-open-comment-detail data-cid="' + crEscapeHtml(String(cid)) + '">Xem tất cả</button>'
                            : '';

                        const reporterDetailsRaw = x.reporterDetails || x.ReporterDetails || [];
                        commentDetailByCid[cid] = {
                            reasonSummaryArr: reasonSummaryArr,
                            reportersArr: reportersArr,
                            reporterDetails: reporterDetailsRaw,
                            commentId: String(cid),
                            canVerifyEvidence: !hasPendingAdmin && (isAdm || (locked && mine)),
                            warnText: warnText
                        };

                        let claimBtn = '';
                        // Giống report story: Claim lock chỉ phụ thuộc lock/role, không phụ thuộc isOpenTicket của representative status.
                        if (!locked && !isAdm && !shownClaimByComment.has(cid) && !hasPendingAdmin) {
                            claimBtn = '<button type="button" class="btn btn-outline-primary btn-sm" data-cr-claim-comment data-cid="' + crEscapeHtml(String(cid)) + '" title="Nhận lock để xử lý ticket này"><i class="bi bi-lock"></i> Nhận</button>';
                            shownClaimByComment.add(cid);
                        }

                        let releaseBtn = '';
                        if (locked && isAdm && !shownReleaseByComment.has(cid) && !hasPendingAdmin) {
                            releaseBtn = '<button type="button" class="btn btn-outline-warning btn-sm" data-cr-release-comment data-cid="' + crEscapeHtml(String(cid)) + '" title="Admin: gỡ lock comment reports"><i class="bi bi-unlock"></i> Gỡ lock</button>';
                            shownReleaseByComment.add(cid);
                        }

                        // Resolve select (RESOLVED hides comment; choose parent-only vs include replies).
                        const canResolve = isAdm || mine;
                        const resolveCell = canResolve
                            ? (hasPendingAdmin
                                ? '<span class="text-muted small">Đang chờ admin…</span>'
                                : '<select class="form-select form-select-sm cr-comment-resolve-sel" data-rid="' + crEscapeHtml(String(rid)) + '" data-cid="' + crEscapeHtml(String(cid)) + '">' +
                                    '<option value="">Đánh dấu…</option>' +
                                    '<option value="RESOLVED_ALL">RESOLVED (ẩn toàn bộ reply)</option>' +
                                    '<option value="RESOLVED_PARENT">RESOLVED (ẩn cha)</option>' +
                                    '<option value="DISMISSED">DISMISSED (không ẩn)</option>' +
                                    '</select>')
                            : '<span class="text-muted small">—</span>';

                        // Giống report story: sau khi compliance đổi trạng thái, vẫn giữ các "thao tác"
                        // (ban user, bulk close, ...), chỉ dựa vào lock/claim thay vì dựa vào isOpenTicket của
                        // representative status.
                        const banBtn = (!isAdm && locked && mine && !hasPendingAdmin)
                            ? '<button type="button" class="btn btn-outline-danger btn-sm" data-cr-open-admin-act-comment data-rid="' + crEscapeHtml(String(rid)) + '" data-cid="' + crEscapeHtml(String(cid)) + '" title="' + crEscapeHtml(banTitle) + '"><i class="bi bi-person-slash"></i></button>'
                            : '';

                        let actionCell = '<div class="d-inline-flex flex-column align-items-end gap-1">';
                        if (claimBtn) actionCell += claimBtn;
                        if (releaseBtn) actionCell += releaseBtn;
                        if (banBtn) actionCell += banBtn;
                        actionCell += resolveCell;

                        // Bulk close comment thread (giống report story) - do COMPLIANCE tự bấm.
                        if (!isAdm && locked && mine && !hasPendingAdmin && !shownResolveAllByComment.has(cid)) {
                            actionCell +=
                                '<div class="d-flex flex-wrap gap-1 mt-2 justify-content-end">' +
                                '<button type="button" class="btn btn-success btn-sm" data-cr-resolve-all-comment data-cid="' + crEscapeHtml(String(cid)) + '" title="Đóng hết ticket comment thread này (RESOLVED, ẩn toàn bộ reply)">Xong hết ticket</button>' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-dismiss-all-comment data-cid="' + crEscapeHtml(String(cid)) + '" title="Bác bỏ hết ticket comment thread này (DISMISSED)">Bác bỏ hết</button>' +
                                '</div>';
                            shownResolveAllByComment.add(cid);
                        }
                        actionCell += '</div>';

                        const pri = x.priorityScore != null ? x.priorityScore : x.PriorityScore;
                        const rcnt = x.reportCount != null ? x.reportCount : x.ReportCount;
                        const tw = x.timeWeight != null ? x.timeWeight : x.TimeWeight;
                        const priFmt = (typeof pri === 'number' && !Number.isNaN(pri)) ? pri.toFixed(1) : String(pri);
                        html += '<tr>' +
                            '<td class="small text-break">' + crEscapeHtml(priFmt) + '</td>' +
                            '<td class="small">' + crEscapeHtml(sevFmt) + '</td>' +
                            '<td class="small">' + crEscapeHtml(String(rcnt)) + '</td>' +
                            '<td class="small">' + crEscapeHtml(String(tw)) + '</td>' +
                            '<td><a href="/Home/Story/' + encodeURIComponent(sid) + '" target="_blank" rel="noopener">' + crEscapeHtml(stitle) + '</a></td>' +
                            '<td class="small">' + cmtCell + '</td>' +
                            '<td class="small">' +
                                reasonsBadgesHtml +
                                moreReasonsHtml +
                                (warnText ? '<div class="text-warning small mt-1">' + crEscapeHtml(String(warnText)) + '</div>' : '') +
                                reportersCompactHtml +
                                detailBtnHtml +
                            '</td>' +
                            '<td class="small">' + crEscapeHtml(status) + '</td>' +
                            '<td class="small">' + crEscapeHtml(ca ? Utils.formatDateUtc(ca) : '—') + '</td>' +
                            '<td class="small">' + lockCell + '</td>' +
                            '<td class="text-end">' + actionCell + '</td>' +
                            '</tr>';
                    });
                }

                html += '</tbody></table>';
                html += '<div class="small text-muted mt-2">Tổng: ' + total + '</div>';
                host.innerHTML = html;

                host.querySelectorAll('[data-cr-claim-comment]').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        const cid = btn.getAttribute('data-cid');
                        try {
                            const r = await ApiService.complianceClaimCommentReports(cid);
                            Utils.showAlert((r && (r.message || r.Message)) || 'Đã nhận lock.', 'success');
                            crLoadCommentReports();
                        } catch (e) {
                            Utils.showAlert(e.message || e, 'danger');
                        }
                    });
                });

                host.querySelectorAll('[data-cr-release-comment]').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        const cid = btn.getAttribute('data-cid');
                        if (!confirm('ADMIN: Gỡ lock comment reports?')) return;
                        try {
                            const r = await ApiService.adminReleaseComplianceCommentClaim(cid);
                            Utils.showAlert((r && (r.message || r.Message)) || 'Đã gỡ lock.', 'success');
                            crLoadCommentReports();
                        } catch (e) {
                            Utils.showAlert(e.message || e, 'danger');
                        }
                    });
                });

                host.querySelectorAll('[data-cr-resolve-all-comment]').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        const cid = btn.getAttribute('data-cid');
                        if (!confirm('Đóng hết ticket comment thread này? (RESOLVED, ẩn toàn bộ reply)')) return;
                        try {
                            await ApiService.complianceResolveAllOpenCommentReports(cid, { status: 'RESOLVED', HideComment: true, IncludeReplies: true });
                            Utils.showAlert('Đã đóng hết ticket comment.', 'success');
                            crLoadCommentReports();
                        } catch (e) {
                            Utils.showAlert(e.message || e, 'danger');
                        }
                    });
                });

                host.querySelectorAll('[data-cr-dismiss-all-comment]').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        const cid = btn.getAttribute('data-cid');
                        if (!confirm('Bác bỏ hết ticket comment thread này? (DISMISSED)')) return;
                        try {
                            await ApiService.complianceResolveAllOpenCommentReports(cid, { status: 'DISMISSED', HideComment: false, IncludeReplies: true });
                            Utils.showAlert('Đã bác bỏ hết ticket comment.', 'success');
                            crLoadCommentReports();
                        } catch (e) {
                            Utils.showAlert(e.message || e, 'danger');
                        }
                    });
                });

                // Comment report detail modal: show all reasons + all reporters.
                host.querySelectorAll('[data-cr-open-comment-detail]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        const cid = btn.getAttribute('data-cid');
                        const det = commentDetailByCid[cid];
                        const body = document.getElementById('crCommentReportDetailBody');
                        if (!body) return;
                        if (!det) {
                            body.innerHTML = '<div class="text-muted small">Không có dữ liệu.</div>';
                            new bootstrap.Modal(document.getElementById('crModalCommentReportDetail')).show();
                            return;
                        }

                        const reasonListHtml = det.reasonSummaryArr && det.reasonSummaryArr.length
                            ? '' : '<div class="text-muted small mb-3">—</div>';

                        const reasonItems = (det.reasonSummaryArr || []).map(function (raw) {
                            const txt = String(raw ?? '');
                            // Backend format: "Label (count)".
                            const m = txt.match(/^(.*)\((\d+)\)\s*$/);
                            if (m) {
                                return { label: m[1].trim(), count: parseInt(m[2], 10) };
                            }
                            return { label: txt.trim(), count: 1 };
                        });

                        let selectedReasonLabel = null;
                        let verifyFilter = 'all';

                        function crRowVerified(row) {
                            return row.isComplianceEvidenceVerified === true || row.IsComplianceEvidenceVerified === true;
                        }
                        function crRowReason(row) {
                            return String(row.reasonLabelVi || row.ReasonLabelVi || '').trim();
                        }
                        function crFilterReporterRows(list) {
                            return list.filter(function (row) {
                                const r = crRowReason(row);
                                if (selectedReasonLabel && r !== selectedReasonLabel) return false;
                                const v = crRowVerified(row);
                                if (verifyFilter === 'verified' && !v) return false;
                                if (verifyFilter === 'unverified' && v) return false;
                                return true;
                            });
                        }

                        function renderReasons(reasonGt) {
                            const list = (reasonItems || []).filter(function (x) {
                                const c = x.count || 0;
                                if (reasonGt < 0) return true;
                                return c > reasonGt;
                            });
                            if (!list.length)
                                return '<div class="text-muted small mb-3">Không có lý do phù hợp.</div>';
                            return '<div class="d-flex flex-wrap gap-1 mb-3">' +
                                list.map(function (x) {
                                    const enc = encodeURIComponent(x.label);
                                    const active = selectedReasonLabel && selectedReasonLabel === x.label;
                                    const cls = active
                                        ? 'badge bg-primary text-white border border-primary cr-reason-badge-filter'
                                        : 'badge bg-light text-dark border cr-reason-badge-filter';
                                    return '<button type="button" class="' + cls + ' rounded-pill" data-cr-reason-lbl="' + enc + '" title="Lọc bảng theo lý do (bấm lại để bỏ lọc)">' +
                                        crEscapeHtml(String(x.label)) + ' (' + crEscapeHtml(String(x.count)) + ')' +
                                        '</button>';
                                }).join('') +
                                '</div>';
                        }

                        let reasonGt = -1;
                        const reasonsBlockHtml = (reasonItems && reasonItems.length)
                            ? (
                                '<div class="small text-muted mb-2">Bấm từng lý do để lọc bảng chi tiết (bấm lại để bỏ lọc).</div>' +
                                '<div class="small text-muted mb-2">Lọc theo số lượng báo cáo: chỉ hiện lý do có tổng số báo <strong>lớn hơn</strong> ngưỡng đã chọn.</div>' +
                                '<div class="mb-2 d-flex flex-wrap gap-1 align-items-center">' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-reason-gt="-1">Tất cả</button>' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-reason-gt="10">Lớn hơn 10</button>' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-reason-gt="50">Lớn hơn 50</button>' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-reason-gt="100">Lớn hơn 100</button>' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-reason-gt="1000">Lớn hơn 1000</button>' +
                                '</div>' +
                                '<div id="crCommentReasonFilterList">' + renderReasons(reasonGt) + '</div>'
                              )
                            : '<div class="text-muted small mb-3">—</div>';

                        const rdList = det.reporterDetails || [];
                        let crSyncReporterDetailTable = function () {};
                        let reportersBlockHtml;
                        if (rdList.length) {
                            const verifiedTotal = rdList.filter(crRowVerified).length;
                            const headChk = det.canVerifyEvidence ? '<th style="width:2.5rem" title="Chọn để lưu xác minh">✓</th>' : '';
                            const colCount = det.canVerifyEvidence ? 7 : 6;

                            function crBuildReporterRowsHtml(rows) {
                                if (!rows.length) {
                                    return '<tr><td colspan="' + colCount + '" class="text-muted small text-center py-3">Không có request phù hợp bộ lọc.</td></tr>';
                                }
                                return rows.map(function (row) {
                                    const eid = row.evidenceId || row.EvidenceId;
                                    const rname = row.reporterDisplayName || row.ReporterDisplayName || '—';
                                    const reason = row.reasonLabelVi || row.ReasonLabelVi || '—';
                                    const desc = row.description || row.Description || '';
                                    const rid = row.reportId || row.ReportId;
                                    const ra = row.reportedAtUtc || row.ReportedAtUtc;
                                    const verified = crRowVerified(row);
                                    const chk = det.canVerifyEvidence
                                        ? '<input type="checkbox" class="form-check-input cr-evidence-verify-chk" data-evidence-id="' + crEscapeHtml(String(eid)) + '" data-was-verified="' + (verified ? '1' : '0') + '" id="cr-ev-' + crEscapeHtml(String(eid)) + '"' + (verified ? ' checked' : '') + ' />'
                                        : '';
                                    const chkCell = det.canVerifyEvidence
                                        ? '<td class="align-middle text-center">' + chk + '</td>'
                                        : '';
                                    return '<tr>' + chkCell +
                                        '<td class="small">' + crEscapeHtml(String(rname)) + '</td>' +
                                        '<td class="small">' + crEscapeHtml(String(reason)) + '</td>' +
                                        '<td class="small text-nowrap">' + (ra ? crEscapeHtml(Utils.formatDateUtc(ra)) : '<span class="text-muted">—</span>') + '</td>' +
                                        '<td class="small text-break">' + (desc ? crEscapeHtml(String(desc)) : '<span class="text-muted">—</span>') + '</td>' +
                                        '<td class="small font-monospace text-muted">' + crEscapeHtml(String(rid).slice(0, 8)) + '…</td>' +
                                        '<td class="small">' + (verified ? '<span class="badge bg-success">Đã xác minh</span>' : '<span class="text-muted">Chưa xác minh</span>') + '</td>' +
                                        '</tr>';
                                }).join('');
                            }

                            crSyncReporterDetailTable = function () {
                                const tbody = document.getElementById('crCommentReporterTbody');
                                const hintEl = document.getElementById('crDetailFilteredHint');
                                if (!tbody) return;
                                const filtered = crFilterReporterRows(rdList);
                                if (hintEl) {
                                    const hasExtra = selectedReasonLabel || verifyFilter !== 'all';
                                    hintEl.textContent = hasExtra
                                        ? 'Đang hiển thị ' + filtered.length + ' / ' + rdList.length + ' request'
                                        : '';
                                }
                                tbody.innerHTML = crBuildReporterRowsHtml(filtered);
                            };

                            reportersBlockHtml =
                                '<div id="crDetailReporterMeta" class="mb-2 d-flex flex-wrap gap-2 align-items-center">' +
                                '<span class="small"><strong>Tổng request:</strong> ' + rdList.length + '</span>' +
                                '<span class="small text-muted">|</span>' +
                                '<span class="small text-success"><strong>Đã xác minh:</strong> ' + verifiedTotal + '</span>' +
                                '<span class="small text-muted">|</span>' +
                                '<span class="small"><strong>Chưa xác minh:</strong> ' + (rdList.length - verifiedTotal) + '</span>' +
                                '<span class="small text-primary ms-1" id="crDetailFilteredHint"></span>' +
                                '</div>' +
                                '<div class="d-flex flex-wrap gap-1 align-items-center mb-2">' +
                                '<span class="small text-muted me-1">Lọc trạng thái xác minh:</span>' +
                                '<button type="button" class="btn btn-sm btn-outline-secondary cr-detail-vf active" data-vf="all">Tất cả</button>' +
                                '<button type="button" class="btn btn-sm btn-outline-secondary cr-detail-vf" data-vf="unverified">Chưa xác minh</button>' +
                                '<button type="button" class="btn btn-sm btn-outline-secondary cr-detail-vf" data-vf="verified">Đã xác minh</button>' +
                                '</div>' +
                                '<div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0">' +
                                '<thead class="table-light"><tr>' + headChk +
                                '<th>Người báo cáo</th><th>Lý do</th><th>Thời gian gửi (UTC)</th><th>Mô tả</th><th>Ticket</th><th>Trạng thái xác minh</th>' +
                                '</tr></thead><tbody id="crCommentReporterTbody"></tbody></table></div>' +
                                (det.canVerifyEvidence
                                    ? '<div class="d-flex flex-wrap gap-2 align-items-center mt-2">' +
                                      '<button type="button" class="btn btn-primary btn-sm" id="crBtnSaveEvidenceVerify">Lưu đánh dấu xác minh</button>' +
                                      '<span class="small text-muted">Chọn các request đã xác minh, bấm Lưu. Bỏ chọn để gỡ đánh dấu đã lưu trước đó.</span>' +
                                      '</div>'
                                    : '<div class="small text-muted mt-2">Chỉ compliance đang lock (hoặc admin) mới chỉnh được đánh dấu xác minh.</div>');
                        } else if (det.reportersArr && det.reportersArr.length) {
                            reportersBlockHtml = '<ul class="list-group list-group-flush">' +
                              det.reportersArr.map(n =>
                                  '<li class="list-group-item small">' + crEscapeHtml(String(n)) + '</li>'
                              ).join('') +
                              '</ul>';
                        } else {
                            reportersBlockHtml = '<div class="text-muted small">—</div>';
                        }

                        body.innerHTML =
                            '<div class="mb-2"><div class="small text-muted">Tất cả lý do report + số lượng</div></div>' +
                            reasonsBlockHtml +
                            '<div class="mb-2 mt-3"><div class="small text-muted">Chi tiết từng request báo cáo (theo người report)</div></div>' +
                            reportersBlockHtml +
                            (det.warnText ? '<div class="text-warning small mt-3">' + crEscapeHtml(String(det.warnText)) + '</div>' : '');

                        crSyncReporterDetailTable();

                        body.onclick = function (ev) {
                            const t = ev.target;
                            const badge = t.closest && t.closest('.cr-reason-badge-filter');
                            if (badge && body.contains(badge)) {
                                const enc = badge.getAttribute('data-cr-reason-lbl');
                                let lbl = '';
                                try { lbl = decodeURIComponent(enc || ''); } catch (eR) { lbl = ''; }
                                lbl = String(lbl).trim();
                                selectedReasonLabel = (selectedReasonLabel === lbl) ? null : lbl;
                                const le = document.getElementById('crCommentReasonFilterList');
                                if (le) le.innerHTML = renderReasons(reasonGt);
                                crSyncReporterDetailTable();
                                return;
                            }
                            const vf = t.closest && t.closest('.cr-detail-vf');
                            if (vf && body.contains(vf)) {
                                verifyFilter = vf.getAttribute('data-vf') || 'all';
                                body.querySelectorAll('.cr-detail-vf').forEach(function (x) {
                                    x.classList.toggle('active', (x.getAttribute('data-vf') || 'all') === verifyFilter);
                                });
                                crSyncReporterDetailTable();
                            }
                        };

                        // Wire filter buttons inside modal (reason count).
                        const modalEl = document.getElementById('crModalCommentReportDetail');
                        const listEl = document.getElementById('crCommentReasonFilterList');
                        if (modalEl && listEl) {
                            modalEl.querySelectorAll('[data-cr-reason-gt]').forEach(function (b) {
                                b.addEventListener('click', function () {
                                    const mc = parseInt(b.getAttribute('data-cr-reason-gt') || '-1', 10);
                                    reasonGt = Number.isFinite(mc) ? mc : -1;
                                    const visible = (reasonItems || []).filter(function (x) {
                                        const c = x.count || 0;
                                        if (reasonGt < 0) return true;
                                        return c > reasonGt;
                                    });
                                    if (selectedReasonLabel && !visible.some(function (x) { return x.label === selectedReasonLabel; }))
                                        selectedReasonLabel = null;
                                    listEl.innerHTML = renderReasons(reasonGt);
                                    crSyncReporterDetailTable();
                                });
                            });
                        }

                        const saveEvidenceBtn = document.getElementById('crBtnSaveEvidenceVerify');
                        if (saveEvidenceBtn && det.canVerifyEvidence && det.commentId) {
                            saveEvidenceBtn.addEventListener('click', async function () {
                                const verify = [];
                                const unverify = [];
                                body.querySelectorAll('.cr-evidence-verify-chk').forEach(function (chk) {
                                    const id = chk.getAttribute('data-evidence-id');
                                    if (!id) return;
                                    const was = chk.getAttribute('data-was-verified') === '1';
                                    const now = chk.checked;
                                    if (now && !was) verify.push(id);
                                    if (!now && was) unverify.push(id);
                                });
                                if (!verify.length && !unverify.length) {
                                    Utils.showAlert('Không có thay đổi.', 'info');
                                    return;
                                }
                                try {
                                    await ApiService.complianceSetCommentReportEvidenceVerification(det.commentId, {
                                        verifyEvidenceIds: verify,
                                        unverifyEvidenceIds: unverify
                                    });
                                    Utils.showAlert('Đã lưu đánh dấu xác minh.', 'success');
                                    if (modalEl) {
                                        const inst = bootstrap.Modal.getInstance(modalEl);
                                        if (inst) inst.hide();
                                    }
                                    crLoadCommentReports();
                                } catch (e) {
                                    Utils.showAlert(e.message || e, 'danger');
                                }
                            });
                        }

                        new bootstrap.Modal(document.getElementById('crModalCommentReportDetail')).show();
                    });
                });

                host.querySelectorAll('.cr-comment-resolve-sel').forEach(function (sel) {
                    sel.addEventListener('change', async function () {
                        const v = sel.value;
                        if (!v) return;
                        const rid = sel.getAttribute('data-rid');
                        try {
                            if (v === 'DISMISSED') {
                                await ApiService.complianceResolveCommentReport(rid, { status: 'DISMISSED', HideComment: false, IncludeReplies: true });
                            } else if (v === 'RESOLVED_PARENT') {
                                await ApiService.complianceResolveCommentReport(rid, { status: 'RESOLVED', HideComment: true, IncludeReplies: false });
                            } else {
                                await ApiService.complianceResolveCommentReport(rid, { status: 'RESOLVED', HideComment: true, IncludeReplies: true });
                            }
                            Utils.showAlert('Đã cập nhật comment report.', 'success');
                            sel.value = '';
                            crLoadCommentReports();
                        } catch (e) {
                            Utils.showAlert(e.message || e, 'danger');
                            sel.value = '';
                        }
                    });
                });

                // Open admin action modal for BAN_USER (and optionally suspend) on comment author.
                host.querySelectorAll('[data-cr-open-admin-act-comment]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        const cid = btn.getAttribute('data-cid');
                        crCtx.commentId = cid || '';
                        crCtx.isCommentReport = true;
                        crCtx.storyId = ''; // not used for comment action
                        crCtx.authorId = null;
                        document.getElementById('crBanMsg').value = '';
                        document.getElementById('crSuspendMsg').value = '';
                        document.getElementById('crSuspendUntilLocal').value = '';
                        new bootstrap.Modal(document.getElementById('crModalAdminAction')).show();
                    });
                });
            } catch (e) {
                if (err) {
                    err.textContent = e.message || String(e);
                    err.style.display = 'block';
                }
                host.innerHTML = '';
            }
        }

        async function crLoad() {
            const host = document.getElementById('crTableHost');
            const err = document.getElementById('crError');
            err.style.display = 'none';
            host.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            try {
                const data = await ApiService.complianceGetStoryReports(crQueryPayload());
                const total = data.totalCount != null ? data.totalCount : data.TotalCount;
                const items = data.queueItems || data.QueueItems || [];
                const rows = data.rows || data.Rows || [];
                const grouped = (document.getElementById('crGroupBy').value === 'true');
                const isAdm = AuthHelper.isAdmin();

                if (grouped) {
                    const storyDetailBySid = {};
                    let html = '<table class="table table-sm table-hover align-middle"><thead class="table-light"><tr>' +
                        '<th>Ưu tiên</th><th>Sev</th><th>#BC</th><th>TW</th><th>Truyện</th><th>Tác giả</th><th>Vi phạm / mod</th><th>Người báo</th><th>Ticket</th><th>Lock</th><th class="text-end" style="min-width:7rem">Thao tác</th></tr></thead><tbody>';
                    if (!items.length) {
                        html += '<tr><td colspan="11" class="text-muted text-center py-4">Không có dữ liệu.</td></tr>';
                    } else {
                        items.forEach(function (x) {
                            const sid = x.storyId || x.StoryId;
                            const title = x.storyTitle || x.StoryTitle || '';
                            const pri = x.priorityScore != null ? x.priorityScore : x.PriorityScore;
                            const ms = x.maxSeverityScore != null ? x.maxSeverityScore : x.MaxSeverityScore;
                            const priFmt = (typeof pri === 'number' && !Number.isNaN(pri)) ? pri.toFixed(1) : String(pri);
                            const msFmt = (typeof ms === 'number' && !Number.isNaN(ms)) ? ms.toFixed(1) : String(ms);
                            const rc = x.reportCount != null ? x.reportCount : x.ReportCount;
                            const tw = x.timeWeight != null ? x.timeWeight : x.TimeWeight;
                            const contribs = x.contributors || x.Contributors || [];
                            const sts = (x.statusesPresent || x.StatusesPresent || []).join(', ');
                            const locked = x.isComplianceLocked === true || x.IsComplianceLocked === true;
                            const mine = x.isComplianceClaimedByMe === true || x.IsComplianceClaimedByMe === true;
                            const lockCell = crFormatComplianceLockSla(x);
                            const aid = x.authorId || x.AuthorId;
                            const aidStr = aid ? String(aid) : '';
                            const aname = x.authorDisplayName || x.AuthorDisplayName || '—';
                            const badgeCell = crStoryBadgesHtml(x);
                            const cmtOn = x.commentsDisabled === true || x.CommentsDisabled === true;
                            const hidOn = x.complianceHidden === true || x.ComplianceHidden === true;
                            const fOn = x.complianceFlagged === true || x.ComplianceFlagged === true;
                            const openIds = x.openReportIds || x.OpenReportIds || [];
                            const hasOpenTickets = openIds.length > 0;
                            const reasonCountMap = {};
                            (contribs || []).forEach(function (c) {
                                const lab = c.reasonLabelVi || c.ReasonLabelVi || c.reasonCode || c.ReasonCode || '—';
                                reasonCountMap[lab] = (reasonCountMap[lab] || 0) + 1;
                            });
                            const reasonSummaryArr = Object.keys(reasonCountMap).sort(function (a, b) { return a.localeCompare(b, 'vi'); }).map(function (k) {
                                return k + ' (' + reasonCountMap[k] + ')';
                            });
                            const reporterDetails = (contribs || []).map(function (c) {
                                return {
                                    userId: c.userId || c.UserId,
                                    reporterDisplayName: c.userEmail || c.UserEmail || '—',
                                    reasonLabelVi: c.reasonLabelVi || c.ReasonLabelVi,
                                    description: c.description || c.Description,
                                    reportedAtUtc: c.reportedAtUtc || c.ReportedAtUtc,
                                    detailNote: c.detailNote || c.DetailNote,
                                    isComplianceContributorVerified: c.isComplianceContributorVerified === true || c.IsComplianceContributorVerified === true,
                                    canMarkComplianceVerified: c.canMarkComplianceVerified !== false && c.CanMarkComplianceVerified !== false
                                };
                            });
                            storyDetailBySid[sid] = {
                                reasonSummaryArr: reasonSummaryArr,
                                reporterDetails: reporterDetails,
                                storyId: String(sid),
                                storyTitle: title,
                                canVerifyContributor: isAdm || (locked && mine)
                            };
                            const storyDetBtn = (reasonSummaryArr.length || reporterDetails.length)
                                ? '<div class="mt-1"><button type="button" class="btn btn-link btn-sm p-0" data-sr-open-story-detail data-sid="' + crEscapeHtml(String(sid)) + '">Chi tiết report story</button></div>'
                                : '';
                            let btns = '';
                            if (!locked) {
                                btns += '<button type="button" class="btn btn-outline-primary btn-sm mb-1" data-cr-claim="' + crEscapeHtml(String(sid)) + '"><i class="bi bi-lock"></i> Nhận</button> ';
                            } else if (mine && isAdm) {
                                btns += '<button type="button" class="btn btn-outline-warning btn-sm mb-1" data-cr-release="' + crEscapeHtml(String(sid)) + '"><i class="bi bi-unlock"></i> Gỡ lock</button> ';
                            } else if (mine && !isAdm) {
                                btns += '<button type="button" class="btn btn-outline-info btn-sm mb-1" data-cr-open-lock-rel data-sid="' + crEscapeHtml(String(sid)) + '"><i class="bi bi-send"></i> Gửi admin</button> ';
                            } else {
                                btns += '<span class="small text-danger d-block mb-1">Người khác lock</span>';
                            }
                            btns += '<button type="button" class="btn btn-outline-secondary btn-sm mb-1" data-cr-detail="' + crEscapeHtml(String(sid)) + '">Chi tiết BC</button>';
                            let tools = '';
                            if (mine && locked) {
                                tools += '<div class="btn-group btn-group-sm mt-1" role="group">';
                                tools += '<button type="button" class="btn btn-outline-dark" title="Gắn / bỏ cờ" data-cr-open-flag data-sid="' + String(sid) + '" data-aid="' + crEscapeHtml(aidStr) + '" data-flagged="' + (fOn ? '1' : '0') + '"><i class="bi bi-bookmark-flag"></i></button>';
                                tools += '<button type="button" class="btn btn-outline-dark" title="Tắt/bật bình luận" data-cr-toggle-cmt data-sid="' + String(sid) + '" data-on="' + (cmtOn ? '1' : '0') + '"><i class="bi bi-chat-dots"></i></button>';
                                tools += '<button type="button" class="btn btn-outline-dark" title="Ẩn/hiện truyện" data-cr-toggle-hide data-sid="' + String(sid) + '" data-on="' + (hidOn ? '1' : '0') + '"><i class="bi bi-eye-slash"></i></button>';
                                tools += '<button type="button" class="btn btn-outline-danger" title="Ban / tạm khóa viết → admin" data-cr-open-admin-act data-sid="' + String(sid) + '" data-aid="' + crEscapeHtml(aidStr) + '"><i class="bi bi-person-slash"></i></button>';
                                if (aidStr) tools += '<button type="button" class="btn btn-outline-secondary" title="Lịch sử vi phạm" data-cr-open-viol data-aid="' + crEscapeHtml(aidStr) + '"><i class="bi bi-clock-history"></i></button>';
                                tools += '</div>';
                                if (hasOpenTickets) {
                                    tools += '<div class="d-flex flex-wrap gap-1 mt-2 justify-content-end">';
                                    tools += '<button type="button" class="btn btn-success btn-sm" data-cr-resolve-all data-sid="' + crEscapeHtml(String(sid)) + '" data-st="RESOLVED" title="Đóng hết ticket NEW/IN_REVIEW">Xong hết ticket</button>';
                                    tools += '<button type="button" class="btn btn-outline-secondary btn-sm" data-cr-resolve-all data-sid="' + crEscapeHtml(String(sid)) + '" data-st="DISMISSED" title="Bác bỏ hết ticket đang mở">Bác bỏ hết</button>';
                                    tools += '</div>';
                                }
                            }
                            html += '<tr>' +
                                '<td class="fw-bold">' + crEscapeHtml(priFmt) + '</td>' +
                                '<td>' + crEscapeHtml(msFmt) + '</td>' +
                                '<td>' + crEscapeHtml(String(rc)) + '</td>' +
                                '<td>' + crEscapeHtml(String(tw)) + '</td>' +
                                '<td><a href="/Home/Story/' + encodeURIComponent(sid) + '" target="_blank" rel="noopener" class="fw-medium">' + crEscapeHtml(title) + '</a><div class="small text-muted text-break">' + crEscapeHtml(String(sid)) + '</div></td>' +
                                '<td class="small">' + crEscapeHtml(String(aname)) + (aidStr ? '<div class="text-muted small text-break">' + crEscapeHtml(aidStr) + '</div>' : '') + '</td>' +
                                '<td class="small">' + badgeCell + '</td>' +
                                '<td class="small">' + crFormatContributors(contribs) + storyDetBtn + '</td>' +
                                '<td class="small">' + crEscapeHtml(sts) + '</td>' +
                                '<td class="small">' + lockCell + '</td>' +
                                '<td class="text-end"><div class="d-inline-flex flex-column align-items-end">' + btns + tools + '</div></td></tr>';
                        });
                    }
                    html += '</tbody></table>';
                    html += '<div class="small text-muted mt-2">Tổng: ' + total + ' (trang ' + (data.page || data.Page) + ')</div>';
                    host.innerHTML = html;
                    host.querySelectorAll('[data-cr-claim]').forEach(function (btn) {
                        btn.addEventListener('click', async function () {
                            const id = btn.getAttribute('data-cr-claim');
                            try {
                                const r = await ApiService.complianceClaimStoryReports(id);
                                const base = (r && (r.message || r.Message)) || 'Đã nhận.';
                                const cat = r && (r.claimedAtUtc != null ? r.claimedAtUtc : r.ClaimedAtUtc);
                                const extra = cat ? (' Chi tiết thời điểm nhận xem trong cột Lock sau khi tải lại.') : '';
                                Utils.showAlert(base + extra, 'success');
                                crLoad();
                            } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
                        });
                    });
                    host.querySelectorAll('[data-cr-release]').forEach(function (btn) {
                        btn.addEventListener('click', async function () {
                            const id = btn.getAttribute('data-cr-release');
                            if (!confirm('ADMIN: Gỡ lock truyện này và đưa báo cáo IN_REVIEW (người cũ) về NEW?')) return;
                            try {
                                const r = await ApiService.complianceReleaseStoryClaim(id);
                                Utils.showAlert((r && (r.message || r.Message)) || 'Đã gỡ lock.', 'success');
                                crLoad();
                            } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
                        });
                    });
                    host.querySelectorAll('[data-cr-detail]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            const id = btn.getAttribute('data-cr-detail');
                            document.getElementById('crStoryId').value = id;
                            document.getElementById('crGroupBy').value = 'false';
                            document.getElementById('crPage').value = '1';
                            crLoad();
                        });
                    });
                    host.querySelectorAll('[data-cr-resolve-all]').forEach(function (btn) {
                        btn.addEventListener('click', async function () {
                            const sid = btn.getAttribute('data-sid');
                            const st = btn.getAttribute('data-st') || 'RESOLVED';
                            const verb = st === 'DISMISSED' ? 'bác bỏ (DISMISSED)' : 'đánh dấu đã xử lý (RESOLVED)';
                            if (!confirm('Đóng hết báo cáo đang mở của truyện này — ' + verb + '?')) return;
                            try {
                                const r = await ApiService.complianceResolveAllOpenReports(sid, { status: st });
                                Utils.showAlert((r && (r.message || r.Message)) || 'Đã cập nhật.', 'success');
                                crLoad();
                            } catch (e) { Utils.showAlert(e.message || e, 'danger'); }
                        });
                    });

                    host.querySelectorAll('[data-sr-open-story-detail]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            const sid = btn.getAttribute('data-sid');
                            const det = storyDetailBySid[sid];
                            const body = document.getElementById('srStoryReportDetailBody');
                            if (!body) return;
                            if (!det) {
                                body.innerHTML = '<div class="text-muted small">Không có dữ liệu.</div>';
                                new bootstrap.Modal(document.getElementById('srModalStoryReportDetail')).show();
                                return;
                            }

                            const reasonItems = (det.reasonSummaryArr || []).map(function (raw) {
                                const txt = String(raw ?? '');
                                const m = txt.match(/^(.*)\((\d+)\)\s*$/);
                                if (m) return { label: m[1].trim(), count: parseInt(m[2], 10) };
                                return { label: txt.trim(), count: 1 };
                            });
                            let selectedReasonLabel = null;
                            let verifyFilter = 'all';
                            let reasonGt = -1;

                            function srRowVerified(row) {
                                return row.isComplianceContributorVerified === true || row.IsComplianceContributorVerified === true;
                            }
                            function srRowReason(row) {
                                return String(row.reasonLabelVi || row.ReasonLabelVi || '').trim();
                            }
                            function srCanMarkRow(row) {
                                return row.canMarkComplianceVerified !== false && row.CanMarkComplianceVerified !== false;
                            }
                            function srFilterReporterRows(list) {
                                return list.filter(function (row) {
                                    const r = srRowReason(row);
                                    if (selectedReasonLabel && r !== selectedReasonLabel) return false;
                                    const v = srRowVerified(row);
                                    if (verifyFilter === 'verified' && !v) return false;
                                    if (verifyFilter === 'unverified' && v) return false;
                                    return true;
                                });
                            }
                            function renderSrReasons(gt) {
                                const list = (reasonItems || []).filter(function (x) {
                                    const c = x.count || 0;
                                    if (gt < 0) return true;
                                    return c > gt;
                                });
                                if (!list.length)
                                    return '<div class="text-muted small mb-3">Không có lý do phù hợp.</div>';
                                return '<div class="d-flex flex-wrap gap-1 mb-3">' +
                                    list.map(function (x) {
                                        const enc = encodeURIComponent(x.label);
                                        const active = selectedReasonLabel && selectedReasonLabel === x.label;
                                        const cls = active ? 'badge bg-primary text-white border border-primary sr-reason-badge-filter' : 'badge bg-light text-dark border sr-reason-badge-filter';
                                        return '<button type="button" class="' + cls + ' rounded-pill" data-sr-reason-lbl="' + enc + '" title="Lọc bảng theo lý do (bấm lại để bỏ lọc)">' +
                                            crEscapeHtml(String(x.label)) + ' (' + crEscapeHtml(String(x.count)) + ')</button>';
                                    }).join('') +
                                    '</div>';
                            }
                            const reasonsBlockHtml = (reasonItems && reasonItems.length)
                                ? (
