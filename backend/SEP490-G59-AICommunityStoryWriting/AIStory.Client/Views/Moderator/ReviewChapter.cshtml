@{
    ViewData["Title"] = "Review chapter";
    var chapterId = ViewBag.ChapterId as Guid? ?? Guid.Empty;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Moderator" asp-action="Index">Kiểm duyệt</a></li>
                    <li class="breadcrumb-item active">Review chapter</li>
                </ol>
            </nav>
            <h2 class="mb-4"><i class="bi bi-journal-text"></i> Review chapter</h2>

            <div id="loadingChapter" class="text-center py-5">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2 text-muted">Đang tải...</p>
            </div>
            <div id="chapterContent" style="display: none;">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0" id="chapterTitle"></h5>
                        <div>
                            <span id="chapterBadges"></span>
                            <a id="linkStory" href="#" class="btn btn-sm btn-outline-primary ms-2" target="_blank"><i class="bi bi-book"></i> Xem truyện</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row small text-muted mb-3">
                            <div class="col-md-6">
                                <span><strong>Chương số:</strong> <span id="chapterOrderIndex"></span></span>
                                <span class="ms-3"><strong>Số từ:</strong> <span id="chapterWordCount"></span></span>
                            </div>
                            <div class="col-md-6">
                                <span><strong>Ngày tạo:</strong> <span id="chapterCreatedAt"></span></span>
                                <span class="ms-3"><strong>Loại:</strong> <span id="chapterAccessType"></span></span>
                                <span id="chapterCoinSpan" class="ms-2"></span>
                            </div>
                        </div>
                        <hr>
                        <p id="chapterBodyLabel" class="text-muted small mb-2" style="display: none;">Nội dung bản gốc (để so sánh với version gửi chỉnh sửa bên dưới)</p>
                        <div id="chapterBody" class="chapter-body" style="white-space: pre-wrap; font-family: inherit;"></div>
                    </div>
                </div>

                <div id="chapterReviewTimingCard" class="card border-0 shadow-sm mb-3" style="display: none;">
                    <div class="card-body py-3">
                        <h6 class="text-muted text-uppercase small mb-2"><i class="bi bi-clock-history"></i> Thời gian &amp; hạn xử lý</h6>
                        <div id="chapterReviewTimingInner" class="small"></div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Các version của chapter</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Version</th>
                                        <th>Tiêu đề</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="versionsTableBodyModerator">
                                    <tr><td colspan="5" class="text-muted text-center">Đang tải...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Quyết định</h5>
                        <a asp-controller="Moderator" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <button type="button" class="btn btn-success btn-lg" id="btnApproveChapter">
                                <i class="bi bi-check-circle"></i> Duyệt chapter
                            </button>
                            <button type="button" class="btn btn-danger btn-lg" id="btnRejectChapter">
                                <i class="bi bi-x-circle"></i> Từ chối (kèm lý do)
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-lg" id="btnEscalateChapter" style="display: none;">
                                <i class="bi bi-shield-exclamation"></i> Báo cáo admin
                            </button>
                        </div>
                        <p class="small text-muted mt-2 mb-0" id="chapterAssignmentHint" style="display: none;"></p>
                        <div id="rejectFormChapter" class="mt-4" style="display: none;">
                            <label class="form-label">Lý do từ chối <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="rejectReasonChapter" rows="4" placeholder="Nhập lý do từ chối..."></textarea>
                            <button type="button" class="btn btn-danger mt-2" id="btnConfirmRejectChapter">Xác nhận từ chối</button>
                            <button type="button" class="btn btn-secondary mt-2 ms-2" id="btnCancelRejectChapter">Hủy</button>
                        </div>
                        <div id="chapterEscalationPanel" class="mt-4 border rounded p-3 bg-light" style="display: none;">
                            <h6 class="mb-2"><i class="bi bi-exclamation-octagon text-danger"></i> Báo cáo lên Admin</h6>
                            <p class="small text-muted">Gia hạn hạn duyệt hoặc hủy nhận để người khác duyệt.</p>
                            <div class="mb-2">
                                <label class="form-label small">Loại yêu cầu</label>
                                <select class="form-select form-select-sm" id="chapterEscKind">
                                    <option value="EXTEND_DEADLINE">Gia hạn hạn duyệt</option>
                                    <option value="RELEASE_ASSIGNMENT">Hủy nhận duyệt</option>
                                </select>
                            </div>
                            <div id="chapterEscExtendWrap" class="mb-2">
                                <label class="form-label small">Hạn đề xuất</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="chapterEscDeadline">
                            </div>
                            <p class="small text-muted mb-2">Mức ưu tiên admin: <strong>tự động</strong> theo loại đơn (hủy nhận = nghiêm trọng; gia hạn = chuẩn, có thể tăng theo hạn).</p>
                            <div class="mb-2">
                                <label class="form-label small">Lý do (≥10 ký tự)</label>
                                <textarea class="form-control form-control-sm" id="chapterEscReason" rows="3"></textarea>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm" id="btnSubmitChapterEsc">Gửi báo cáo</button>
                            <button type="button" class="btn btn-secondary btn-sm ms-1" id="btnCancelChapterEsc">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="errorChapter" class="alert alert-danger" style="display: none;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chapterId = '@(chapterId)';
        let versions = [];

        document.addEventListener('DOMContentLoaded', function () {
            if (!AuthHelper.isAuthenticated() || !AuthHelper.hasAnyRole('MODERATOR', 'ADMIN')) {
                window.location.href = '/Moderator';
                return;
            }
            loadChapter();
            loadChapterVersions();
            document.getElementById('btnApproveChapter').addEventListener('click', approveChapter);
            document.getElementById('btnRejectChapter').addEventListener('click', function () {
                document.getElementById('rejectFormChapter').style.display = 'block';
            });
            document.getElementById('btnConfirmRejectChapter').addEventListener('click', confirmRejectChapter);
            document.getElementById('btnCancelRejectChapter').addEventListener('click', function () {
                document.getElementById('rejectFormChapter').style.display = 'none';
                document.getElementById('rejectReasonChapter').value = '';
            });
            document.getElementById('btnEscalateChapter').addEventListener('click', function () {
                var p = document.getElementById('chapterEscalationPanel');
                p.style.display = p.style.display === 'none' ? 'block' : 'none';
            });
            document.getElementById('chapterEscKind').addEventListener('change', function () {
                document.getElementById('chapterEscExtendWrap').style.display = this.value === 'EXTEND_DEADLINE' ? 'block' : 'none';
            });
            document.getElementById('btnCancelChapterEsc').addEventListener('click', function () {
                document.getElementById('chapterEscalationPanel').style.display = 'none';
            });
            document.getElementById('btnSubmitChapterEsc').addEventListener('click', submitChapterEscalation);
        });

        async function loadChapter() {
            try {
                const c = await ApiService.getChapterById(chapterId);
                document.getElementById('loadingChapter').style.display = 'none';
                document.getElementById('chapterContent').style.display = 'block';

                document.getElementById('chapterTitle').textContent = c.title || 'N/A';
                document.getElementById('chapterOrderIndex').textContent = c.orderIndex ?? '';
                document.getElementById('chapterWordCount').textContent = Utils.formatNumber(c.wordCount || 0);
                document.getElementById('chapterCreatedAt').textContent = Utils.formatDate(c.createdAt);
                document.getElementById('chapterAccessType').textContent = c.accessType === 'PAID' ? 'Trả phí' : 'Miễn phí';
                if (c.coinPrice > 0) {
                    document.getElementById('chapterCoinSpan').innerHTML = `<strong>Giá:</strong> ${c.coinPrice} coin`;
                } else {
                    document.getElementById('chapterCoinSpan').textContent = '';
                }
                document.getElementById('chapterBody').textContent = c.content || '(Chưa có nội dung)';

                const badges = document.getElementById('chapterBadges');
                badges.innerHTML = `
                    <span class="badge bg-warning text-dark me-1">${c.status || 'PENDING_REVIEW'}</span>
                    <span class="badge ${c.accessType === 'PAID' ? 'bg-warning' : 'bg-info'} me-1">${c.accessType || 'FREE'}</span>
                `;

                if (c.storyId) {
                    const link = document.getElementById('linkStory');
                    link.href = '/Stories/Details/' + c.storyId;
                    link.style.display = 'inline-block';
                } else {
                    document.getElementById('linkStory').style.display = 'none';
                }
                await refreshChapterAssignmentUi();
                startChapterReviewTimingTicker(refreshChapterAssignmentUi);
            } catch (e) {
                document.getElementById('loadingChapter').style.display = 'none';
                document.getElementById('errorChapter').style.display = 'block';
                document.getElementById('errorChapter').textContent = e.message || 'Không tải được chapter.';
            }
        }

        function chapterEscDefaultDeadline() {
            var d = new Date();
            d.setDate(d.getDate() + 7);
            d.setHours(23, 59, 0, 0);
            var pad = function (n) { return n.toString().padStart(2, '0'); };
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        var chapterReviewTimingTickerId = null;
        function startChapterReviewTimingTicker(refreshFn) {
            if (chapterReviewTimingTickerId) clearInterval(chapterReviewTimingTickerId);
            chapterReviewTimingTickerId = setInterval(function () { refreshFn(); }, 60000);
        }

        function fillChapterReviewTimingCard(self) {
            var card = document.getElementById('chapterReviewTimingCard');
            var inner = document.getElementById('chapterReviewTimingInner');
            if (!card || !inner) return;
            var hasAny = self.authorSubmittedAtUtc || self.reviewDeadlineAt || self.policySuggestedDeadlineAt;
            if (!hasAny) {
                card.style.display = 'none';
                return;
            }
            card.style.display = 'block';
            var mainLine = '—';
            if (self.authorSubmittedAtUtc) {
                mainLine = '<strong>' + Utils.formatDate(self.authorSubmittedAtUtc) + '</strong> · <em>' + (Utils.formatRelativePastVi ? Utils.formatRelativePastVi(self.authorSubmittedAtUtc) : '') + '</em>';
            }
            var badge = (typeof Utils.moderatorDeadlineBadgeHtml === 'function') ? Utils.moderatorDeadlineBadgeHtml(self.timeStatus) : '';
            var personalLine = '';
            if (self.isAssignedToMe && self.reviewDeadlineAt) {
                var pcd = (typeof Utils.formatCountdownRemainingVi === 'function') ? Utils.formatCountdownRemainingVi(self.reviewDeadlineAt) : '';
                personalLine = '<div class="mt-2 pt-2 border-top small"><span class="text-muted">Cam kết khi nhận duyệt:</span> <strong>' + Utils.formatDate(self.reviewDeadlineAt) + '</strong>' +
                    (pcd ? ' · <em>' + pcd + '</em>' : '') + '</div>';
            }
            inner.innerHTML =
                '<div class="fw-semibold text-body mb-1">Thời điểm tác giả gửi &amp; mức ưu tiên</div>' +
                '<div>' + mainLine + ' ' + badge + '</div>' + personalLine;
        }

        async function refreshChapterAssignmentUi() {
            try {
                var self = await ApiService.moderatorGetReviewAssignmentSelf('CHAPTER', chapterId);
                var btn = document.getElementById('btnEscalateChapter');
                var hint = document.getElementById('chapterAssignmentHint');
                var escalationLocked = !!(self.isAssignedToMe && self.hasPendingEscalation);
                var mustClaimFirst = !self.isAssignedToMe;
                var btnApprove = document.getElementById('btnApproveChapter');
                var btnReject = document.getElementById('btnRejectChapter');
                var btnConfirmReject = document.getElementById('btnConfirmRejectChapter');
                fillChapterReviewTimingCard(self);
                if (self.isAssignedToMe) {
                    btn.style.display = escalationLocked ? 'none' : '';
                    hint.style.display = 'block';
                    var dl = self.reviewDeadlineAt ? Utils.formatDate(self.reviewDeadlineAt) : '—';
                    if (escalationLocked) {
                        hint.textContent = 'Đơn báo cáo đang chờ admin xử lý — bạn không thể duyệt hoặc từ chối cho đến khi admin quyết định.';
                        hint.classList.add('text-warning', 'fw-semibold');
                    } else {
                        hint.classList.remove('text-warning', 'fw-semibold');
                        var waitPart = (self.authorSubmittedAtUtc && Utils.formatRelativePastVi)
                            ? ' · Đang chờ: ' + Utils.formatRelativePastVi(self.authorSubmittedAtUtc)
                            : '';
                        hint.textContent = 'Bạn đang nhận duyệt. Cam kết: ' + dl + waitPart;
                    }
                } else {
                    btn.style.display = 'none';
                    hint.style.display = 'block';
                    hint.classList.remove('text-warning', 'fw-semibold');
                    hint.textContent = 'Bạn chưa nhận duyệt mục này — dùng Nhận duyệt trên danh sách chờ trước khi duyệt hoặc từ chối.';
                }
                if (btnApprove) btnApprove.disabled = mustClaimFirst || escalationLocked;
                if (btnReject) btnReject.disabled = mustClaimFirst || escalationLocked;
                if (btnConfirmReject) btnConfirmReject.disabled = mustClaimFirst || escalationLocked;
                document.getElementById('chapterEscDeadline').value = chapterEscDefaultDeadline();
            } catch (e) { /* ignore */ }
        }

        async function submitChapterEscalation() {
            var kind = document.getElementById('chapterEscKind').value;
            var reason = document.getElementById('chapterEscReason').value.trim();
            if (reason.length < 10) {
                Utils.showAlert('Lý do cần ít nhất 10 ký tự.', 'warning');
                return;
            }
            var body = { targetType: 'CHAPTER', targetId: chapterId, requestKind: kind, reason: reason };
            if (kind === 'EXTEND_DEADLINE') {
                var localStr = document.getElementById('chapterEscDeadline').value;
                if (!localStr) { Utils.showAlert('Chọn hạn đề xuất.', 'warning'); return; }
                var pIso = Utils.datetimeLocalToIsoUtc(localStr);
                if (!pIso) { Utils.showAlert('Hạn đề xuất không hợp lệ.', 'warning'); return; }
                var dt = new Date(pIso);
                if (dt.getTime() <= Date.now() + 86400000) {
                    Utils.showAlert('Hạn đề xuất phải sau ít nhất 24 giờ.', 'warning');
                    return;
                }
                body.proposedDeadlineAt = pIso;
            }
            try {
                await ApiService.moderatorSubmitReviewEscalation(body);
                Utils.showAlert('Đã gửi báo cáo cho admin.', 'success');
                document.getElementById('chapterEscalationPanel').style.display = 'none';
                await refreshChapterAssignmentUi();
            } catch (e) {
                Utils.showAlert(e.message || 'Gửi thất bại.', 'danger');
            }
        }

        async function loadChapterVersions() {
            const tbody = document.getElementById('versionsTableBodyModerator');
            try {
                versions = await ApiService.moderatorGetChapterVersions(chapterId);
                if (!versions || versions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-center">Chưa có version nào.</td></tr>';
                    document.getElementById('chapterBodyLabel').style.display = 'none';
                    return;
                }
                const hasPending = versions.some(v => (v.status || '').toUpperCase() === 'PENDING_REVIEW');
                document.getElementById('chapterBodyLabel').style.display = hasPending ? 'block' : 'none';
                tbody.innerHTML = versions.map(v => {
                    const statusBadge = v.status === 'PUBLISHED'
                        ? '<span class="badge bg-success">Đã xuất bản</span>'
                        : v.status === 'PENDING_REVIEW'
                            ? '<span class="badge bg-warning text-dark">Chờ duyệt</span>'
                            : '<span class="badge bg-secondary">Nháp</span>';
                    return `
                        <tr>
                            <td>#${v.versionNumber}</td>
                            <td>${v.titleSnapshot || '-'}</td>
                            <td>${statusBadge}</td>
                            <td>${Utils.formatDate(v.createdAt)}</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="viewVersion('${v.id}')">
                                    <i class="bi bi-eye"></i> Xem nội dung
                                </button>
                            </td>
                        </tr>`;
                }).join('');
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">' + (e.message || 'Lỗi tải versions.') + '</td></tr>';
            }
        }

        async function viewVersion(versionId) {
            try {
                const v = await ApiService.moderatorGetChapterVersion(chapterId, versionId);
                const title = v.titleSnapshot || ('Version #' + v.versionNumber);
                const created = v.createdAt ? Utils.formatDate(v.createdAt) : '';
                const content = v.contentSnapshot || '(Không có nội dung)';
                const modalHtml = `
                    <div class="modal fade" id="versionViewModal" tabindex="-1">
                        <div class="modal-dialog modal-xl modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Version #${v.versionNumber} - ${title}</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted small mb-2">Tạo lúc: ${created}</p>
                                    <div style="white-space: pre-wrap; font-family: inherit;">${content.replace(/</g, '&lt;')}</div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                </div>
                            </div>
                        </div>
                    </div>`;
                let holder = document.getElementById('versionViewModalHolder');
                if (!holder) {
                    holder = document.createElement('div');
                    holder.id = 'versionViewModalHolder';
                    document.body.appendChild(holder);
                }
                holder.innerHTML = modalHtml;
                const modal = new bootstrap.Modal(document.getElementById('versionViewModal'));
                modal.show();
            } catch (e) {
                Utils.showAlert(e.message || 'Không tải được version.', 'danger');
            }
        }

        async function approveChapter() {
            try {
                await ApiService.moderatorApproveChapter(chapterId);
                Utils.showAlert('Đã duyệt chapter.', 'success');
                setTimeout(() => { window.location.href = '/Moderator'; }, 1000);
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi duyệt chapter.', 'danger');
            }
        }

        async function confirmRejectChapter() {
            const reason = document.getElementById('rejectReasonChapter').value.trim();
            if (!reason) {
                Utils.showAlert('Vui lòng nhập lý do từ chối.', 'warning');
                return;
            }
            try {
                await ApiService.moderatorRejectChapter(chapterId, reason);
                Utils.showAlert('Đã từ chối chapter.', 'success');
                setTimeout(() => { window.location.href = '/Moderator'; }, 1000);
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi từ chối.', 'danger');
            }
        }
    </script>
}
