@{
    ViewData["Title"] = "Kiểm duyệt";
}

<style>
    .mod-dashboard .stat-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .mod-dashboard .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.08);
        }

        .mod-dashboard .stat-card .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

    .mod-dashboard .nav-pills .nav-link {
        border-radius: 10px;
        font-weight: 500;
        padding: 0.6rem 1.2rem;
    }

        .mod-dashboard .nav-pills .nav-link:not(.active) {
            color: #495057;
            background: #f8f9fa;
        }

        .mod-dashboard .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            color: #fff;
        }

    .mod-dashboard .filter-panel {
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .mod-dashboard .story-card-mod {
        border-radius: 12px;
        border: 1px solid #e9ecef;
        overflow: hidden;
        transition: box-shadow .2s ease;
    }

        .mod-dashboard .story-card-mod:hover {
            box-shadow: 0 4px 14px rgba(0,0,0,.08);
        }

        .mod-dashboard .story-card-mod .cover-wrap {
            width: 120px;
            min-height: 100px;
            object-fit: cover;
            background: #e9ecef;
        }

    .mod-dashboard .chapter-row-mod:hover {
        background-color: #f8f9fa;
    }

    .mod-dashboard .badge-status {
        font-size: 0.7rem;
        font-weight: 500;
    }

    .mod-dashboard .btn-action-group .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }
</style>

<div class="container-fluid mt-4 mod-dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-1"><i class="bi bi-shield-check text-primary"></i> Bảng điều khiển kiểm duyệt</h2>
            <p class="text-muted small mb-0">Duyệt và từ chối truyện, chapter. <strong>Nhận duyệt</strong> = lock mục (chỉ bạn thấy); khi nhận bạn <strong>bắt buộc chọn hạn hoàn thành duyệt</strong> (7 / 14 ngày hoặc tùy chọn) và xác nhận cam kết. Queue <strong>ai gửi trước → duyệt trước</strong>.</p>
            <p class="text-muted small mb-0 mt-1">
                <i class="bi bi-broadcast"></i> Cập nhật real-time qua WebSocket
                <span class="ms-2">• Lần cuối: <span id="lastRefreshTime">--:--:--</span></span>
                <span class="ms-2" id="signalrStatus"></span>
            </p>
        </div>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-book"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Truyện chờ duyệt</div>
                        <div class="h4 mb-0 fw-bold" id="statStoriesCount">–</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-25 text-info">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Chapter chờ duyệt</div>
                        <div class="h4 mb-0 fw-bold" id="statChaptersCount">–</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Truyện / Chapter -->
    <ul class="nav nav-pills mb-3" id="moderationTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="stories-tab" data-bs-toggle="tab" data-bs-target="#stories-panel" type="button" role="tab">
                <i class="bi bi-book me-1"></i> Truyện chờ duyệt
                <span class="badge bg-warning text-dark ms-2" id="pendingStoriesCount">0</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="chapters-tab" data-bs-toggle="tab" data-bs-target="#chapters-panel" type="button" role="tab">
                <i class="bi bi-journal-text me-1"></i> Chapter chờ duyệt
                <span class="badge bg-warning text-dark ms-2" id="pendingChaptersCount">0</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="moderationTabContent">
        <!-- Panel Truyện chờ duyệt -->
        <div class="tab-pane fade show active" id="stories-panel" role="tabpanel">
            <div class="filter-panel p-3 mb-3">
                <button class="btn btn-link btn-sm text-dark text-decoration-none p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#storyFilterCollapse" aria-expanded="true">
                    <i class="bi bi-funnel"></i> Bộ lọc & tìm kiếm
                </button>
                <div class="collapse show mt-2" id="storyFilterCollapse">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Trạng thái nhận duyệt</label>
                            <select class="form-select form-select-sm" id="storyClaimFilter">
                                <option value="">Tất cả</option>
                                <option value="unclaimed">Chưa nhận</option>
                                <option value="claimed">Đã nhận duyệt</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Tìm kiếm (tiêu đề, tóm tắt)</label>
                            <input type="text" class="form-control form-control-sm" id="storySearch" placeholder="Từ khóa…" autocomplete="off">
                        </div>
                        <div class="col-md-2 col-lg-2">
                            <label class="form-label small mb-0">Mức cảnh báo (thời gian chờ)</label>
                            <select class="form-select form-select-sm" id="storyTimeStatus" title="Lọc theo thời gian đã chờ kể từ lúc tác giả gửi">
                                <option value="">Tất cả</option>
                                <option value="Overdue">Chờ quá lâu (≥7 ngày)</option>
                                <option value="Critical">Chờ lâu (≥4 ngày)</option>
                                <option value="Warning">Chờ khá lâu (≥2 ngày)</option>
                                <option value="OnTime">Mới gửi (&lt;2 ngày)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Sắp xếp</label>
                            <select class="form-select form-select-sm" id="storySortBy">
                                <option value="updated_at" selected>Tác giả gửi (cũ → mới)</option>
                                <option value="deadline_at">Chờ lâu nhất trước</option>
                                <option value="created_at">Ngày tạo</option>
                                <option value="title">Tiêu đề</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Thứ tự</label>
                            <select class="form-select form-select-sm" id="storySortOrder">
                                <option value="asc" selected>Gửi trước → duyệt trước</option>
                                <option value="desc">Mới nhất / Z→A</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Số dòng/trang</label>
                            <select class="form-select form-select-sm" id="storyPageSize">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-primary btn-sm" onclick="applyStoryFilters()"><i class="bi bi-search"></i> Áp dụng</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetStoryFilters()">Đặt lại</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="loadPendingStories(1)"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <span class="text-muted small" id="storiesSummary">Đang tải...</span>
                        <span class="text-muted small">Trang <strong id="storiesPage">1</strong> / <strong id="storiesTotalPages">1</strong></span>
                    </div>
                    <div id="pendingStoriesContainer">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted mb-0">Đang tải danh sách truyện...</p>
                        </div>
                    </div>
                    <nav id="storiesPagination" class="mt-3 d-flex justify-content-center"></nav>
                </div>
            </div>
        </div>

        <!-- Panel Chapter chờ duyệt -->
        <div class="tab-pane fade" id="chapters-panel" role="tabpanel">
            <div class="filter-panel p-3 mb-3">
                <button class="btn btn-link btn-sm text-dark text-decoration-none p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#chapterFilterCollapse" aria-expanded="true">
                    <i class="bi bi-funnel"></i> Bộ lọc & tìm kiếm
                </button>
                <div class="collapse show mt-2" id="chapterFilterCollapse">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Trạng thái nhận duyệt</label>
                            <select class="form-select form-select-sm" id="chapterClaimFilter">
                                <option value="">Tất cả</option>
                                <option value="unclaimed">Chưa nhận</option>
                                <option value="claimed">Đã nhận duyệt</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Story ID (lọc truyện)</label>
                            <input type="text" class="form-control form-control-sm" id="chapterStoryIdFilter" placeholder="Guid hoặc để trống" autocomplete="off">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Tìm chapter / truyện</label>
                            <input type="text" class="form-control form-control-sm" id="chapterSearch" placeholder="Tiêu đề chương hoặc truyện…" autocomplete="off">
                        </div>
                        <div class="col-md-2 col-lg-2">
                            <label class="form-label small mb-0">Mức cảnh báo (thời gian chờ)</label>
                            <select class="form-select form-select-sm" id="chapterTimeStatus" title="Lọc theo thời gian đã chờ kể từ lúc tác giả gửi">
                                <option value="">Tất cả</option>
                                <option value="Overdue">Chờ quá lâu (≥7 ngày)</option>
                                <option value="Critical">Chờ lâu (≥4 ngày)</option>
                                <option value="Warning">Chờ khá lâu (≥2 ngày)</option>
                                <option value="OnTime">Mới gửi (&lt;2 ngày)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Sắp xếp</label>
                            <select class="form-select form-select-sm" id="chapterSortBy">
                                <option value="updated_at" selected>Tác giả gửi (cũ → mới)</option>
                                <option value="deadline_at">Chờ lâu nhất trước</option>
                                <option value="created_at">Ngày tạo</option>
                                <option value="order_index">Thứ tự chương</option>
                                <option value="title">Tiêu đề chapter</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Thứ tự</label>
                            <select class="form-select form-select-sm" id="chapterSortOrder">
                                <option value="asc" selected>Gửi trước → duyệt trước</option>
                                <option value="desc">Mới nhất / Z→A</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Số dòng/trang</label>
                            <select class="form-select form-select-sm" id="chapterPageSize">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-primary btn-sm" onclick="applyChapterFilters()"><i class="bi bi-search"></i> Áp dụng</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetChapterFilters()">Đặt lại</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="loadPendingChapters(1)"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <span class="text-muted small" id="chaptersSummary">Đang tải...</span>
                        <span class="text-muted small">Trang <strong id="chaptersPage">1</strong> / <strong id="chaptersTotalPages">1</strong></span>
                    </div>
                    <div id="pendingChaptersContainer">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted mb-0">Đang tải danh sách chapter...</p>
                        </div>
                    </div>
                    <nav id="chaptersPagination" class="mt-3 d-flex justify-content-center"></nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal từ chối (dùng chung Story & Chapter) -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="rejectModalTitle"><i class="bi bi-x-circle text-danger me-2"></i> Từ chối – Nhập lý do</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <input type="hidden" id="rejectTargetType" value="">
                <input type="hidden" id="rejectTargetId" value="">
                <div class="mb-2">
                    <label class="form-label small text-muted">Lý do nhanh (tùy chọn)</label>
                    <select class="form-select form-select-sm" id="rejectQuickReason">
                        <option value="">-- Chọn lý do nhanh --</option>
                        <option value="Nội dung không phù hợp">Nội dung không phù hợp</option>
                        <option value="Vi phạm bản quyền">Vi phạm bản quyền</option>
                        <option value="Chất lượng chưa đạt">Chất lượng chưa đạt</option>
                        <option value="Spam / quảng cáo">Spam / quảng cáo</option>
                        <option value="">Khác (ghi rõ bên dưới)</option>
                    </select>
                </div>
                <div class="mb-0">
                    <label for="rejectReason" class="form-label">Lý do từ chối <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="rejectReason" rows="4" placeholder="Nhập lý do từ chối (bắt buộc)..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtn" onclick="confirmReject()"><i class="bi bi-x-circle me-1"></i> Từ chối</button>
            </div>
        </div>
    </div>
</div>

<!-- Nhận duyệt: chọn hạn + cam kết (2 bước) -->
<div class="modal fade" id="claimModal" tabindex="-1" aria-labelledby="claimModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="claimModalTitle"><i class="bi bi-calendar-check text-warning me-2"></i> Nhận duyệt – Chọn hạn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <div id="claimStep1">
                    <p class="small text-muted mb-2">Chọn <strong>thời điểm hạn duyệt</strong> — thời điểm bạn cam kết hoàn thành kiểm duyệt. Hạn phải cách hiện tại <strong>ít nhất 24 giờ</strong>.</p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setClaimQuickDeadline(7)">7 ngày (cuối ngày)</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setClaimQuickDeadline(14)">14 ngày (cuối ngày)</button>
                    </div>
                    <div class="mb-3">
                        <label for="claimDeadlineLocal" class="form-label small mb-0">Hạn duyệt (ngày &amp; giờ) <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" id="claimDeadlineLocal" required>
                    </div>
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="claimCommitmentCheck">
                        <label class="form-check-label small" for="claimCommitmentCheck">Tôi cam kết hoàn thành kiểm duyệt trước hạn đã chọn.</label>
                    </div>
                </div>
                <div id="claimStep2" class="d-none">
                    <div class="alert alert-light border mb-3" id="claimConfirmSummary"></div>
                    <p class="small text-muted mb-0">Nhấn <strong>Xác nhận nhận duyệt</strong> để khóa mục này cho bạn.</p>
                </div>
            </div>
            <div class="modal-footer border-0" id="claimModalFooterStep1">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" onclick="goClaimConfirmStep()"><i class="bi bi-arrow-right me-1"></i> Tiếp tục xác nhận</button>
            </div>
            <div class="modal-footer border-0 d-none" id="claimModalFooterStep2">
                <button type="button" class="btn btn-outline-secondary" onclick="claimGoBack()"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
                <button type="button" class="btn btn-warning" onclick="submitClaim()"><i class="bi bi-lock-fill me-1"></i> Xác nhận nhận duyệt</button>
            </div>
        </div>
    </div>
</div>

<!-- Báo cáo admin: gia hạn hoặc hủy nhận duyệt -->
<div class="modal fade" id="escalationModal" tabindex="-1" aria-labelledby="escalationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="escalationModalTitle"><i class="bi bi-exclamation-octagon text-danger me-2"></i> Báo cáo lên Admin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="small text-muted mb-2">Dùng khi bạn <strong>không thể hoàn thành duyệt đúng hạn</strong>. Admin sẽ xác nhận: <strong>gia hạn hạn duyệt</strong> (tối đa <strong>một lần</strong> mỗi phiên nhận duyệt) hoặc <strong>hủy nhận</strong> để moderator khác nhận.</p>
                <div id="escalationMeta" class="alert alert-light border small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label small mb-1">Loại yêu cầu <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" id="escRequestKind" onchange="toggleEscExtendFields()">
                        <option value="EXTEND_DEADLINE">Gia hạn hạn duyệt</option>
                        <option value="RELEASE_ASSIGNMENT">Hủy nhận duyệt (chuyển cho người khác)</option>
                    </select>
                    <p class="small text-muted mb-0 mt-2">Mức ưu tiên gửi admin do hệ thống gán theo loại đơn: <strong>Hủy nhận duyệt</strong> → nghiêm trọng; <strong>Gia hạn</strong> → chuẩn (có thể tăng thêm theo hạn / thời gian chờ). Sau khi đã gửi một đơn gia hạn trong lần nhận này, chỉ còn chọn hủy nhận (hoặc nhận lại sau khi admin xử lý).</p>
                </div>
                <div id="escExtendBlock" class="mb-3">
                    <label class="form-label small mb-1">Hạn duyệt đề xuất <span class="text-danger">*</span></label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setEscQuickDeadline(7)">+7 ngày (23:59)</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setEscQuickDeadline(14)">+14 ngày (23:59)</button>
                    </div>
                    <input type="datetime-local" class="form-control" id="escProposedDeadlineLocal">
                </div>
                <div class="mb-0">
                    <label class="form-label small mb-1">Lý do chi tiết <span class="text-danger">*</span> <span class="text-muted">(ít nhất 10 ký tự)</span></label>
                    <textarea class="form-control" id="escReason" rows="4" placeholder="Mô tả ngắn gọn lý do (bận đột xuất, khối lượng lớn, v.v.)"></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="submitEscalation()"><i class="bi bi-send me-1"></i> Gửi báo cáo</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
    <script>
        let pendingStories = [];
        let pendingChapters = [];
        let storiesCurrentPage = 1;
        let chaptersCurrentPage = 1;
        let storiesTotalCount = 0;
        let chaptersTotalCount = 0;
        let storiesPageSize = 10;
        let chaptersPageSize = 10;
        let claimModalState = { type: '', id: '', deadlineIso: '' };
        let escalationModalState = { type: '', id: '' };
        const apiBaseForImages = (typeof API_BASE_URL !== 'undefined' ? (API_BASE_URL || '').replace(/\/api\/?$/, '') : '') || 'http://localhost:5000';
        const hubBaseUrl = apiBaseForImages;
        var moderatorHubConnection = null;

        function updateLastRefreshTime() {
            var el = document.getElementById('lastRefreshTime');
            if (el) {
                var d = new Date();
                el.textContent = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0') + ':' + d.getSeconds().toString().padStart(2, '0');
            }
        }

        function setSignalRStatus(text, isError) {
            var el = document.getElementById('signalrStatus');
            if (el) {
                el.textContent = text;
                el.className = 'ms-2 ' + (isError ? 'text-danger' : 'text-success');
            }
        }

        function startModeratorSignalR() {
            if (typeof signalR === 'undefined') {
                setSignalRStatus('(SignalR chưa tải)', true);
                return;
            }
            var token = typeof AuthHelper !== 'undefined' ? AuthHelper.getToken() : null;
            if (!token) {
                setSignalRStatus('(Chưa đăng nhập)', true);
                return;
            }
            var url = hubBaseUrl + '/hubs/moderator';
            moderatorHubConnection = new signalR.HubConnectionBuilder()
                .withUrl(url, { accessTokenFactory: function () { return token; } })
                .withAutomaticReconnect()
                .build();
            moderatorHubConnection.on('PendingListChanged', async function () {
                if (document.querySelector('#rejectModal.show') || document.querySelector('#claimModal.show') || document.querySelector('#escalationModal.show')) return;
                await Promise.all([
                    loadPendingStories(storiesCurrentPage, true),
                    loadPendingChapters(chaptersCurrentPage, true)
                ]);
                updateStatCards();
                updateLastRefreshTime();
            });
            moderatorHubConnection.start()
                .then(function () { setSignalRStatus('(Đã kết nối)', false); })
                .catch(function (err) {
                    setSignalRStatus('(Lỗi kết nối)', true);
                    console.error('Moderator SignalR:', err);
                });
            moderatorHubConnection.onreconnected(function () { setSignalRStatus('(Đã kết nối)', false); });
            moderatorHubConnection.onreconnecting(function () { setSignalRStatus('(Đang kết nối lại...)', true); });
            moderatorHubConnection.onclose(function () { setSignalRStatus('(Mất kết nối)', true); });
        }

        function modTimeStatusBadge(ts) {
            if (typeof Utils !== 'undefined' && Utils.moderatorDeadlineBadgeHtml) return Utils.moderatorDeadlineBadgeHtml(ts);
            if (ts === 'Overdue') return '<span class="badge bg-danger badge-status">Chờ quá lâu</span>';
            if (ts === 'Critical') return '<span class="badge bg-danger badge-status">Chờ lâu</span>';
            if (ts === 'Warning') return '<span class="badge bg-warning text-dark badge-status">Chờ khá lâu</span>';
            return '<span class="badge bg-success badge-status">Mới gửi</span>';
        }

        function authorSentLine(iso) {
            if (!iso) return '';
            var abs = Utils.formatDate(iso);
            var rel = Utils.formatRelativePastVi ? Utils.formatRelativePastVi(iso) : '';
            return '<span class="small text-muted d-block mt-1"><i class="bi bi-send"></i> Tác giả gửi: <strong>' + abs + '</strong>' + (rel ? ' · <em>' + rel + '</em>' : '') + '</span>';
        }

        function toDatetimeLocalValue(d) {
            var pad = function (n) { return n.toString().padStart(2, '0'); };
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        function setClaimQuickDeadline(days) {
            var d = new Date();
            d.setDate(d.getDate() + days);
            d.setHours(23, 59, 0, 0);
            var el = document.getElementById('claimDeadlineLocal');
            if (el) el.value = toDatetimeLocalValue(d);
        }

        function openClaimModal(type, id) {
            claimModalState = { type: type, id: id, deadlineIso: '' };
            document.getElementById('claimStep1').classList.remove('d-none');
            document.getElementById('claimStep2').classList.add('d-none');
            document.getElementById('claimModalFooterStep1').classList.remove('d-none');
            document.getElementById('claimModalFooterStep2').classList.add('d-none');
            var chk = document.getElementById('claimCommitmentCheck');
            if (chk) chk.checked = false;
            setClaimQuickDeadline(7);
            new bootstrap.Modal(document.getElementById('claimModal')).show();
        }

        function goClaimConfirmStep() {
            var localStr = (document.getElementById('claimDeadlineLocal') || {}).value;
            if (!localStr) {
                Utils.showAlert('Vui lòng chọn hạn duyệt.', 'warning');
                return;
            }
            if (!document.getElementById('claimCommitmentCheck').checked) {
                Utils.showAlert('Vui lòng tick xác nhận cam kết hoàn thành duyệt trước hạn.', 'warning');
                return;
            }
            var deadlineIso = Utils.datetimeLocalToIsoUtc(localStr);
            if (!deadlineIso) {
                Utils.showAlert('Thời gian không hợp lệ.', 'warning');
                return;
            }
            var dt = new Date(deadlineIso);
            var minMs = Date.now() + 24 * 60 * 60 * 1000;
            if (dt.getTime() <= minMs) {
                Utils.showAlert('Hạn duyệt phải sau ít nhất 24 giờ so với hiện tại.', 'warning');
                return;
            }
            var maxMs = Date.now() + 366 * 24 * 60 * 60 * 1000;
            if (dt.getTime() > maxMs) {
                Utils.showAlert('Hạn duyệt không được vượt quá 366 ngày.', 'warning');
                return;
            }
            claimModalState.deadlineIso = deadlineIso;
            var label = claimModalState.type === 'STORY' ? 'truyện' : 'chapter';
            document.getElementById('claimConfirmSummary').innerHTML =
                '<p class="small mb-2">Bạn sắp <strong>nhận duyệt ' + label + '</strong> và <strong>cam kết</strong> hoàn thành kiểm duyệt trước:</p>' +
                '<p class="fw-semibold mb-0">' + Utils.formatDateUtc(claimModalState.deadlineIso) + '</p>' +
                '<p class="small text-muted mb-0">(Giờ địa phương: ' + Utils.formatDate(claimModalState.deadlineIso) + ')</p>';
            document.getElementById('claimStep1').classList.add('d-none');
            document.getElementById('claimStep2').classList.remove('d-none');
            document.getElementById('claimModalFooterStep1').classList.add('d-none');
            document.getElementById('claimModalFooterStep2').classList.remove('d-none');
        }

        function claimGoBack() {
            document.getElementById('claimStep2').classList.add('d-none');
            document.getElementById('claimStep1').classList.remove('d-none');
            document.getElementById('claimModalFooterStep2').classList.add('d-none');
            document.getElementById('claimModalFooterStep1').classList.remove('d-none');
        }

        async function submitClaim() {
            var id = claimModalState.id;
            var iso = claimModalState.deadlineIso;
            var type = claimModalState.type;
            if (!id || !iso) {
                Utils.showAlert('Thiếu thông tin hạn duyệt. Vui lòng thử lại.', 'warning');
                return;
            }
            try {
                if (type === 'STORY')
                    await ApiService.moderatorClaimStory(id, iso);
                else
                    await ApiService.moderatorClaimChapter(id, iso);
                var modalEl = document.getElementById('claimModal');
                var inst = bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
                Utils.showAlert('Đã nhận duyệt. Chỉ bạn thấy mục này; bạn có thể Duyệt hoặc Từ chối.', 'success');
                if (type === 'STORY')
                    loadPendingStories(storiesCurrentPage, true);
                else
                    loadPendingChapters(chaptersCurrentPage, true);
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi nhận duyệt (có thể đã được người khác nhận).', 'danger');
            }
        }

        function toggleEscExtendFields() {
            var kind = (document.getElementById('escRequestKind') || {}).value;
            var block = document.getElementById('escExtendBlock');
            if (block) block.style.display = kind === 'EXTEND_DEADLINE' ? 'block' : 'none';
        }

        function setEscalationExtendOptionEnabled(canExtend) {
            var sel = document.getElementById('escRequestKind');
            if (!sel) return;
            var extOpt = sel.querySelector('option[value="EXTEND_DEADLINE"]');
            if (!extOpt) return;
            extOpt.disabled = !canExtend;
            if (!canExtend && sel.value === 'EXTEND_DEADLINE') {
                sel.value = 'RELEASE_ASSIGNMENT';
                toggleEscExtendFields();
            }
        }

        function setEscQuickDeadline(days) {
            var d = new Date();
            d.setDate(d.getDate() + days);
            d.setHours(23, 59, 0, 0);
            var el = document.getElementById('escProposedDeadlineLocal');
            if (el) el.value = toDatetimeLocalValue(d);
        }

        async function openEscalationModal(type, id) {
            escalationModalState = { type: type, id: id };
            document.getElementById('escReason').value = '';
            document.getElementById('escRequestKind').value = 'EXTEND_DEADLINE';
            setEscalationExtendOptionEnabled(true);
            toggleEscExtendFields();
            setEscQuickDeadline(7);
            try {
                var self = await ApiService.moderatorGetReviewAssignmentSelf(type, id);
                if (!self.isAssignedToMe) {
                    Utils.showAlert('Bạn không phải người đang nhận duyệt mục này.', 'warning');
                    return;
                }
                if (self.hasPendingEscalation) {
                    Utils.showAlert('Đã có đơn báo cáo chờ admin xử lý cho mục này.', 'info');
                    return;
                }
                var canExt = self.canSubmitExtendDeadlineRequest !== false;
                setEscalationExtendOptionEnabled(!!canExt);
                if (!canExt) {
                    document.getElementById('escRequestKind').value = 'RELEASE_ASSIGNMENT';
                    toggleEscExtendFields();
                }
                var meta = document.getElementById('escalationMeta');
                var dl = self.reviewDeadlineAt ? Utils.formatDate(self.reviewDeadlineAt) : '—';
                var extNote = !canExt ? '<br><span class="text-secondary">Bạn đã dùng lượt xin gia hạn (1 lần/phiên nhận). Chỉ còn gửi hủy nhận duyệt.</span>' : '';
                meta.innerHTML = '<strong>Hạn duyệt hiện tại:</strong> ' + dl + extNote;
                new bootstrap.Modal(document.getElementById('escalationModal')).show();
            } catch (e) {
                Utils.showAlert(e.message || 'Không tải được trạng thái nhận duyệt.', 'danger');
            }
        }

        async function submitEscalation() {
            var type = escalationModalState.type;
            var id = escalationModalState.id;
            var kind = (document.getElementById('escRequestKind') || {}).value;
            var reason = (document.getElementById('escReason') || {}).value.trim();
            if (reason.length < 10) {
                Utils.showAlert('Lý do cần ít nhất 10 ký tự.', 'warning');
                return;
            }
            var body = {
                targetType: type,
                targetId: id,
                requestKind: kind,
                reason: reason
            };
            if (kind === 'EXTEND_DEADLINE') {
                var extOpt = document.querySelector('#escRequestKind option[value="EXTEND_DEADLINE"]');
                if (extOpt && extOpt.disabled) {
                    Utils.showAlert('Bạn đã hết lượt xin gia hạn trong phiên nhận duyệt này.', 'warning');
                    return;
                }
                var localStr = (document.getElementById('escProposedDeadlineLocal') || {}).value;
                if (!localStr) {
                    Utils.showAlert('Chọn hạn duyệt đề xuất.', 'warning');
                    return;
                }
                var pIso = Utils.datetimeLocalToIsoUtc(localStr);
                if (!pIso) {
                    Utils.showAlert('Hạn đề xuất không hợp lệ.', 'warning');
                    return;
                }
                var dt = new Date(pIso);
                if (dt.getTime() <= Date.now() + 24 * 60 * 60 * 1000) {
                    Utils.showAlert('Hạn đề xuất phải sau ít nhất 24 giờ.', 'warning');
                    return;
                }
                body.proposedDeadlineAt = pIso;
            }
            try {
                await ApiService.moderatorSubmitReviewEscalation(body);
                var inst = bootstrap.Modal.getInstance(document.getElementById('escalationModal'));
                if (inst) inst.hide();
                Utils.showAlert('Đã gửi báo cáo. Admin sẽ xử lý — bạn không thể duyệt/từ chối cho đến khi admin quyết định.', 'success');
                loadPendingStories(storiesCurrentPage, true);
                loadPendingChapters(chaptersCurrentPage, true);
            } catch (e) {
                Utils.showAlert(e.message || 'Gửi báo cáo thất bại.', 'danger');
            }
        }

        function updateStatCards() {
            var sEl = document.getElementById('statStoriesCount');
            var cEl = document.getElementById('statChaptersCount');
            if (sEl) sEl.textContent = typeof storiesTotalCount === 'number' && document.getElementById('stories-panel').classList.contains('active') ? storiesTotalCount : (document.getElementById('pendingStoriesCount').textContent || '–');
            if (cEl) cEl.textContent = typeof chaptersTotalCount === 'number' && document.getElementById('chapters-panel').classList.contains('active') ? chaptersTotalCount : (document.getElementById('pendingChaptersCount').textContent || '–');
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (!AuthHelper.isAuthenticated()) {
                Utils.showAlert('Vui lòng đăng nhập để truy cập trang kiểm duyệt.', 'warning');
                setTimeout(function () { window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname); }, 1500);
                return;
            }
            if (!AuthHelper.hasAnyRole('MODERATOR', 'ADMIN')) {
                Utils.showAlert('Bạn không có quyền truy cập trang kiểm duyệt. Chỉ MODERATOR hoặc ADMIN.', 'danger');
                setTimeout(function () { window.location.href = '/'; }, 2000);
                return;
            }
            loadPendingStories(1);
            loadPendingChapters(1, true);
            document.getElementById('chapters-tab').addEventListener('shown.bs.tab', function () {
                if (pendingChapters.length === 0 && document.getElementById('pendingChaptersContainer').querySelector('.spinner-border')) {
                    loadPendingChapters(1);
                }
                updateStatCards();
            });
            document.getElementById('stories-tab').addEventListener('shown.bs.tab', updateStatCards);
            var storySearchDebounce = null;
            var chapterSearchDebounce = null;
            document.getElementById('storySearch').addEventListener('keypress', function (e) { if (e.key === 'Enter') applyStoryFilters(); });
            document.getElementById('storySearch').addEventListener('input', function () {
                clearTimeout(storySearchDebounce);
                storySearchDebounce = setTimeout(function () { applyStoryFilters(); }, 480);
            });
            document.getElementById('chapterSearch').addEventListener('keypress', function (e) { if (e.key === 'Enter') applyChapterFilters(); });
            document.getElementById('chapterSearch').addEventListener('input', function () {
                clearTimeout(chapterSearchDebounce);
                chapterSearchDebounce = setTimeout(function () { applyChapterFilters(); }, 480);
            });
            document.getElementById('chapterStoryIdFilter').addEventListener('keypress', function (e) { if (e.key === 'Enter') applyChapterFilters(); });
            document.getElementById('rejectQuickReason').addEventListener('change', function () {
                var q = this.value;
                if (q) document.getElementById('rejectReason').value = q;
            });
            startModeratorSignalR();
            var lastVisibleRefresh = 0;
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden && (Date.now() - lastVisibleRefresh) > 2000) {
                    lastVisibleRefresh = Date.now();
                    loadPendingStories(storiesCurrentPage, true);
                    loadPendingChapters(chaptersCurrentPage, true);
                    updateStatCards();
                }
            });
        });

        function getStoryFilterOptions(page) {
            var p = page ?? storiesCurrentPage;
            var pageSizeEl = document.getElementById('storyPageSize');
            storiesPageSize = parseInt(pageSizeEl ? pageSizeEl.value : 10, 10);
            var claimEl = document.getElementById('storyClaimFilter');
            var tsEl = document.getElementById('storyTimeStatus');
            return {
                page: p,
                pageSize: storiesPageSize,
                search: (document.getElementById('storySearch') || {}).value?.trim() || null,
                sortBy: (document.getElementById('storySortBy') || {}).value || 'updated_at',
                sortOrder: (document.getElementById('storySortOrder') || {}).value || 'asc',
                claimFilter: (claimEl && claimEl.value) ? claimEl.value : null,
                timeStatus: (tsEl && tsEl.value) ? tsEl.value : null
            };
        }

        function getChapterFilterOptions(page) {
            var p = page ?? chaptersCurrentPage;
            var pageSizeEl = document.getElementById('chapterPageSize');
            chaptersPageSize = parseInt(pageSizeEl ? pageSizeEl.value : 10, 10);
            var storyIdRaw = (document.getElementById('chapterStoryIdFilter') || {}).value?.trim();
            var claimEl = document.getElementById('chapterClaimFilter');
            var tsEl = document.getElementById('chapterTimeStatus');
            return {
                page: p,
                pageSize: chaptersPageSize,
                storyId: storyIdRaw || null,
                search: (document.getElementById('chapterSearch') || {}).value?.trim() || null,
                sortBy: (document.getElementById('chapterSortBy') || {}).value || 'updated_at',
                sortOrder: (document.getElementById('chapterSortOrder') || {}).value || 'asc',
                claimFilter: (claimEl && claimEl.value) ? claimEl.value : null,
                timeStatus: (tsEl && tsEl.value) ? tsEl.value : null
            };
        }

        function applyStoryFilters() { loadPendingStories(1); }
        function resetStoryFilters() {
            document.getElementById('storySearch').value = '';
            document.getElementById('storyClaimFilter').value = '';
            var st = document.getElementById('storyTimeStatus');
            if (st) st.value = '';
            document.getElementById('storySortBy').value = 'updated_at';
            document.getElementById('storySortOrder').value = 'asc';
            document.getElementById('storyPageSize').value = '10';
            loadPendingStories(1);
        }
        function applyChapterFilters() { loadPendingChapters(1); }
        function resetChapterFilters() {
            document.getElementById('chapterStoryIdFilter').value = '';
            document.getElementById('chapterSearch').value = '';
            document.getElementById('chapterClaimFilter').value = '';
            var ct = document.getElementById('chapterTimeStatus');
            if (ct) ct.value = '';
            document.getElementById('chapterSortBy').value = 'updated_at';
            document.getElementById('chapterSortOrder').value = 'asc';
            document.getElementById('chapterPageSize').value = '10';
            loadPendingChapters(1);
        }

        async function loadPendingStories(page, silent) {
            storiesCurrentPage = page;
            var container = document.getElementById('pendingStoriesContainer');
            if (!silent)
                container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted mb-0">Đang tải...</p></div>';
            var options = getStoryFilterOptions(page);
            try {
                var result = await ApiService.getPendingStories(options);
                pendingStories = result.items || [];
                storiesTotalCount = result.totalCount || 0;
                var totalPages = result.totalPages || 1;
                document.getElementById('pendingStoriesCount').textContent = storiesTotalCount;
                document.getElementById('statStoriesCount').textContent = storiesTotalCount;
                document.getElementById('storiesPage').textContent = page;
                document.getElementById('storiesTotalPages').textContent = totalPages;
                var from = storiesTotalCount === 0 ? 0 : (page - 1) * options.pageSize + 1;
                var to = Math.min(page * options.pageSize, storiesTotalCount);
                document.getElementById('storiesSummary').textContent = 'Hiển thị ' + from + '–' + to + ' trong tổng ' + storiesTotalCount + ' truyện';
                renderPendingStories();
                renderStoriesPagination(totalPages, page);
                updateLastRefreshTime();
            } catch (e) {
                if (!silent) {
                    container.innerHTML = '<div class="alert alert-danger mb-0">' + (e.message || 'Lỗi tải danh sách truyện chờ duyệt.') + '</div>';
                    document.getElementById('storiesSummary').textContent = 'Lỗi tải dữ liệu';
                }
            }
        }

        function renderPendingStories() {
            var container = document.getElementById('pendingStoriesContainer');
            if (!pendingStories.length) {
                container.innerHTML = '<div class="text-center py-5"><i class="bi bi-inbox text-muted" style="font-size:3rem;"></i><p class="text-muted mt-2 mb-0">Không có truyện nào chờ duyệt.</p></div>';
                return;
            }
            var html = pendingStories.map(function (s) {
                var escalationLocked = !!(s.isClaimedByMe && s.hasPendingEscalation);
                var cover = s.coverImage ? '<img src="' + resolveMediaSrc(s.coverImage) + '" class="cover-wrap img-fluid" alt="" style="width:120px;height:100px;object-fit:cover;">' : '<div class="cover-wrap d-flex align-items-center justify-content-center bg-secondary bg-opacity-25" style="width:120px;height:100px;"><i class="bi bi-image text-muted" style="font-size:2rem;"></i></div>';
                var summary = (s.summary || '').substring(0, 180);
                if ((s.summary || '').length > 180) summary += '...';
                var reviewBtns;
                if (escalationLocked) {
                    reviewBtns = '<span class="small text-muted align-self-center"><i class="bi bi-hourglass-split"></i> Chờ admin xử lý đơn báo cáo — không thể duyệt/từ chối.</span>';
                } else if (s.isClaimedByMe) {
                    reviewBtns = '<button type="button" class="btn btn-success btn-sm" onclick="approveStory(\'' + s.id + '\')"><i class="bi bi-check-circle"></i> Duyệt</button>' +
                      '<button type="button" class="btn btn-danger btn-sm" onclick="showRejectModal(\'STORY\',\'' + s.id + '\')"><i class="bi bi-x-circle"></i> Từ chối</button>';
                } else if (s.claimedByDisplayName) {
                    reviewBtns = '<span class="small text-muted">Người khác đang nhận duyệt — bạn không thể duyệt/từ chối.</span>';
                } else {
                    reviewBtns = '<span class="small text-muted">Nhận duyệt trước khi duyệt hoặc từ chối.</span>';
                }
                return '<div class="card story-card-mod mb-3">' +
                    '<div class="card-body p-3">' +
                    '<div class="d-flex gap-3 flex-wrap">' +
                    '<div class="flex-shrink-0">' + cover + '</div>' +
                    '<div class="flex-grow-1 min-w-0">' +
                    '<h6 class="card-title mb-1">' + (s.title || 'N/A') + '</h6>' +
                    '<p class="card-text small text-muted mb-2">' + summary + '</p>' +
                    authorSentLine(s.pendingSince || s.updatedAt) + (s.timeStatus ? ' ' + modTimeStatusBadge(s.timeStatus) : '') +
                    '<div class="d-flex flex-wrap align-items-center gap-2 mb-2">' +
                    (s.categoryNames ? '<span class="badge bg-secondary badge-status">' + s.categoryNames + '</span>' : '') +
                    '<span class="badge bg-warning text-dark badge-status">' + (s.status || 'PENDING_REVIEW') + '</span>' +
                    ((s.isClaimedByMe || s.claimedByDisplayName) ? '<span class="badge bg-info badge-status" title="' + (s.claimedAt ? ('Nhận (UTC): ' + Utils.formatDateUtc(s.claimedAt)) : '') + '">' + (s.isClaimedByMe ? '<i class="bi bi-person-check me-1"></i> Bạn đang duyệt' : '<i class="bi bi-person me-1"></i> ' + (s.claimedByDisplayName || '–')) + (s.claimedAt ? ' • ' + Utils.formatDateUtc(s.claimedAt) : '') + '</span>' : '') +
                    (escalationLocked ? '<span class="badge bg-secondary badge-status"><i class="bi bi-shield-lock me-1"></i> Chờ admin</span>' : '') +
                    (s.authorName ? '<span class="small text-muted">' + s.authorName + '</span>' : '') +
                    '<span class="small text-muted">Cập nhật: ' + Utils.formatDate(s.updatedAt) + '</span>' +
                    '</div>' +
                    '<div class="btn-action-group d-flex flex-wrap gap-1">' +
                    (!(s.isClaimedByMe || s.claimedByDisplayName) ? '<button type="button" class="btn btn-warning btn-sm" onclick="openClaimModal(\'STORY\',\'' + s.id + '\')" title="Nhận duyệt – chọn hạn &amp; cam kết"><i class="bi bi-lock-fill"></i> Nhận duyệt</button>' : '') +
                    (s.isClaimedByMe && !escalationLocked ? '<button type="button" class="btn btn-outline-danger btn-sm" onclick="openEscalationModal(\'STORY\',\'' + s.id + '\')" title="Gửi admin: gia hạn hoặc hủy nhận"><i class="bi bi-shield-exclamation"></i> Báo cáo admin</button>' : '') +
                    '<a href="/Moderator/ReviewStory/' + s.id + '" class="btn btn-primary btn-sm"><i class="bi bi-eye"></i> Xem & duyệt</a>' +
                    '<a href="/Stories/Details/' + s.id + '" class="btn btn-outline-secondary btn-sm" target="_blank">Chi tiết</a>' +
                    reviewBtns +
                    '</div>' +
                    '</div></div></div>';
            }).join('');
            container.innerHTML = html;
        }

        function renderStoriesPagination(totalPages, currentPage) {
            var nav = document.getElementById('storiesPagination');
            if (totalPages <= 1) { nav.innerHTML = ''; return; }
            var html = '<ul class="pagination pagination-sm mb-0">';
            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="loadPendingStories(' + (currentPage - 1) + '); return false;">Trước</a></li>';
            for (var i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '"><a class="page-link" href="#" onclick="loadPendingStories(' + i + '); return false;">' + i + '</a></li>';
            }
            html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="loadPendingStories(' + (currentPage + 1) + '); return false;">Sau</a></li>';
            html += '</ul>';
            nav.innerHTML = html;
        }

        async function approveStory(id) {
            try {
                await ApiService.moderatorApproveStory(id);
                Utils.showAlert('Đã duyệt truyện.', 'success');
                loadPendingStories(storiesCurrentPage);
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi duyệt truyện.', 'danger');
            }
        }

        async function loadPendingChapters(page, silent) {
            chaptersCurrentPage = page;
            var container = document.getElementById('pendingChaptersContainer');
            if (!silent)
                container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted mb-0">Đang tải...</p></div>';
            var options = getChapterFilterOptions(page);
            try {
                var result = await ApiService.getPendingChapters(options);
                pendingChapters = result.items || [];
                chaptersTotalCount = result.totalCount || 0;
                var totalPages = result.totalPages || 1;
                document.getElementById('pendingChaptersCount').textContent = chaptersTotalCount;
                document.getElementById('statChaptersCount').textContent = chaptersTotalCount;
                document.getElementById('chaptersPage').textContent = page;
                document.getElementById('chaptersTotalPages').textContent = totalPages;
                var from = chaptersTotalCount === 0 ? 0 : (page - 1) * options.pageSize + 1;
                var to = Math.min(page * options.pageSize, chaptersTotalCount);
                document.getElementById('chaptersSummary').textContent = 'Hiển thị ' + from + '–' + to + ' trong tổng ' + chaptersTotalCount + ' chapter';
                renderPendingChapters();
                renderChaptersPagination(totalPages, page);
                updateLastRefreshTime();
            } catch (e) {
                if (!silent) {
                    container.innerHTML = '<div class="alert alert-danger mb-0">' + (e.message || 'Lỗi tải danh sách chapter chờ duyệt.') + '</div>';
                    document.getElementById('chaptersSummary').textContent = 'Lỗi tải dữ liệu';
                }
            }
        }

        function renderPendingChapters() {
            var container = document.getElementById('pendingChaptersContainer');
            if (!pendingChapters.length) {
                container.innerHTML = '<div class="text-center py-5"><i class="bi bi-journal-x text-muted" style="font-size:3rem;"></i><p class="text-muted mt-2 mb-0">Không có chapter nào chờ duyệt.</p></div>';
                return;
            }
            var tableRows = pendingChapters.map(function (c) {
                var escalationLocked = !!(c.isClaimedByMe && c.hasPendingEscalation);
                var storyTitle = (c.storyTitle || '').trim() || ('ID: ' + (c.storyId || '').toString().substring(0, 8) + '…');
                var claimBadge = (c.claimedByDisplayName || c.isClaimedByMe) ? '<span class="badge bg-info badge-status" title="' + (c.claimedAt ? ('Nhận (UTC): ' + Utils.formatDateUtc(c.claimedAt)) : '') + '">' + (c.isClaimedByMe ? '<i class="bi bi-person-check me-1"></i> Bạn' : '<i class="bi bi-person me-1"></i> ' + (c.claimedByDisplayName || '–')) + (c.claimedAt ? ' • ' + Utils.formatDateUtc(c.claimedAt) : '') + '</span>' : '–';
                var reviewBtns;
                if (escalationLocked) {
                    reviewBtns = '<span class="small text-muted align-self-center"><i class="bi bi-hourglass-split"></i> Chờ admin xử lý đơn báo cáo — không thể duyệt/từ chối.</span>';
                } else if (c.isClaimedByMe) {
                    reviewBtns = '<button type="button" class="btn btn-success btn-sm" onclick="approveChapter(\'' + c.id + '\')"><i class="bi bi-check-circle"></i> Duyệt</button>' +
                      '<button type="button" class="btn btn-danger btn-sm" onclick="showRejectModal(\'CHAPTER\',\'' + c.id + '\')"><i class="bi bi-x-circle"></i> Từ chối</button>';
                } else if (c.claimedByDisplayName) {
                    reviewBtns = '<span class="small text-muted">Người khác đang nhận duyệt — bạn không thể duyệt/từ chối.</span>';
                } else {
                    reviewBtns = '<span class="small text-muted">Nhận duyệt trước khi duyệt hoặc từ chối.</span>';
                }
                return '<tr class="chapter-row-mod">' +
                    '<td class="align-middle"><span class="text-dark fw-medium">' + (c.title || 'N/A') + '</span></td>' +
                    '<td class="align-middle small"><a href="/Stories/Details/' + (c.storyId || '') + '" class="text-decoration-none" target="_blank">' + storyTitle + '</a></td>' +
                    '<td class="align-middle">' + (c.orderIndex != null ? c.orderIndex : '–') + '</td>' +
                    '<td class="align-middle">' + (c.wordCount != null ? c.wordCount.toLocaleString() : '–') + '</td>' +
                    '<td class="align-middle small text-muted">' + Utils.formatDate(c.createdAt) + '</td>' +
                    '<td class="align-middle"><span class="badge bg-warning text-dark badge-status">' + (c.status || 'PENDING_REVIEW') + '</span></td>' +
                    '<td class="align-middle small">' + claimBadge + (escalationLocked ? ' <span class="badge bg-secondary badge-status">Chờ admin</span>' : '') + '</td>' +
                    '<td class="align-middle small">' + (c.pendingSince || c.updatedAt || c.createdAt ? '<div><strong>' + Utils.formatDate(c.pendingSince || c.updatedAt || c.createdAt) + '</strong></div><div><em>' + (Utils.formatRelativePastVi ? Utils.formatRelativePastVi(c.pendingSince || c.updatedAt || c.createdAt) : '') + '</em> ' + modTimeStatusBadge(c.timeStatus) + '</div>' : '–') + '</td>' +
                    '<td class="align-middle">' +
                    '<div class="btn-action-group d-flex flex-wrap gap-1">' +
                    (!(c.isClaimedByMe || c.claimedByDisplayName) ? '<button type="button" class="btn btn-warning btn-sm" onclick="openClaimModal(\'CHAPTER\',\'' + c.id + '\')" title="Nhận duyệt – chọn hạn &amp; cam kết"><i class="bi bi-lock-fill"></i> Nhận duyệt</button>' : '') +
                    (c.isClaimedByMe && !escalationLocked ? '<button type="button" class="btn btn-outline-danger btn-sm" onclick="openEscalationModal(\'CHAPTER\',\'' + c.id + '\')" title="Gửi admin: gia hạn hoặc hủy nhận"><i class="bi bi-shield-exclamation"></i> Báo cáo admin</button>' : '') +
                    '<a href="/Moderator/ReviewChapter/' + c.id + '" class="btn btn-primary btn-sm"><i class="bi bi-eye"></i> Xem & duyệt</a>' +
                    '<a href="/Chapters/Index?storyId=' + (c.storyId || '') + '" class="btn btn-outline-secondary btn-sm" target="_blank">Chi tiết</a>' +
                    reviewBtns +
                    '</div></td></tr>';
            }).join('');
            container.innerHTML = '<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Chapter</th><th>Truyện</th><th>Thứ tự</th><th>Số từ</th><th>Ngày tạo</th><th>Trạng thái</th><th>Người duyệt</th><th>Gửi duyệt &amp; chờ</th><th>Thao tác</th></tr></thead><tbody>' + tableRows + '</tbody></table></div>';
        }

        function renderChaptersPagination(totalPages, currentPage) {
            var nav = document.getElementById('chaptersPagination');
            if (totalPages <= 1) { nav.innerHTML = ''; return; }
            var html = '<ul class="pagination pagination-sm mb-0">';
            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="loadPendingChapters(' + (currentPage - 1) + '); return false;">Trước</a></li>';
            for (var i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '"><a class="page-link" href="#" onclick="loadPendingChapters(' + i + '); return false;">' + i + '</a></li>';
            }
            html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="loadPendingChapters(' + (currentPage + 1) + '); return false;">Sau</a></li>';
            html += '</ul>';
            nav.innerHTML = html;
        }

        async function approveChapter(id) {
            try {
                await ApiService.moderatorApproveChapter(id);
                var idx = pendingChapters.findIndex(function (c) { return c.id === id; });
                if (idx >= 0) {
                    pendingChapters.splice(idx, 1);
                    chaptersTotalCount = Math.max(0, (chaptersTotalCount || 1) - 1);
                    var totalPages = Math.max(1, Math.ceil(chaptersTotalCount / chaptersPageSize));
                    document.getElementById('pendingChaptersCount').textContent = chaptersTotalCount;
                    document.getElementById('statChaptersCount').textContent = chaptersTotalCount;
                    document.getElementById('chaptersTotalPages').textContent = totalPages;
                    renderPendingChapters();
                    renderChaptersPagination(totalPages, chaptersCurrentPage);
                    document.getElementById('chaptersSummary').textContent = 'Hiển thị ' + (chaptersTotalCount === 0 ? 0 : (chaptersCurrentPage - 1) * chaptersPageSize + 1) + '–' + Math.min(chaptersCurrentPage * chaptersPageSize, chaptersTotalCount) + ' trong tổng ' + chaptersTotalCount + ' chapter';
                }
                Utils.showAlert('Đã duyệt chapter.', 'success');
                loadPendingChapters(chaptersCurrentPage, true);
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi duyệt chapter.', 'danger');
            }
        }

        function showRejectModal(targetType, targetId) {
            document.getElementById('rejectTargetType').value = targetType;
            document.getElementById('rejectTargetId').value = targetId;
            document.getElementById('rejectReason').value = '';
            document.getElementById('rejectQuickReason').value = '';
            document.getElementById('rejectModalTitle').innerHTML = '<i class="bi bi-x-circle text-danger me-2"></i>' + (targetType === 'STORY' ? 'Từ chối truyện' : 'Từ chối chapter') + ' – Nhập lý do';
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        async function confirmReject() {
            var reason = document.getElementById('rejectReason').value.trim();
            var quick = document.getElementById('rejectQuickReason').value;
            if (quick) reason = reason || quick;
            if (!reason) {
                Utils.showAlert('Vui lòng nhập lý do từ chối.', 'warning');
                return;
            }
            var targetType = document.getElementById('rejectTargetType').value;
            var targetId = document.getElementById('rejectTargetId').value;
            try {
                if (targetType === 'STORY') {
                    await ApiService.moderatorRejectStory(targetId, reason);
                    Utils.showAlert('Đã từ chối truyện.', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
                    loadPendingStories(storiesCurrentPage);
                } else {
                    await ApiService.moderatorRejectChapter(targetId, reason);
                    bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
                    var idx = pendingChapters.findIndex(function (c) { return c.id === targetId; });
                    if (idx >= 0) {
                        pendingChapters.splice(idx, 1);
                        chaptersTotalCount = Math.max(0, (chaptersTotalCount || 1) - 1);
                        var totalPages = Math.max(1, Math.ceil(chaptersTotalCount / chaptersPageSize));
                        document.getElementById('pendingChaptersCount').textContent = chaptersTotalCount;
                        document.getElementById('statChaptersCount').textContent = chaptersTotalCount;
                        document.getElementById('chaptersTotalPages').textContent = totalPages;
                        renderPendingChapters();
                        renderChaptersPagination(totalPages, chaptersCurrentPage);
                        document.getElementById('chaptersSummary').textContent = 'Hiển thị ' + (chaptersTotalCount === 0 ? 0 : (chaptersCurrentPage - 1) * chaptersPageSize + 1) + '–' + Math.min(chaptersCurrentPage * chaptersPageSize, chaptersTotalCount) + ' trong tổng ' + chaptersTotalCount + ' chapter';
                    }
                    Utils.showAlert('Đã từ chối chapter.', 'success');
                    loadPendingChapters(chaptersCurrentPage, true);
                }
            } catch (e) {
                Utils.showAlert(e.message || 'Lỗi từ chối.', 'danger');
            }
        }
    </script>
}
