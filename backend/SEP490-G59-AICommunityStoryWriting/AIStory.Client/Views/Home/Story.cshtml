@{
    ViewData["Title"] = "Đọc truyện";
    var storyId = ViewBag.StoryId ?? Guid.Empty;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a class="btn btn-outline-secondary btn-sm" href="/">
                <i class="bi bi-arrow-left"></i> Trang chủ
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm" id="storyTopBarReportBtn" onclick="openStoryPageReport()" title="Báo cáo vi phạm (cần đăng nhập)">
                <i class="bi bi-flag"></i> Báo cáo
            </button>
        </div>
        <div class="small text-muted">Reader view</div>
    </div>

    <div class="card mb-3" id="storyHeaderCard">
        <div class="card-body">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2" id="continueReadingBlock" style="display:none;">
        <span><i class="bi bi-bookmark-check text-primary"></i> <strong>Đang đọc dở:</strong> <span id="continueReadingChapterTitle"></span></span>
        <a class="btn btn-primary btn-sm" id="continueReadingLink" href="#"><i class="bi bi-book-half"></i> Đọc tiếp</a>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Danh sách chương</strong>
                    <span class="badge bg-info" id="publishedChapterCount">0</span>
                </div>
                <div class="card-body" id="chaptersList">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Bình luận</strong>
                    <span class="badge bg-secondary" id="commentsCountBadge">0</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning small mb-3" id="commentRuleHint">
                        Để comment: bạn cần <strong>đăng nhập</strong> và <strong>đọc ít nhất 1 chapter</strong> của truyện này.
                    </div>

                    <div class="mb-3">
                        <textarea class="form-control" id="newCommentContent" rows="2" placeholder="Viết bình luận..."></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">Tối đa 2000 ký tự</small>
                            <button class="btn btn-primary btn-sm" id="submitCommentBtn" onclick="submitStoryComment()">
                                <i class="bi bi-send"></i> Gửi bình luận
                            </button>
                        </div>
                        <div class="mt-2 small" id="commentSubmitResult"></div>
                    </div>

                    <div id="commentsList">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal: Danh sách người đã reaction comment -->
            <div class="modal fade" id="commentReactionsModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-emoji-smile me-1"></i> Người đã thả cảm xúc</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body" id="commentReactionsModalBody">
                            <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><strong>Thống kê</strong></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <div class="small text-muted">Lượt xem</div>
                                <div class="fw-bold" id="statViews">0</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <div class="small text-muted">Bình luận</div>
                                <div class="fw-bold" id="statComments">0</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <div class="small text-muted">Số chương</div>
                                <div class="fw-bold" id="statChapters">0</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <div class="small text-muted">Cập nhật</div>
                                <div class="small fw-bold" id="statLatestUpdated">-</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-2 border rounded bg-light">
                                <div class="small text-muted">Đánh giá TB</div>
                                <div class="fw-bold" id="statAvgRating">0.00/5</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><strong>Đánh giá (1–5 sao)</strong></div>
                <div class="card-body">
                    <div class="alert alert-warning small" id="ratingLoginHint" style="display:none;">
                        Bạn cần đăng nhập để đánh giá.
                    </div>
                    <div class="mb-2">
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="readerStarValue" id="readerStar1" value="1">
                            <label class="btn btn-outline-warning" for="readerStar1">1</label>
                            <input type="radio" class="btn-check" name="readerStarValue" id="readerStar2" value="2">
                            <label class="btn btn-outline-warning" for="readerStar2">2</label>
                            <input type="radio" class="btn-check" name="readerStarValue" id="readerStar3" value="3">
                            <label class="btn btn-outline-warning" for="readerStar3">3</label>
                            <input type="radio" class="btn-check" name="readerStarValue" id="readerStar4" value="4">
                            <label class="btn btn-outline-warning" for="readerStar4">4</label>
                            <input type="radio" class="btn-check" name="readerStarValue" id="readerStar5" value="5" checked>
                            <label class="btn btn-outline-warning" for="readerStar5">5</label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control form-control-sm" id="readerReviewText" rows="2" placeholder="Review (tùy chọn)"></textarea>
                    </div>
                    <button class="btn btn-primary btn-sm w-100" id="readerSubmitRatingBtn" onclick="submitReaderRating()">
                        <i class="bi bi-star-fill"></i> Gửi đánh giá
                    </button>
                    <div class="mt-2 small" id="readerRatingResult"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="storyPageReportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-flag"></i> Báo cáo truyện</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2" id="storyPageReportTitle"></p>
                    <label class="form-label small">Lý do</label>
                    <select class="form-select form-select-sm mb-2" id="storyPageReportReason"></select>
                    <label class="form-label small">Mô tả thêm (tùy chọn)</label>
                    <textarea class="form-control form-control-sm" id="storyPageReportDesc" rows="3" maxlength="4000"></textarea>
                    <div class="small text-danger mt-2" id="storyPageReportErr" style="display:none;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-danger btn-sm" id="storyPageReportSubmitBtn"><i class="bi bi-send"></i> Gửi báo cáo</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="storyCommentReportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-flag"></i> Báo cáo bình luận</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2" id="storyCommentReportTitle"></p>
                    <label class="form-label small">Lý do</label>
                    <select class="form-select form-select-sm mb-2" id="storyCommentReportReason"></select>
                    <label class="form-label small">Mô tả thêm (tùy chọn)</label>
                    <textarea class="form-control form-control-sm" id="storyCommentReportDesc" rows="3" maxlength="4000"></textarea>
                    <div class="small text-danger mt-2" id="storyCommentReportErr" style="display:none;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-danger btn-sm" id="storyCommentReportSubmitBtn">
                        <i class="bi bi-send"></i> Gửi báo cáo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const storyId = '@(storyId)';
        let story = null;
        let chapters = [];
        let replyingToCommentId = null;
        let replyingToDisplayName = null;
        let userIsFollowingAuthor = false;
        let authorFollowerCount = 0;
        let storyCommentReportCommentId = null;
        let storyCommentReportReportedUserName = null;

        async function ensureStoryPageReportReasons() {
            const sel = document.getElementById('storyPageReportReason');
            if (!sel || sel.options.length > 0) return;
            try {
                const list = await ApiService.getStoryReportReasons();
                (list || []).forEach(function (r) {
                    const o = document.createElement('option');
                    o.value = r.code || r.Code;
                    o.textContent = (r.labelVi || r.LabelVi || r.label || r.Label || o.value);
                    sel.appendChild(o);
                });
            } catch (e) { console.error(e); }
        }

        async function ensureStoryCommentReportReasons() {
            const sel = document.getElementById('storyCommentReportReason');
            if (!sel || sel.options.length > 0) return;
            try {
                const list = await ApiService.getCommentReportReasons();
                (list || []).forEach(function (r) {
                    const o = document.createElement('option');
                    o.value = r.code || r.Code;
                    o.textContent = (r.labelVi || r.LabelVi || r.label || r.Label || o.value);
                    sel.appendChild(o);
                });
            } catch (e) { console.error(e); }
        }

        window.openStoryCommentReport = function (commentId, reportedUserName) {
            if (!AuthHelper.isAuthenticated()) {
                alert('Vui lòng đăng nhập để báo cáo bình luận.');
                window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }
            storyCommentReportCommentId = commentId;
            storyCommentReportReportedUserName = reportedUserName || '';
            const titleEl = document.getElementById('storyCommentReportTitle');
            const errEl = document.getElementById('storyCommentReportErr');
            const descEl = document.getElementById('storyCommentReportDesc');
            const reasonSel = document.getElementById('storyCommentReportReason');
            if (titleEl) titleEl.textContent = reportedUserName ? `Bình luận của ${reportedUserName}` : 'Bình luận';
            if (errEl) {
                errEl.textContent = '';
                errEl.style.display = 'none';
            }
            if (descEl) descEl.value = '';
            if (!reasonSel || !reasonSel.options || reasonSel.options.length === 0) {
                ensureStoryCommentReportReasons().then(function () {
                    new bootstrap.Modal(document.getElementById('storyCommentReportModal')).show();
                });
                return;
            }
            new bootstrap.Modal(document.getElementById('storyCommentReportModal')).show();
        };

        window.openStoryPageReport = function () {
            if (!AuthHelper.isAuthenticated()) {
                alert('Vui lòng đăng nhập để báo cáo truyện.');
                window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }
            if (!story) {
                alert('Vui lòng đợi truyện tải xong rồi thử lại.');
                return;
            }
            document.getElementById('storyPageReportTitle').textContent = story.title || storyId;
            document.getElementById('storyPageReportDesc').value = '';
            document.getElementById('storyPageReportErr').style.display = 'none';
            ensureStoryPageReportReasons().then(function () {
                new bootstrap.Modal(document.getElementById('storyPageReportModal')).show();
            });
        };

        document.addEventListener('DOMContentLoaded', async function () {
            await AuthHelper.loadUserInfo().catch(() => {});
            if (!AuthHelper.isAuthenticated()) {
                document.getElementById('ratingLoginHint').style.display = 'block';
                document.getElementById('readerSubmitRatingBtn').disabled = true;
                document.getElementById('submitCommentBtn').disabled = true;
            }
            const spr = document.getElementById('storyPageReportSubmitBtn');
            if (spr) {
                spr.addEventListener('click', async function () {
                    const err = document.getElementById('storyPageReportErr');
                    err.style.display = 'none';
                    const reason = document.getElementById('storyPageReportReason').value;
                    if (!reason) {
                        err.textContent = 'Chọn lý do.';
                        err.style.display = 'block';
                        return;
                    }
                    try {
                        spr.disabled = true;
                        await ApiService.reportStory(storyId, {
                            reasonCode: reason,
                            description: document.getElementById('storyPageReportDesc').value || null
                        });
                        bootstrap.Modal.getInstance(document.getElementById('storyPageReportModal')).hide();
                        Utils.showAlert('Đã gửi báo cáo. Cảm ơn bạn.', 'success');
                    } catch (e) {
                        err.textContent = e.message || String(e);
                        err.style.display = 'block';
                    } finally {
                        spr.disabled = false;
                    }
                });
            }

            const crSpr = document.getElementById('storyCommentReportSubmitBtn');
            if (crSpr) {
                crSpr.addEventListener('click', async function () {
                    const err = document.getElementById('storyCommentReportErr');
                    if (err) {
                        err.textContent = '';
                        err.style.display = 'none';
                    }
                    const commentId = storyCommentReportCommentId;
                    if (!commentId) {
                        if (err) {
                            err.textContent = 'Không xác định bình luận.';
                            err.style.display = 'block';
                        }
                        return;
                    }
                    const reason = document.getElementById('storyCommentReportReason')?.value;
                    if (!reason) {
                        if (err) {
                            err.textContent = 'Chọn lý do.';
                            err.style.display = 'block';
                        }
                        return;
                    }
                    const desc = document.getElementById('storyCommentReportDesc')?.value || null;
                    try {
                        crSpr.disabled = true;
                        await ApiService.reportStoryComment(storyId, commentId, {
                            reasonCode: reason,
                            description: desc
                        });
                        bootstrap.Modal.getInstance(document.getElementById('storyCommentReportModal')).hide();
                        Utils.showAlert('Đã gửi báo cáo bình luận. Cảm ơn bạn.', 'success');
                    } catch (e) {
                        if (err) {
                            err.textContent = e?.message || String(e);
                            err.style.display = 'block';
                        }
                    } finally {
                        crSpr.disabled = false;
                    }
                });
            }
            await loadStory();
            await loadChapters();
            await loadComments();
            if (typeof window.loadUnreadNotificationCount === 'function') window.loadUnreadNotificationCount();
        });

        async function loadStory() {
            story = await ApiService.getStoryById(storyId);
            authorFollowerCount = 0;
            if (story && story.authorId && typeof AuthHelper !== 'undefined' && AuthHelper.isAuthenticated && AuthHelper.isAuthenticated()) {
                try {
                    userIsFollowingAuthor = await ApiService.getAuthorFollowing(story.authorId);
                } catch (_) {
                    userIsFollowingAuthor = false;
                }
            } else {
                userIsFollowingAuthor = false;
            }
            if (story && story.authorId) {
                try {
                    authorFollowerCount = await ApiService.getAuthorFollowerCount(story.authorId);
                } catch (_) {
                    authorFollowerCount = 0;
                }
            }
            renderHeader();
            renderStats();
            renderContinueReading();
        }

        function renderContinueReading() {
            const block = document.getElementById('continueReadingBlock');
            const link = document.getElementById('continueReadingLink');
            const titleSpan = document.getElementById('continueReadingChapterTitle');
            if (!block || !story) return;
            const chapterId = story.lastReadChapterId || story.LastReadChapterId;
            const chapterTitle = (story.lastReadChapterTitle || story.LastReadChapterTitle || '').trim() || 'Chương đang đọc';
            if (chapterId) {
                block.style.display = 'flex';
                if (link) {
                    link.href = '/Chapters/Read/' + encodeURIComponent(chapterId);
                    link.textContent = '';
                    link.innerHTML = '<i class="bi bi-book-half"></i> Đọc tiếp';
                }
                if (titleSpan) titleSpan.textContent = chapterTitle;
            } else {
                block.style.display = 'none';
            }
        }

        async function loadChapters() {
            const list = await ApiService.getChaptersByStoryId(storyId);
            chapters = (list || []).slice().sort((a, b) => (a.orderIndex || 0) - (b.orderIndex || 0));
            const published = chapters.filter(c => (c.status || '').toUpperCase() === 'PUBLISHED');
            document.getElementById('publishedChapterCount').textContent = published.length;
            renderChapterList(published);
        }

        async function loadComments() {
            try {
                const list = await ApiService.getStoryComments(storyId);
                renderComments(list || []);
            } catch (e) {
                document.getElementById('commentsList').innerHTML =
                    `<div class="alert alert-danger mb-0">Không tải được bình luận: ${(e?.message || e)}</div>`;
            }
        }

        function renderHeader() {
            const isFollowingStory = story.userIsFollowing === true;
            const canFollow = typeof AuthHelper !== 'undefined' && AuthHelper.isAuthenticated && AuthHelper.isAuthenticated();

            // Nút 1: Theo dõi truyện (thông báo khi có chương mới của truyện này)
            const followStoryBtn = canFollow
                ? (isFollowingStory
                    ? `<button type="button" class="btn btn-outline-secondary btn-sm" id="btnFollowStory" onclick="toggleFollowStory()" title="Bỏ theo dõi truyện này"><i class="bi bi-bookmark-fill"></i> Đang theo dõi truyện</button>`
                    : `<button type="button" class="btn btn-primary btn-sm" id="btnFollowStory" onclick="toggleFollowStory()" title="Nhận thông báo khi truyện này có chương mới"><i class="bi bi-bookmark"></i> Theo dõi truyện</button>`)
                : `<span class="text-muted small" title="Đăng nhập để theo dõi truyện"><i class="bi bi-bookmark"></i> Theo dõi truyện</span>`;

            const authorId = story.authorId || null;
            const authorName = (story.authorName || '').trim() || 'Tác giả';
            const currentUserId = typeof AuthHelper !== 'undefined' && AuthHelper.getUserId ? AuthHelper.getUserId() : null;
            const isOwnAuthor = authorId && currentUserId && String(authorId).toLowerCase() === String(currentUserId).toLowerCase();
            const showAuthorFollow = authorId && canFollow && !isOwnAuthor;

            // Nút 2: Theo dõi tác giả (thông báo khi tác giả có truyện/chương mới)
            const followAuthorBtn = showAuthorFollow
                ? (userIsFollowingAuthor
                    ? `<button type="button" class="btn btn-outline-secondary btn-sm" id="btnFollowAuthor" onclick="toggleFollowAuthor()" title="Bỏ theo dõi tác giả"><i class="bi bi-person-check-fill"></i> Đang theo dõi tác giả</button>`
                    : `<button type="button" class="btn btn-outline-primary btn-sm" id="btnFollowAuthor" onclick="toggleFollowAuthor()" title="Nhận thông báo khi tác giả có truyện hoặc chương mới"><i class="bi bi-person-plus"></i> Theo dõi tác giả</button>`)
                : (authorId && !isOwnAuthor ? '' : '');

            const followHint = canFollow
                ? '<p class="small text-muted mb-0 mt-1"><i class="bi bi-info-circle"></i> Thông báo hiện ở <strong>chuông <i class="bi bi-bell"></i> trên thanh menu</strong>.</p>'
                : '';

            const authorLabel = authorId
                ? `<div class="text-muted small mt-1"><i class="bi bi-person"></i> Tác giả: ${escapeHtml(authorName)} <span class="text-muted">· ${Utils.formatNumber(authorFollowerCount)} người theo dõi</span></div>`
                : '';

            const el = document.getElementById('storyHeaderCard');
            el.innerHTML = `
                <div class="card-body">
                    <div class="d-flex gap-3 align-items-start">
                        <div style="width: 96px;">
                            ${story.coverImage
                                ? `<img src="http://localhost:5000${story.coverImage}" class="img-fluid rounded" alt="${story.title}">`
                                : `<div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height:96px;">
                                        <i class="bi bi-image text-white"></i>
                                   </div>`}
                        </div>
                        <div class="flex-grow-1">
                            <h3 class="mb-2">${story.title}</h3>
                            ${authorLabel}
                            <div class="text-muted mb-2">${story.summary || ''}</div>
                            <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                <span class="small text-secondary me-1">Theo dõi:</span>
                                ${followStoryBtn}
                                ${followAuthorBtn}
                            </div>
                            ${followHint}
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <span class="badge bg-primary">${story.categoryNames || 'N/A'}</span>
                                <span class="badge bg-secondary">${story.status || 'N/A'}</span>
                                <span class="badge bg-success">${(story.avgRating ?? story.AvgRating) ? (story.avgRating ?? story.AvgRating).toFixed(1) : '0.0'}/5</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        async function toggleFollowAuthor() {
            if (!story || !story.authorId || !AuthHelper || !AuthHelper.isAuthenticated || !AuthHelper.isAuthenticated()) return;
            const btn = document.getElementById('btnFollowAuthor');
            if (!btn) return;
            try {
                btn.disabled = true;
                if (userIsFollowingAuthor) {
                    await ApiService.unfollowAuthor(story.authorId);
                    userIsFollowingAuthor = false;
                    authorFollowerCount = Math.max(0, (authorFollowerCount || 0) - 1);
                } else {
                    await ApiService.followAuthor(story.authorId);
                    userIsFollowingAuthor = true;
                    authorFollowerCount = Math.max(0, (authorFollowerCount || 0) + 1);
                }
                renderHeader();
            } catch (e) {
                alert(e?.message || e);
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        async function toggleFollowStory() {
            if (!AuthHelper || !AuthHelper.isAuthenticated || !AuthHelper.isAuthenticated()) return;
            const btn = document.getElementById('btnFollowStory');
            if (!btn) return;
            const isFollowing = story.userIsFollowing === true;
            try {
                btn.disabled = true;
                if (isFollowing) {
                    await ApiService.unfollowStory(storyId);
                    story.userIsFollowing = false;
                } else {
                    await ApiService.followStory(storyId);
                    story.userIsFollowing = true;
                }
                renderHeader();
            } catch (e) {
                alert(e?.message || e);
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        function renderStats() {
            const v = story.totalViews ?? story.TotalViews ?? 0;
            const c = story.totalComments ?? story.TotalComments ?? 0;
            const ch = story.publishedChaptersCount ?? story.PublishedChaptersCount ?? 0;
            const lat = story.latestUpdatedAt ?? story.LatestUpdatedAt ?? story.updatedAt ?? story.UpdatedAt;
            const avg = story.avgRating ?? story.AvgRating ?? 0;
            document.getElementById('statViews').textContent = Utils.formatNumber(v);
            document.getElementById('statComments').textContent = Utils.formatNumber(c);
            document.getElementById('statChapters').textContent = Utils.formatNumber(ch);
            document.getElementById('statLatestUpdated').textContent = lat ? Utils.formatDate(lat) : 'N/A';
            document.getElementById('statAvgRating').textContent = (avg ? Number(avg).toFixed(2) : '0.00') + '/5';
        }

        function renderChapterList(publishedChapters) {
            const el = document.getElementById('chaptersList');
            const lastReadId = story ? (story.lastReadChapterId || story.LastReadChapterId) : null;
            if (!publishedChapters || publishedChapters.length === 0) {
                el.innerHTML = `<div class="alert alert-info mb-0">Chưa có chapter PUBLISHED.</div>`;
                return;
            }
            el.innerHTML = publishedChapters.map(ch => {
                const isLastRead = lastReadId && ch.id === lastReadId;
                const badge = isLastRead ? ' <span class="badge bg-info ms-1">Đang đọc</span>' : '';
                return `
                <div class="d-flex justify-content-between align-items-center border-bottom py-2 ${isLastRead ? 'bg-light' : ''}">
                    <div>
                        <div class="fw-medium">Chương ${ch.orderIndex}: ${ch.title}${badge}</div>
                        <div class="text-muted small">
                            ${ch.publishedAt ? Utils.formatDate(ch.publishedAt) : ''}
                            ${ch.wordCount ? ' · ' + Utils.formatNumber(ch.wordCount) + ' từ' : ''}
                        </div>
                    </div>
                    <div>
                        <a class="btn btn-outline-primary btn-sm" href="/Chapters/Read/${encodeURIComponent(ch.id)}">
                            <i class="bi bi-book"></i> Đọc
                        </a>
                    </div>
                </div>
            `;
            }).join('');
        }

        function escapeHtml(text) {
            if (text == null) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Format time ago like Facebook: 14 giây / 14 phút / 4 giờ / 3 ngày ...
        function formatTimeAgo(value) {
            if (!value) return '';
            const d = (value instanceof Date) ? value : new Date(value);
            if (isNaN(d.getTime())) return '';

            let diffSec = Math.floor((Date.now() - d.getTime()) / 1000);
            if (diffSec < 0) diffSec = 0;

            if (diffSec < 60) return `${Math.max(1, diffSec)} giây`;
            const diffMin = Math.floor(diffSec / 60);
            if (diffMin < 60) return `${diffMin} phút`;
            const diffHour = Math.floor(diffMin / 60);
            if (diffHour < 24) return `${diffHour} giờ`;
            const diffDay = Math.floor(diffHour / 24);
            if (diffDay < 7) return `${diffDay} ngày`;

            const diffMonth = Math.floor(diffDay / 30);
            if (diffMonth < 12) return `${diffMonth} tháng`;
            const diffYear = Math.floor(diffDay / 365);
            return `${diffYear} năm`;
        }

        const COMMENT_REACTIONS = [
            { type: 'LIKE', icon: 'bi-hand-thumbs-up', label: 'Thích' },
            { type: 'DISLIKE', icon: 'bi-hand-thumbs-down', label: 'Không thích' },
            { type: 'FUNNY', icon: 'bi-emoji-laughing', label: 'Buồn cười' },
            { type: 'SAD', icon: 'bi-emoji-frown', label: 'Buồn' },
            { type: 'ANGRY', icon: 'bi-emoji-angry', label: 'Phẫn nộ' },
            { type: 'LOVE', icon: 'bi-heart-fill', label: 'Yêu thích' },
            { type: 'WOW', icon: 'bi-emoji-surprise', label: 'Wow' }
        ];

        function renderComments(list) {
            const container = document.getElementById('commentsList');
            document.getElementById('commentsCountBadge').textContent = (list || []).length;
            if (!list || list.length === 0) {
                container.innerHTML = `<div class="text-muted">Chưa có bình luận.</div>`;
                return;
            }

            const currentUserId = typeof AuthHelper !== 'undefined' && AuthHelper.getUserId ? AuthHelper.getUserId() : null;

            const byParent = new Map();
            const roots = [];
            for (const c of list) {
                const pid = c.parentId || null;
                if (!pid) roots.push(c);
                if (!byParent.has(pid)) byParent.set(pid, []);
                byParent.get(pid).push(c);
            }

            function renderNode(c, depth) {
                const name = escapeHtml(c.userDisplayName || 'Ẩn danh');
                const role = (c.userRole || '').toString().trim().toUpperCase();
                const roleMeta = {
                    AUTHOR: { label: 'Tác giả', className: 'bg-warning text-dark', title: 'Tác giả' },
                    USER: { label: 'Độc giả', className: 'bg-primary text-white', title: 'Độc giả' },
                    ADMIN: { label: 'Quản trị viên', className: 'bg-danger text-white', title: 'Quản trị viên' },
                    MODERATOR: { label: 'Kiểm duyệt', className: 'bg-success text-white', title: 'Kiểm duyệt' }
                };
                // USER tag depends on account age.
                // Config/thresholds (days since created_at):
                // - < 30  : Thành viên mới
                // - < 180 : Độc giả
                // - >=180 : Độc giả kỳ cựu
                let meta = roleMeta[role];
                if (role === 'USER') {
                    const createdAt = c.userCreatedAt ? new Date(c.userCreatedAt) : null;
                    let days = null;
                    if (createdAt && !isNaN(createdAt.getTime())) {
                        days = (Date.now() - createdAt.getTime()) / (1000 * 60 * 60 * 24);
                    }
                    if (days !== null) {
                        if (days < 30) meta = { label: 'Thành viên mới', className: 'bg-info text-dark', title: 'Thành viên mới' };
                        else if (days < 180) meta = { label: 'Độc giả', className: 'bg-primary text-white', title: 'Độc giả' };
                        else meta = { label: 'Độc giả kỳ cựu', className: 'bg-success text-white', title: 'Độc giả kỳ cựu' };
                    } else {
                        // Fallback if server didn't send created_at.
                        meta = { label: 'Độc giả', className: 'bg-primary text-white', title: 'Độc giả' };
                    }
                }
                const roleBadge = meta
                    ? `<span class="badge ${meta.className} ms-2" title="${escapeHtml(meta.title || meta.label)}">${escapeHtml(meta.label)}</span>`
                    : (role
                        ? `<span class="badge bg-light text-dark border ms-2" title="${escapeHtml('Role ' + role)}">${escapeHtml(role)}</span>`
                        : '');
                const time = formatTimeAgo(c.createdAt);
                const content = escapeHtml(c.content || '');
                const canReply = AuthHelper && AuthHelper.isAuthenticated && AuthHelper.isAuthenticated();
                const canReact = AuthHelper && AuthHelper.isAuthenticated && AuthHelper.isAuthenticated();
                const reactionCounts = c.reactionCounts || {};
                const userReactionType = c.userReactionType || null;

                const isReplyingHere = replyingToCommentId && replyingToCommentId === c.id;
                const replyBadge = isReplyingHere
                    ? `<span class="badge bg-info text-dark ms-2">Đang trả lời</span>`
                    : '';

                const replyBtn = canReply
                    ? `<button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="startReply('${c.id}', '${name.replace(/'/g, '\\&#039;')}')">Trả lời</button>`
                    : '';

                const reportBtn = (canReply && currentUserId && c.userId && String(c.userId).toLowerCase() !== String(currentUserId).toLowerCase())
                    ? `<button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-danger" onclick="openStoryCommentReport('${c.id}', '${String(c.userDisplayName || '').replace(/'/g, "\\'")}')"><i class="bi bi-flag"></i> Báo cáo</button>`
                    : '';

                const reactionBtns = COMMENT_REACTIONS.map(r => {
                    const count = reactionCounts[r.type] ?? 0;
                    const isActive = userReactionType === r.type;
                    const cur = (userReactionType || '').replace(/'/g, "\\'");
                    if (canReact) {
                        return `<button type="button" class="btn btn-link btn-sm p-0 px-1 text-decoration-none comment-reaction-btn ${isActive ? 'text-primary fw-bold' : 'text-muted'}" data-type="${r.type}" data-comment-id="${c.id}" title="${r.label}" onclick="setCommentReaction('${c.id}', '${r.type}', '${cur}')"><i class="bi ${r.icon}"></i> <span class="reaction-count" data-type="${r.type}">${count}</span></button>`;
                    }
                    return `<span class="text-muted small px-1" title="${r.label}"><i class="bi ${r.icon}"></i> ${count}</span>`;
                }).join('');

                const totalReactions = Object.values(reactionCounts).reduce((a, b) => a + b, 0);
                const totalReactionsHtml = totalReactions > 0
                    ? ` <span class="text-muted small text-decoration-underline" style="cursor:pointer" onclick="openCommentReactionsModal('${c.id}')" title="Xem tất cả người đã thả cảm xúc" role="button">(${totalReactions} reaction)</span>`
                    : '';

                const children = byParent.get(c.id) || [];
                const indent = Math.min(depth, 6) * 16;

                return `
                    <div class="py-2 comment-node" style="margin-left:${indent}px;" data-comment-id="${c.id}">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="fw-medium">${name}${roleBadge}${replyBadge}</div>
                            <div class="text-muted small">${time}</div>
                        </div>
                        <div class="mb-1">${content}</div>
                        <div class="small d-flex gap-2 align-items-center flex-wrap">
                            ${replyBtn}
                            ${reportBtn}
                            <span class="d-flex gap-1 align-items-center flex-wrap reaction-bar">${reactionBtns}</span>${totalReactionsHtml}
                        </div>
                        ${children.length ? children.map(ch => renderNode(ch, depth + 1)).join('') : ''}
                    </div>
                    ${depth === 0 ? '<div class="border-bottom"></div>' : ''}
                `;
            }

            container.innerHTML = roots.map(c => renderNode(c, 0)).join('');
            renderReplyStateUI();
        }

        function renderReplyStateUI() {
            const hint = document.getElementById('commentRuleHint');
            const textarea = document.getElementById('newCommentContent');
            const btn = document.getElementById('submitCommentBtn');
            let stateEl = document.getElementById('replyStateBar');
            if (!stateEl) {
                stateEl = document.createElement('div');
                stateEl.id = 'replyStateBar';
                stateEl.className = 'alert alert-info small py-2 d-flex justify-content-between align-items-center';
                stateEl.style.display = 'none';
                stateEl.innerHTML = `<div id="replyStateText"></div>
                                     <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelReply()">Hủy trả lời</button>`;
                hint.parentElement.insertBefore(stateEl, hint.nextSibling);
            }

            if (replyingToCommentId) {
                stateEl.style.display = 'flex';
                document.getElementById('replyStateText').innerHTML =
                    `Đang trả lời <strong>${escapeHtml(replyingToDisplayName || 'comment')}</strong>`;
                textarea.placeholder = `Trả lời ${replyingToDisplayName || 'comment'}...`;
                btn.innerHTML = `<i class="bi bi-send"></i> Gửi trả lời`;
            } else {
                stateEl.style.display = 'none';
                textarea.placeholder = 'Viết bình luận...';
                btn.innerHTML = `<i class="bi bi-send"></i> Gửi bình luận`;
            }
        }

        function startReply(commentId, displayName) {
            replyingToCommentId = commentId;
            replyingToDisplayName = displayName;
            renderReplyStateUI();
            document.getElementById('newCommentContent').focus();
        }

        function cancelReply() {
            replyingToCommentId = null;
            replyingToDisplayName = null;
            renderReplyStateUI();
        }

        async function toggleCommentLike(commentId) {
            if (!AuthHelper || !AuthHelper.isAuthenticated || !AuthHelper.isAuthenticated()) return;
            try {
                const res = await ApiService.toggleCommentLike(storyId, commentId);
                if (res && typeof res.likesCount !== 'undefined') {
                    const node = document.querySelector(`.comment-node[data-comment-id="${commentId}"]`);
                    if (node) {
                        const btn = node.querySelector('.like-comment-btn');
                        if (btn) {
                            const icon = btn.querySelector('i.bi');
                            const countSpan = btn.querySelector('.like-count');
                            if (icon) icon.className = res.liked ? 'bi bi-heart-fill text-danger' : 'bi bi-heart';
                            if (countSpan) countSpan.textContent = res.likesCount;
                        }
                    }
                } else {
                    await loadComments();
                }
            } catch (e) {
                console.error(e);
                await loadComments();
            }
        }

        async function setCommentReaction(commentId, reactionType, currentUserReaction) {
            if (!AuthHelper || !AuthHelper.isAuthenticated || !AuthHelper.isAuthenticated()) return;
            const toSet = (currentUserReaction === reactionType) ? null : reactionType;
            try {
                await ApiService.setCommentReaction(storyId, commentId, toSet);
                await loadComments();
            } catch (e) {
                console.error(e);
                await loadComments();
            }
        }

        async function openCommentReactionsModal(commentId) {
            const modalEl = document.getElementById('commentReactionsModal');
            const bodyEl = document.getElementById('commentReactionsModalBody');
            if (!modalEl || !bodyEl) return;
            bodyEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';
            const modal = typeof bootstrap !== 'undefined' && bootstrap.Modal ? new bootstrap.Modal(modalEl) : null;
            if (modal) modal.show();
            try {
                const list = await ApiService.getCommentReactions(storyId, commentId) || [];
                const typeToIcon = Object.fromEntries(COMMENT_REACTIONS.map(r => [r.type, r.icon]));
                const typeToLabel = Object.fromEntries(COMMENT_REACTIONS.map(r => [r.type, r.label]));
                if (list.length === 0) {
                    bodyEl.innerHTML = '<p class="text-muted mb-0">Chưa có ai thả cảm xúc.</p>';
                } else {
                    bodyEl.innerHTML = '<ul class="list-group list-group-flush">' + list.map(item => {
                        const icon = typeToIcon[item.reactionType] || 'bi-emoji-smile';
                        const label = typeToLabel[item.reactionType] || item.reactionType;
                        const name = escapeHtml(item.userDisplayName || 'Ẩn danh');
                        return `<li class="list-group-item d-flex align-items-center gap-2 py-2">
                            <i class="bi ${icon} text-primary" title="${escapeHtml(label)}"></i>
                            <span>${name}</span>
                        </li>`;
                    }).join('') + '</ul>';
                }
            } catch (e) {
                const msg = e?.message || String(e);
                const isNotFound = /not found|404/i.test(msg);
                const hint = isNotFound
                    ? ' Kiểm tra: (1) Ứng dụng API (AIStory.API) đã chạy chưa (port 5000?), (2) Trong Client appsettings.json, GivenAPIBaseUrl trỏ đúng địa chỉ API.'
                    : '';
                bodyEl.innerHTML = '<p class="text-danger mb-0">Không tải được danh sách: ' + escapeHtml(msg) + escapeHtml(hint) + '</p>';
            }
        }

        async function submitStoryComment() {
            const resultEl = document.getElementById('commentSubmitResult');
            resultEl.innerHTML = '';
            if (!AuthHelper.isAuthenticated()) {
                resultEl.innerHTML = `<span class="text-danger">Vui lòng đăng nhập để bình luận.</span>`;
                return;
            }
            const content = (document.getElementById('newCommentContent').value || '').trim();
            if (!content) {
                resultEl.innerHTML = `<span class="text-danger">Nội dung bình luận không được để trống.</span>`;
                return;
            }
            try {
                await ApiService.addStoryComment(storyId, { content: content, parentId: replyingToCommentId });
                document.getElementById('newCommentContent').value = '';
                cancelReply();
                resultEl.innerHTML = `<span class="text-success">Đã gửi bình luận.</span>`;
                await loadComments();
                await loadStory(); // refresh comment count on stats
            } catch (e) {
                resultEl.innerHTML = `<span class="text-danger">${e?.message || e}</span>`;
            }
        }

        function getReaderStarValue() {
            const el = document.querySelector('input[name="readerStarValue"]:checked');
            return el ? parseInt(el.value, 10) : 5;
        }

        async function submitReaderRating() {
            const resultEl = document.getElementById('readerRatingResult');
            resultEl.innerHTML = '';
            try {
                const payload = { starValue: getReaderStarValue(), reviewText: document.getElementById('readerReviewText').value || null };
                const res = await ApiService.rateStory(storyId, payload);
                resultEl.innerHTML = `<span class="text-success">OK. Avg: ${Number(res.avgRating).toFixed(2)} (${res.ratingCount}).</span>`;
                await loadStory();
            } catch (e) {
                resultEl.innerHTML = `<span class="text-danger">${e?.message || e}</span>`;
            }
        }
    </script>
}

