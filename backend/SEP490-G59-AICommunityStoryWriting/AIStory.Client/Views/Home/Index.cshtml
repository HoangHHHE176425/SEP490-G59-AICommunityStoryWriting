@{
    ViewData["Title"] = "Trang chủ - Khám phá truyện";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="row g-3" id="homeStatsRow" aria-live="polite">
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary"><i class="bi bi-journal-bookmark fs-3"></i></div>
                            <div>
                                <div class="text-muted small text-uppercase">Truyện đã xuất bản</div>
                                <div class="fs-3 fw-semibold home-stat-value" id="homeStatStories"><span class="spinner-border spinner-border-sm text-primary" role="status"></span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success"><i class="bi bi-people fs-3"></i></div>
                            <div>
                                <div class="text-muted small text-uppercase">Tác giả</div>
                                <div class="fs-3 fw-semibold home-stat-value" id="homeStatAuthors"><span class="spinner-border spinner-border-sm text-success" role="status"></span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info"><i class="bi bi-eye fs-3"></i></div>
                            <div>
                                <div class="text-muted small text-uppercase">Tổng lượt đọc</div>
                                <div class="fs-3 fw-semibold home-stat-value" id="homeStatViews"><span class="spinner-border spinner-border-sm text-info" role="status"></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="alert alert-warning py-2 small mb-0 d-none" id="homeStatsError" role="alert"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
                <div>
                    <h2 class="mb-1"><i class="bi bi-compass"></i> Khám phá truyện</h2>
                    <div class="text-muted">Chỉ hiển thị truyện <strong>PUBLISHED</strong>. Click “Đọc” để xem truyện; báo cáo vi phạm có trên trang đọc.</div>
                </div>
                <div class="d-flex gap-2">
                    <input class="form-control" style="min-width:260px" id="searchInput" placeholder="Tìm theo tên / tóm tắt..." onkeyup="loadPublishedStories(1)">
                    <select class="form-select" id="sortBy" onchange="loadPublishedStories(1)">
                        <option value="updated_at" selected>Mới cập nhật</option>
                        <option value="total_views">Nhiều lượt xem</option>
                        <option value="avg_rating">Đánh giá cao</option>
                        <option value="created_at">Mới tạo</option>
                    </select>
                </div>
            </div>

            <div id="publishedStoriesContainer">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
            <nav id="paginationNav" class="mt-4"></nav>

            <hr class="my-5" />

            <div class="text-muted small mb-2">Khu vực dưới đây dành cho tác giả (AUTHOR) để quản lý nội dung.</div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-tags" style="font-size: 3rem; color: #0d6efd;"></i>
                            <h5 class="card-title mt-3">Quản lý Thể loại</h5>
                            <p class="card-text">Tạo và quản lý các thể loại truyện</p>
                            <a href="/Categories" class="btn btn-primary"><i class="bi bi-arrow-right"></i> Xem chi tiết</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-book" style="font-size: 3rem; color: #198754;"></i>
                            <h5 class="card-title mt-3">Quản lý Truyện</h5>
                            <p class="card-text">Tạo và quản lý các truyện với cover image</p>
                            <a href="/Stories" class="btn btn-success"><i class="bi bi-arrow-right"></i> Xem chi tiết</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-list-ol" style="font-size: 3rem; color: #ffc107;"></i>
                            <h5 class="card-title mt-3">Quản lý Chapters</h5>
                            <p class="card-text">Tạo và quản lý các chapters của truyện</p>
                            <a href="/Chapters" class="btn btn-warning"><i class="bi bi-arrow-right"></i> Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-cash-coin" style="font-size: 3rem; color: #dc3545;"></i>
                            <h5 class="card-title mt-3">Lịch sử thu nhập</h5>
                            <p class="card-text">Xem coin nhận từ mở khóa chapter</p>
                            <a href="/Home/AuthorUnlockChapterIncomeHistory" class="btn btn-danger">
                                <i class="bi bi-arrow-right"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;

        document.addEventListener('DOMContentLoaded', function () {
            loadCommunityHomeStats();
            loadPublishedStories(1).then(function () {
                if (typeof window.loadUnreadNotificationCount === 'function') window.loadUnreadNotificationCount();
            });
        });

        async function loadCommunityHomeStats() {
            const errEl = document.getElementById('homeStatsError');
            const setVals = (stories, authors, views) => {
                const fmt = (typeof Utils !== 'undefined' && Utils.formatNumber) ? Utils.formatNumber : (n) => String(n);
                document.getElementById('homeStatStories').textContent = fmt(stories);
                document.getElementById('homeStatAuthors').textContent = fmt(authors);
                document.getElementById('homeStatViews').textContent = fmt(views);
            };
            try {
                const s = await ApiService.getCommunityHomeStats();
                const stories = s?.publishedStoriesCount ?? s?.PublishedStoriesCount ?? 0;
                const authors = s?.authorsCount ?? s?.AuthorsCount ?? 0;
                const views = s?.totalViews ?? s?.TotalViews ?? 0;
                setVals(stories, authors, views);
                if (errEl) { errEl.classList.add('d-none'); errEl.textContent = ''; }
            } catch (e) {
                document.getElementById('homeStatStories').textContent = '—';
                document.getElementById('homeStatAuthors').textContent = '—';
                document.getElementById('homeStatViews').textContent = '—';
                if (errEl) {
                    errEl.textContent = 'Không tải được thống kê trang chủ: ' + (e?.message || e);
                    errEl.classList.remove('d-none');
                }
            }
        }

        async function loadPublishedStories(page) {
            try {
                currentPage = page || 1;
                const query = {
                    page: currentPage,
                    pageSize: 12,
                    status: 'PUBLISHED',
                    search: document.getElementById('searchInput').value || null,
                    sortBy: document.getElementById('sortBy').value,
                    sortOrder: 'desc'
                };
                const result = await ApiService.getStories(query);
                const items = result?.items || [];
                totalPages = result?.totalPages || Math.ceil((result?.totalCount || items.length) / (query.pageSize || 12)) || 1;
                renderPublishedStories(items);
                renderPagination();
            } catch (e) {
                document.getElementById('publishedStoriesContainer').innerHTML =
                    `<div class="alert alert-danger">Không tải được stories: ${(e?.message || e)}</div>`;
            }
        }

        function renderPublishedStories(items) {
            const container = document.getElementById('publishedStoriesContainer');
            if (!items || items.length === 0) {
                container.innerHTML = `<div class="alert alert-info">Chưa có truyện PUBLISHED.</div>`;
                return;
            }
            container.innerHTML = `
                <div class="row g-3">
                    ${items.map(s => {
                        const views = s.totalViews ?? s.TotalViews ?? 0;
                        const comments = s.totalComments ?? s.TotalComments ?? 0;
                        const chapters = s.publishedChaptersCount ?? s.PublishedChaptersCount ?? 0;
                        const latest = s.latestUpdatedAt ?? s.LatestUpdatedAt ?? s.updatedAt ?? s.UpdatedAt;
                        const avg = s.avgRating ?? s.AvgRating ?? 0;
                        return `
                        <div class="col-sm-6 col-lg-4 col-xl-3">
                            <div class="card h-100 shadow-sm">
                                ${s.coverImage ? `<img src="${resolveMediaSrc(s.coverImage)}" class="card-img-top" style="height:170px; object-fit:cover;">` : ''}
                                <div class="card-body">
                                    <div class="fw-bold mb-1">${s.title}</div>
                                    <div class="text-muted small mb-2">${(s.summary || '').substring(0, 90)}${(s.summary || '').length > 90 ? '...' : ''}</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <span class="badge bg-warning text-dark"><i class="bi bi-eye"></i> ${Utils.formatNumber(views)}</span>
                                        <span class="badge bg-secondary"><i class="bi bi-chat"></i> ${Utils.formatNumber(comments)}</span>
                                        <span class="badge bg-info"><i class="bi bi-list-ol"></i> ${Utils.formatNumber(chapters)}</span>
                                        <span class="badge bg-success"><i class="bi bi-star-fill"></i> ${avg ? Number(avg).toFixed(1) : '0.0'}</span>
                                    </div>
                                    <div class="text-muted small mb-2">Cập nhật: ${latest ? Utils.formatDate(latest) : 'N/A'}</div>
                                    <a class="btn btn-primary btn-sm w-100" href="/Home/Story/${encodeURIComponent(s.id)}">
                                        <i class="bi bi-book"></i> Đọc
                                    </a>
                                </div>
                            </div>
                        </div>`;
                    }).join('')}
                </div>
            `;
        }

        function renderPagination() {
            const nav = document.getElementById('paginationNav');
            if (!nav || totalPages <= 1) { nav.innerHTML = ''; return; }
            let html = '<ul class="pagination justify-content-center">';
            html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="loadPublishedStories(${currentPage - 1}); return false;">Trước</a>
                     </li>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="#" onclick="loadPublishedStories(${i}); return false;">${i}</a>
                             </li>`;
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
            }
            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" onclick="loadPublishedStories(${currentPage + 1}); return false;">Sau</a>
                     </li>`;
            html += '</ul>';
            nav.innerHTML = html;
        }
    </script>
}